---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const {
  title = 'Алексей Ларин — тренер по развитию здоровья',
  description = 'Личное ведение, бесплатный курс, статьи и результаты учеников.',
  active = '',
  pageStyles = '',
  padTop = false,
  ogImage = '/img/IMG_3979.jpg',
  user = (Astro.locals as any).user,
} = Astro.props as { title?: string; description?: string; active?: string; pageStyles?: string; padTop?: boolean; ogImage?: string; user?: any };
const siteUrl = 'https://leshalarin.ru';
const canonicalPath = Astro.url.pathname;
const canonicalUrl = siteUrl + canonicalPath;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : siteUrl + ogImage;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#1a2744" />

  {/* Open Graph (для Telegram / WhatsApp / Max / Facebook / VK) */}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content="Алексей Ларин" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  {/* Twitter / X */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteOgImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --navy: #1a2744;
      --navy-mid: #243058;
      --navy-light: #2e3d6b;
      --orange: #e8652a;
      --orange-warm: #f07530;
      --cream: #f8f5ef;
      --warm-white: #fdfaf5;
      --text: #1a1a1a;
      --text-mid: #444;
      --text-muted: #777;
      --text-light: #aaa;
      --border: #ece8e0;
      --border-light: #f2ede5;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    /* НЕ задавать height: 100% — иначе body становится scroll-container
       и ломает window.scrollTo/scrollIntoView. min-height ниже сохраняет sticky-footer. */
    html { max-width: 100vw; overflow-x: clip; }
    body { max-width: 100vw; overflow-x: clip; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Manrope', sans-serif; background: var(--warm-white); color: var(--text); display: flex; flex-direction: column; min-height: 100vh; position: relative; }
    a { color: inherit; }
    /* Главный контейнер тоже не вылезает за viewport */
    .site-main { width: 100%; max-width: 100vw; overflow-x: hidden; }
    /* Медиа не растягиваются */
    img, video, picture, svg, iframe { max-width: 100%; height: auto; }
    @media (max-width: 700px) {
      main, section, header, footer, nav, article, aside, div { max-width: 100%; }
      p, li, h1, h2, h3, h4, h5, h6, span, a, blockquote, td, th { overflow-wrap: break-word; word-wrap: break-word; }
      h1 { font-size: clamp(26px, 7.5vw, 36px); line-height: 1.15; }
      h2 { font-size: clamp(22px, 6vw, 30px); line-height: 1.2; }
    }

    /* Site nav */
    .site-nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: rgba(253,250,245,0.94); backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      height: 64px; padding: 0 48px;
      display: flex; align-items: center; gap: 24px;
    }
    .site-nav-logo { text-decoration: none; flex-shrink: 0; display: inline-flex; align-items: center; }
    .site-nav-links { display: flex; gap: 32px; margin-left: auto; margin-right: 40px; align-items: center; }
    .site-nav-links a { display: inline-flex; align-items: center; justify-content: center; text-align: center; min-height: 32px; line-height: 1.2; font-size: 13px; font-weight: 500; color: var(--text-muted); text-decoration: none; transition: color 0.2s; border-bottom: 2px solid transparent; }
    .site-nav-links a:hover { color: var(--navy); }
    .site-nav-links a.active { color: var(--navy); font-weight: 600; border-bottom-color: var(--orange); }
    .site-nav-right { display: flex; gap: 16px; align-items: center; }
    .site-nav-login { display: inline-flex; align-items: center; height: 32px; line-height: 1; font-size: 13px; color: var(--text-muted); text-decoration: none; }
    .site-nav-login:hover { color: var(--navy); }
    .site-nav-logout { display: inline-flex; align-items: center; height: 32px; line-height: 1; font-size: 13px; padding: 0 16px; border-radius: 100px; border: 1.5px solid var(--navy); background: transparent; color: var(--navy); cursor: pointer; font-family: inherit; font-weight: 600; transition: all 0.2s; }
    .site-nav-logout:hover { background: var(--navy); color: white; }

    /* Sticky footer: main grows to fill remaining space */
    .site-main { flex: 1 0 auto; }
    .site-main.with-pad { padding-top: 64px; }
    .site-footer { flex-shrink: 0; }

    /* Footer */
    .site-footer {
      background: #0f1520; padding: 36px 80px;
      display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;
    }
    .footer-logo { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: white; text-decoration: none; }
    .footer-social { display: flex; gap: 8px; align-items: center; }
    .social-btn { width: 36px; height: 36px; border-radius: 8px; background: rgba(255,255,255,0.07); color: rgba(255,255,255,0.82); display: flex; align-items: center; justify-content: center; text-decoration: none; transition: all 0.2s; }
    .social-btn:hover { background: rgba(255,255,255,0.15); color: white; }
    .footer-copy { font-size: 13px; color: rgba(255,255,255,0.6); }

    @media (max-width: 700px) {
      .site-nav { padding: 0 20px; }
      .site-nav-links { display: none; }
      .site-footer {
        flex-direction: column; align-items: center; gap: 18px;
        padding: 32px 24px; text-align: center;
      }
      .site-footer > * { width: 100%; max-width: 100%; }
      .footer-logo { text-align: center; display: block; }
      .footer-copy { text-align: center; }
      .footer-social { justify-content: center; flex-wrap: wrap; }
    }

    /* Generic helpers reused by Astro pages */
    .container { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--orange); color: white; text-decoration: none; border: none; cursor: pointer;
      padding: 16px 32px; border-radius: 100px; font-size: 16px; font-weight: 600; font-family: 'Manrope',sans-serif;
      transition: all 0.25s; box-shadow: 0 8px 32px rgba(232,101,42,0.35);
    }
    .btn-primary:hover { background: var(--orange-warm); transform: translateY(-2px); }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 10px;
      border: 1.5px solid var(--navy); color: var(--navy); background: transparent;
      padding: 14px 28px; border-radius: 100px; font-size: 15px; font-weight: 600;
      text-decoration: none; transition: all 0.2s;
    }
    .btn-secondary:hover { background: var(--navy); color: white; }
  </style>
  {pageStyles && <style is:global set:html={pageStyles} />}
</head>
<body>
  <SiteHeader active={active} user={user} />
  <main class={`site-main${padTop ? ' with-pad' : ''}`}>
    <slot />
  </main>
  <SiteFooter />
  <script>
    // Attach CSRF to fetch mutations. Если cookie csrf ещё нет (первый визит) —
    // синхронно ставим её через GET /api/me, иначе сервер вернёт csrf_failed.
    (() => {
      function getCsrf() {
        const m = document.cookie.match(/(?:^|;\s*)csrf=([^;]+)/);
        return m ? m[1] : '';
      }
      async function ensureCsrf() {
        if (getCsrf()) return getCsrf();
        try { await fetch('/api/me', { credentials: 'include' }); } catch {}
        return getCsrf();
      }
      const orig = window.fetch;
      let refreshing = null;
      async function tryRefresh() {
        if (refreshing) return refreshing;
        refreshing = (async () => {
          try {
            const csrf = (await ensureCsrf()) || '';
            const r = await orig.call(window, '/api/auth/refresh', {
              method: 'POST', credentials: 'include',
              headers: { 'X-CSRF-Token': csrf, 'Content-Type': 'application/json' },
            });
            return r.ok;
          } catch { return false; }
          finally { setTimeout(() => { refreshing = null; }, 100); }
        })();
        return refreshing;
      }
      window.fetch = async function(input, init = {}) {
        const method = (init.method || (typeof input === 'string' ? 'GET' : input.method) || 'GET').toUpperCase();
        if (method !== 'GET' && method !== 'HEAD') {
          const csrf = (await ensureCsrf()) || '';
          init.headers = { ...(init.headers || {}), 'X-CSRF-Token': csrf };
          init.credentials = 'include';
        } else {
          init.credentials = init.credentials || 'include';
        }
        const url = typeof input === 'string' ? input : input.url;
        let res = await orig.call(this, input, init);
        if (res.status === 401 && url && url.startsWith('/api/') &&
            !url.includes('/auth/login') && !url.includes('/auth/refresh') &&
            !url.includes('/auth/register') && !url.includes('/auth/quick-signup')) {
          if (await tryRefresh()) {
            res = await orig.call(this, input, init);
          }
        }
        return res;
      };
      ensureCsrf();
    })();
  </script>
</body>
</html>
