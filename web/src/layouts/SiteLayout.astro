---
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const {
  title = 'Алексей Ларин — тренер по здоровью',
  description = 'Личное ведение, бесплатный курс, статьи и результаты учеников.',
  active = '',
  pageStyles = '',
  padTop = false,
  ogImage = '/img/IMG_3979.jpg',
  canonical = '',
  user = (Astro.locals as any).user,
} = Astro.props as { title?: string; description?: string; active?: string; pageStyles?: string; padTop?: boolean; ogImage?: string; canonical?: string; user?: any };
const siteUrl = 'https://leshalarin.ru';
// canonical можно переопределить пропом — для страниц-дублей
// (например, /courses/myagkiy-start указывает на /course).
const canonicalPath = canonical || Astro.url.pathname;
const canonicalUrl = siteUrl + canonicalPath;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : siteUrl + ogImage;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#1a2744" />

  {/* Open Graph (для Telegram / WhatsApp / Max / Facebook / VK) */}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content="Алексей Ларин" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  {/* Twitter / X */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteOgImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    /* Токены, шапка, футер, контейнер, базовая типографика и responsive —
       в ../styles/site.css (общий с Base.astro). Здесь — специфика публичного сайта. */
    * { box-sizing: border-box; margin: 0; padding: 0; }
    a { color: inherit; }

    .site-main.with-pad { padding-top: 64px; }

    /* Generic helpers reused by Astro pages */
    .btn-primary {
      display: inline-flex; align-items: center; gap: 10px;
      background: var(--orange); color: white; text-decoration: none; border: none; cursor: pointer;
      padding: 16px 32px; border-radius: 100px; font-size: 16px; font-weight: 600; font-family: 'Manrope',sans-serif;
      transition: all 0.25s; box-shadow: 0 8px 32px rgba(232,101,42,0.35);
    }
    .btn-primary:hover { background: var(--orange-warm); transform: translateY(-2px); }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 10px;
      border: 1.5px solid var(--navy); color: var(--navy); background: transparent;
      padding: 14px 28px; border-radius: 100px; font-size: 15px; font-weight: 600;
      text-decoration: none; transition: all 0.2s;
    }
    .btn-secondary:hover { background: var(--navy); color: white; }
  </style>
  {pageStyles && <style is:global set:html={pageStyles} />}
</head>
<body>
  <SiteHeader active={active} user={user} />
  <main class={`site-main${padTop ? ' with-pad' : ''}`}>
    <slot />
  </main>
  <SiteFooter />
  <script>
    // Attach CSRF to fetch mutations. Если cookie csrf ещё нет (первый визит) —
    // синхронно ставим её через GET /api/me, иначе сервер вернёт csrf_failed.
    (() => {
      function getCsrf() {
        const m = document.cookie.match(/(?:^|;\s*)csrf=([^;]+)/);
        return m ? m[1] : '';
      }
      async function ensureCsrf() {
        if (getCsrf()) return getCsrf();
        try { await fetch('/api/me', { credentials: 'include' }); } catch {}
        return getCsrf();
      }
      const orig = window.fetch;
      let refreshing = null;
      async function tryRefresh() {
        if (refreshing) return refreshing;
        refreshing = (async () => {
          try {
            const csrf = (await ensureCsrf()) || '';
            const r = await orig.call(window, '/api/auth/refresh', {
              method: 'POST', credentials: 'include',
              headers: { 'X-CSRF-Token': csrf, 'Content-Type': 'application/json' },
            });
            return r.ok;
          } catch { return false; }
          finally { setTimeout(() => { refreshing = null; }, 100); }
        })();
        return refreshing;
      }
      window.fetch = async function(input, init = {}) {
        const method = (init.method || (typeof input === 'string' ? 'GET' : input.method) || 'GET').toUpperCase();
        if (method !== 'GET' && method !== 'HEAD') {
          const csrf = (await ensureCsrf()) || '';
          init.headers = { ...(init.headers || {}), 'X-CSRF-Token': csrf };
          init.credentials = 'include';
        } else {
          init.credentials = init.credentials || 'include';
        }
        const url = typeof input === 'string' ? input : input.url;
        let res = await orig.call(this, input, init);
        if (res.status === 401 && url && url.startsWith('/api/') &&
            !url.includes('/auth/login') && !url.includes('/auth/refresh') &&
            !url.includes('/auth/register') && !url.includes('/auth/quick-signup')) {
          if (await tryRefresh()) {
            res = await orig.call(this, input, init);
          }
        }
        return res;
      };
      ensureCsrf();
    })();
  </script>
</body>
</html>
