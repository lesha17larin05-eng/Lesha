---
// Примеры настоящих планов на неделю (12.11.2026) – скриншоты переписки
// Алексея с учеником. Смысл блока: план реальный, выполнимый и подбирается
// под человека; нагрузка растёт от недели к неделе.
// Из плана 2-й недели убрана личная строка, из 10-й – реакция с аватаркой.
const { cream = false } = Astro.props as { cream?: boolean };
const plans = [
  { img: 'plan-2', w: 958, h: 804, cap: 'Вторая неделя', alt: 'План тренировок на вторую неделю в переписке' },
  { img: 'plan-3', w: 872, h: 764, cap: 'Третья неделя', alt: 'План тренировок на третью неделю в переписке' },
  { img: 'plan-10', w: 924, h: 668, cap: 'Десятая неделя', alt: 'План тренировок на десятую неделю в переписке' },
];
const [main, ...rest] = plans;
---
<section class={`gp-section${cream ? ' gp-cream' : ''}`}>
  <div class="gp-inner">
    <p class="gp-label">План на неделю</p>
    <h2>Так выглядит <em>ваш план</em></h2>
    <p class="gp-desc">Вот настоящие планы, которые я писал ученику: на вторую, третью и десятую неделю. Упражнения выполнимые и делаются дома, а подбираю я их под вас – под ваш опыт, состояние и цели. В начале нагрузка меньше, дальше растёт понемногу.</p>
    <div class="pe-grid">
      <figure class="pe-main">
        <a href={`/img/plans/${main.img}.jpg`} target="_blank" rel="noopener">
          <picture>
            <source type="image/webp" srcset={`/img/plans/${main.img}.webp`} />
            <img src={`/img/plans/${main.img}.jpg`} alt={main.alt} width={main.w} height={main.h} loading="lazy" />
          </picture>
        </a>
        <figcaption>{main.cap}</figcaption>
      </figure>
      <div class="pe-rest">
        {rest.map((p) => (
          <figure>
            <a href={`/img/plans/${p.img}.jpg`} target="_blank" rel="noopener">
              <picture>
                <source type="image/webp" srcset={`/img/plans/${p.img}.webp`} />
                <img src={`/img/plans/${p.img}.jpg`} alt={p.alt} width={p.w} height={p.h} loading="lazy" />
              </picture>
            </a>
            <figcaption>{p.cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>
    <p class="pe-note">Нажмите на план, чтобы рассмотреть. Запись 12/4/3 – это 12 повторений и два удержания: на 4 и на 3 цикла дыхания. Все упражнения сначала разбираем вместе.</p>
    <slot />
  </div>
</section>

<style>
  .pe-grid { display: grid; grid-template-columns: 1.12fr .88fr; gap: 22px; align-items: start; }
  .pe-rest { display: grid; gap: 22px; }
  .pe-grid figure { margin: 0; }
  .pe-grid img { width: 100%; height: auto; display: block; border-radius: 16px; border: 1px solid var(--border, #ece8e0); transition: transform .2s, box-shadow .2s; }
  @media (hover: hover) { .pe-grid a:hover img { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(26,39,68,.1); } }
  .pe-grid a:focus-visible img { outline: 2px solid var(--orange); outline-offset: 3px; }
  .pe-grid figcaption { font-size: 15px; color: var(--text-light, #6e6e6e); margin-top: 8px; }
  .pe-note { font-size: 15px; line-height: 1.6; color: var(--text-light, #6e6e6e); margin: 20px 0 0; max-width: 620px; }
  .pe-note + :global(p) { margin: 20px 0 0; font-size: 17px; color: var(--text-mid, #3a3a3a); }
  .pe-note + :global(p) :global(a) { color: var(--navy); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) {
    .pe-grid { grid-template-columns: 1fr; }
    .pe-rest { grid-template-columns: 1fr 1fr; gap: 14px; }
  }
</style>
