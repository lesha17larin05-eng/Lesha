---
// Пример настоящего плана на неделю (12.11.2026, один план с 12.11 вечера) –
// из переписки Алексея с учеником, без имён и личных строк. Смысл блока:
// план доступный и подбирается под человека.
const { cream = false } = Astro.props as { cream?: boolean };
---
<section class={`gp-section${cream ? ' gp-cream' : ''}`}>
  <div class="gp-inner">
    <p class="gp-label">План на неделю</p>
    <h2>Так выглядит <em>ваш план</em></h2>
    <p class="gp-desc">Вот настоящий план, который я написал ученику на вторую неделю. Упражнения простые и выполнимые дома, а подбираю я их под вас – под ваш опыт, состояние и цели. Дальше нагрузка растёт понемногу.</p>
    <div class="pe-wrap">
      <div class="pe-msg">
        <p class="pe-title">План на вторую неделю</p>
        <p><b>1. Силовая тренировка</b> – в пятницу и понедельник (можно двигать)</p>
        <p><b>3 круга</b>, всё в спокойном темпе:</p>
        <ul>
          <li>Вращение плечами – по 8 повторений вперёд и назад</li>
          <li>Обнимания – 10 повторений</li>
          <li>Приседания – 16 повторений</li>
          <li>Птица-собака – 8 повторений на каждую сторону</li>
          <li>Пресс – 10 повторений</li>
          <li>Ласточка – 12 повторений</li>
          <li>Ласточка – 8 циклов дыхания</li>
        </ul>
        <p>В конце – поза ребёнка от 1 минуты</p>
        <p><b>2. Суставная гимнастика</b> – 1 раз и больше. Можно дополнительно во время ментального напряжения</p>
        <p>По любым вопросам сразу пишите</p>
      </div>
    </div>
    <slot />
  </div>
</section>

<style>
  .pe-wrap { max-width: 620px; }
  .pe-msg { background: #eef7e6; border-radius: 20px 20px 20px 6px; padding: 26px 28px; font-size: 17px; line-height: 1.6; color: #1f2a1c; box-shadow: 0 6px 18px rgba(26,39,68,.06); }
  .pe-msg p { margin: 0 0 12px; }
  .pe-msg p:last-child { margin-bottom: 0; }
  .pe-msg ul { list-style: none; padding: 0; margin: 0 0 12px; }
  .pe-msg li { padding-left: 18px; position: relative; }
  .pe-msg li::before { content: '–'; position: absolute; left: 0; }
  .pe-title { font-weight: 700; font-size: 18px; }
  .pe-wrap + :global(p) { margin: 28px 0 0; font-size: 17px; color: var(--text-mid, #3a3a3a); }
  .pe-wrap + :global(p) :global(a) { color: var(--navy); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) { .pe-msg { padding: 20px; } }
</style>
