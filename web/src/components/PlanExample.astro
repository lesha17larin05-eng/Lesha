---
// Примеры настоящих планов на неделю (12.11.2026) – скриншоты переписки
// Алексея с учеником. Смысл блока: план реальный, выполнимый и подбирается
// под человека; нагрузка растёт от недели к неделе.
// Из плана 2-й недели убрана личная строка, из 10-й – реакция с аватаркой.
const { cream = false } = Astro.props as { cream?: boolean };
const plans = [
  { img: 'plan-2', w: 958, h: 804, cap: 'Вторая неделя', alt: 'План тренировок на вторую неделю в переписке' },
  { img: 'plan-3', w: 872, h: 764, cap: 'Третья неделя', alt: 'План тренировок на третью неделю в переписке' },
  { img: 'plan-10', w: 924, h: 668, cap: 'Десятая неделя', alt: 'План тренировок на десятую неделю в переписке' },
];
---
<section class={`gp-section${cream ? ' gp-cream' : ''}`}>
  <div class="gp-inner">
    <p class="gp-label">План на неделю</p>
    <h2>Так выглядит <em>ваш план</em></h2>
    <p class="gp-desc">Вот настоящие планы, которые я писал разным ученикам в разное время. Упражнения выполнимые и делаются дома, а подбираю я их под вас – под ваш опыт, состояние и цели. В начале нагрузка меньше, дальше растёт понемногу.</p>
    <div class="pe" data-pe>
      <div class="pe-tabs" role="tablist" aria-label="Примеры планов">
        {plans.map((p, i) => (
          <button type="button" role="tab" class={`pe-tab${i === 0 ? ' on' : ''}`} data-i={i} aria-selected={i === 0 ? 'true' : 'false'}>{p.cap}</button>
        ))}
      </div>
      {plans.map((p, i) => (
        <figure class={`pe-slide${i === 0 ? ' on' : ''}`} data-i={i} role="tabpanel">
          <a href={`/img/plans/${p.img}.jpg`} target="_blank" rel="noopener">
            <picture>
              <source type="image/webp" srcset={`/img/plans/${p.img}.webp`} />
              <img src={`/img/plans/${p.img}.jpg`} alt={p.alt} width={p.w} height={p.h} loading="lazy" />
            </picture>
          </a>
        </figure>
      ))}
    </div>
    <p class="pe-note">Нажмите на план, чтобы рассмотреть. Все упражнения и нагрузку сначала разбираем вместе.</p>
    <slot />
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-pe]').forEach((root) => {
    root.classList.add('js');
    const tabs = root.querySelectorAll<HTMLButtonElement>('.pe-tab');
    const slides = root.querySelectorAll<HTMLElement>('.pe-slide');
    tabs.forEach((t) => t.addEventListener('click', () => {
      const i = t.dataset.i;
      tabs.forEach((x) => { const on = x.dataset.i === i; x.classList.toggle('on', on); x.setAttribute('aria-selected', String(on)); });
      slides.forEach((x) => x.classList.toggle('on', x.dataset.i === i));
    }));
  });
</script>

<style>
  .pe { max-width: 760px; }
  .pe-tabs { display: none; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
  .pe.js .pe-tabs { display: flex; }
  .pe-tab { font: inherit; font-size: 15px; padding: 9px 18px; border-radius: 999px; border: 1px solid var(--border, #ece8e0); background: #fff; color: var(--text-mid, #3a3a3a); cursor: pointer; }
  .pe-tab.on { background: var(--navy, #1a2744); border-color: var(--navy, #1a2744); color: #fff; }
  .pe-tab:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
  .pe-slide { margin: 0 0 16px; }
  .pe.js .pe-slide { display: none; margin: 0; }
  .pe.js .pe-slide.on { display: block; }
  .pe-slide img { width: 100%; height: auto; display: block; border-radius: 16px; border: 1px solid var(--border, #ece8e0); }
  .pe-slide a:focus-visible img { outline: 2px solid var(--orange); outline-offset: 3px; }
  .pe-note { font-size: 15px; line-height: 1.6; color: var(--text-light, #6e6e6e); margin: 16px 0 0; max-width: 620px; }
  .pe-note + :global(p) { margin: 20px 0 0; font-size: 17px; color: var(--text-mid, #3a3a3a); }
  .pe-note + :global(p) :global(a) { color: var(--navy); text-decoration: underline; text-underline-offset: 3px; }
</style>
