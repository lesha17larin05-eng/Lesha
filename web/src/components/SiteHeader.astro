---
const { active = '', user = (Astro.locals as any).user } = Astro.props as { active?: string; user?: any };
const links = [
  { href: '/consultation', key: 'consultation', label: 'Консультация' },
  { href: '/', key: 'home', label: 'Личное ведение' },
  { href: '/course', key: 'course', label: 'Бесплатный курс' },
  { href: '/courses/zdorovaya-spina', key: 'spina', label: 'Здоровая спина' },
  { href: '/results', key: 'results', label: 'Результаты' },
  { href: '/blog', key: 'blog', label: 'Блог' },
];
const isSalyut = active === 'salyut';
---
<style is:global>
  /* ─── Кнопка «Здоровая спина в Салюте» в шапке (десктоп) ─────────── */
  .site-nav-salyut {
    font-size: 13px; line-height: 1.3; font-weight: 600;
    color: var(--orange); text-decoration: none;
    padding: 7px 16px; border: 1.5px solid var(--orange);
    border-radius: 10px; text-align: center; flex-shrink: 0;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .site-nav-salyut:hover { background: var(--orange); color: white; text-decoration: none; }
  .site-nav-salyut.is-active { background: rgba(232,101,42,0.10); color: var(--orange); cursor: default; pointer-events: none; }
  @media (max-width: 960px) { .site-nav-salyut { display: none; } }

  /* ─── Гамбургер-кнопка (только мобильная) ─────────────────────────── */
  .site-nav-burger {
    display: none;
    width: 36px; height: 36px; padding: 0; margin-left: auto;
    border: none; background: transparent; cursor: pointer;
    color: var(--navy); border-radius: 8px;
    align-items: center; justify-content: center;
    transition: background 0.15s;
  }
  .site-nav-burger:hover { background: rgba(26,39,68,0.06); }
  .site-nav-burger svg { width: 22px; height: 22px; display: block; }
  @media (max-width: 700px) {
    .site-nav-burger { display: inline-flex; }
    .site-nav-links, .site-nav-right { display: none !important; }
  }

  /* ─── Мобильное выпадающее меню ───────────────────────────────────── */
  .site-mobile-menu {
    position: fixed; top: 64px; left: 0; right: 0;
    background: var(--warm-white);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 12px 32px rgba(26,39,68,0.08);
    transform: translateY(-12px);
    opacity: 0; pointer-events: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
    z-index: 99; max-height: calc(100vh - 64px); overflow-y: auto;
  }
  .site-mobile-menu.is-open { transform: translateY(0); opacity: 1; pointer-events: auto; }
  .site-mobile-menu-inner {
    display: flex; flex-direction: column; padding: 12px 20px 24px;
  }
  .smm-salyut {
    display: flex; align-items: center; justify-content: space-between;
    background: var(--orange); color: white; text-decoration: none;
    border-radius: 12px; padding: 14px 18px;
    font-size: 15px; font-weight: 600; line-height: 1.3;
    margin-bottom: 14px;
    transition: background 0.15s, transform 0.15s;
  }
  .smm-salyut::after { content: '→'; font-size: 18px; }
  .smm-salyut:hover { background: var(--orange-warm); }
  .smm-salyut.is-active { background: rgba(232,101,42,0.15); color: var(--orange); pointer-events: none; }
  .smm-salyut.is-active::after { display: none; }
  .smm-link {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px; border-radius: 10px;
    font-size: 16px; color: var(--text); text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .smm-link:hover { background: rgba(26,39,68,0.05); }
  .smm-link.is-active { color: var(--orange); font-weight: 600; background: rgba(232,101,42,0.06); }
  .smm-link.is-active::after { content: '·'; color: var(--orange); }
  .smm-divider { height: 1px; background: var(--border); margin: 12px 4px; }
  .smm-auth { padding: 12px 16px; font-size: 15px; color: var(--text-mid); text-decoration: none; border-radius: 10px; }
  .smm-auth:hover { background: rgba(26,39,68,0.05); }
  .smm-logout {
    margin-top: 8px; padding: 12px 16px; font-size: 15px;
    background: transparent; color: var(--navy); border: 1.5px solid var(--navy);
    border-radius: 10px; font-family: inherit; font-weight: 600; cursor: pointer;
    text-align: center; transition: all 0.2s;
  }
  .smm-logout:hover { background: var(--navy); color: white; }
  @media (min-width: 701px) { .site-mobile-menu { display: none; } }

  /* блокировка скролла фона при открытом меню */
  body.has-open-menu { overflow: hidden; }
</style>
<nav class="site-nav">
  <a href="/" class="site-nav-logo" aria-label="Алексей Ларин — на главную">
    <img src="/img/logo.svg" alt="Алексей Ларин" style="height:34px; width:auto; display:block;" />
  </a>
  <a href="/salut-2026" class={`site-nav-salyut${isSalyut ? ' is-active' : ''}`} aria-current={isSalyut ? 'page' : undefined}>Здоровая спина<br>в Салюте</a>
  <div class="site-nav-links">
    {links.map(l => (
      <a href={l.href} class={l.key === active ? 'active' : ''}>{l.label}</a>
    ))}
  </div>
  <div class="site-nav-right">
    {user
      ? <>
          <a href="/cabinet" class="site-nav-login">Кабинет</a>
          {user.role === 'admin' && <a href="/admin" class="site-nav-login">Админка</a>}
          <button type="button" id="site-logout-btn" class="site-nav-logout">Выйти</button>
        </>
      : <a href="/auth/login" class="site-nav-login">Войти</a>
    }
  </div>
  <button type="button" id="site-burger-btn" class="site-nav-burger" aria-label="Открыть меню" aria-expanded="false" aria-controls="site-mobile-menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>
</nav>

<div id="site-mobile-menu" class="site-mobile-menu" aria-hidden="true">
  <div class="site-mobile-menu-inner">
    <a href="/salut-2026" class={`smm-salyut${isSalyut ? ' is-active' : ''}`}>Здоровая спина в Салюте</a>
    {links.map(l => (
      <a href={l.href} class={`smm-link${l.key === active ? ' is-active' : ''}`}>{l.label}</a>
    ))}
    <div class="smm-divider"></div>
    {user
      ? <>
          <a href="/cabinet" class="smm-auth">Кабинет</a>
          {user.role === 'admin' && <a href="/admin" class="smm-auth">Админка</a>}
          <button type="button" id="site-logout-btn-mobile" class="smm-logout">Выйти</button>
        </>
      : <a href="/auth/login" class="smm-auth">Войти</a>
    }
  </div>
</div>

<script>
  // ─── Logout (desktop + mobile) ────────────────────────────
  const handleLogout = async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    location.href = '/';
  };
  document.getElementById('site-logout-btn')?.addEventListener('click', handleLogout);
  document.getElementById('site-logout-btn-mobile')?.addEventListener('click', handleLogout);

  // ─── Гамбургер ↔ мобильное меню ───────────────────────────
  const burger = document.getElementById('site-burger-btn');
  const menu = document.getElementById('site-mobile-menu');
  const closeMenu = () => {
    menu?.classList.remove('is-open');
    burger?.setAttribute('aria-expanded', 'false');
    menu?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('has-open-menu');
  };
  const openMenu = () => {
    menu?.classList.add('is-open');
    burger?.setAttribute('aria-expanded', 'true');
    menu?.setAttribute('aria-hidden', 'false');
    document.body.classList.add('has-open-menu');
  };
  burger?.addEventListener('click', () => {
    if (menu?.classList.contains('is-open')) closeMenu();
    else openMenu();
  });
  // закрываем при клике по ссылке или Escape, или при ресайзе на десктоп
  menu?.addEventListener('click', (e) => {
    // closest('a') ловит клик даже если попали в <svg> или <span> внутри ссылки
    if ((e.target as HTMLElement).closest('a')) closeMenu();
  });
  // ─── закрытие при клике на свободное место (вне меню и вне кнопки бургера) ───
  document.addEventListener('click', (e) => {
    if (!menu?.classList.contains('is-open')) return;
    const t = e.target as HTMLElement;
    if (menu.contains(t)) return;
    if (burger?.contains(t)) return;
    closeMenu();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 700) closeMenu();
  });
</script>
