---
const { active = '', user = (Astro.locals as any).user } = Astro.props as { active?: string; user?: any };
const links = [
  { href: '/consultation', key: 'consultation', label: 'Консультация' },
  { href: '/', key: 'home', label: 'Личное ведение' },
  { href: '/course', key: 'course', label: 'Бесплатный курс' },
  { href: '/courses/zdorovaya-spina', key: 'spina', label: 'Здоровая спина' },
  { href: '/results', key: 'results', label: 'Результаты' },
  { href: '/blog', key: 'blog', label: 'Блог' },
];
const isSalyut = active === 'salyut';
---
<style is:global>
  .site-nav-salyut {
    font-size: 13px; line-height: 1.3; font-weight: 600;
    color: var(--orange); text-decoration: none;
    padding: 7px 16px; border: 1.5px solid var(--orange);
    border-radius: 10px; text-align: center; flex-shrink: 0;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .site-nav-salyut:hover { background: var(--orange); color: white; text-decoration: none; }
  .site-nav-salyut.is-active { background: rgba(232,101,42,0.10); color: var(--orange); cursor: default; pointer-events: none; }
  @media (max-width: 960px) { .site-nav-salyut { display: none; } }
</style>
<nav class="site-nav">
  <a href="/" class="site-nav-logo" aria-label="Алексей Ларин — на главную">
    <img src="/img/logo.svg" alt="Алексей Ларин" style="height:34px; width:auto; display:block;" />
  </a>
  <a href="/salut-2026" class={`site-nav-salyut${isSalyut ? ' is-active' : ''}`} aria-current={isSalyut ? 'page' : undefined}>Здоровая спина<br>в Салюте</a>
  <div class="site-nav-links">
    {links.map(l => (
      <a href={l.href} class={l.key === active ? 'active' : ''}>{l.label}</a>
    ))}
  </div>
  <div class="site-nav-right">
    {user
      ? <>
          <a href="/cabinet" class="site-nav-login">Кабинет</a>
          {user.role === 'admin' && <a href="/admin" class="site-nav-login">Админка</a>}
          <button type="button" id="site-logout-btn" class="site-nav-logout">Выйти</button>
        </>
      : <a href="/auth/login" class="site-nav-login">Войти</a>
    }
  </div>
</nav>
<script>
  document.getElementById('site-logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    location.href = '/';
  });
</script>
