---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { extractLegacy } from '../../lib/legacy';
import rawHtml from '../../legacy/zdorovaya-spina.html?raw';
import { apiJson } from '../../lib/api';

const cookie = Astro.request.headers.get('cookie') || '';
const user = (Astro.locals as any).user;

// Fetch enrollment status only for logged-in users
let enrolled = false;
if (user) {
  const { data, status } = await apiJson<any>('/api/courses/zdorovaya-spina', { cookie });
  if (status === 200) enrolled = !!data.enrolled;
}

const { styles, body: rawBody } = extractLegacy(rawHtml);
// Strip anchor-nav (second <nav>) and edit bar
const reSecondNav = /<nav[\s\S]*?<\/nav>/i;
const reEditBar  = /<div\s+id=["']edit-bar["'][\s\S]*?<\/div>/i;
const body = rawBody.replace(reSecondNav, '').replace(reEditBar, '');
---
<SiteLayout title="Здоровая спина – курс Алексея Ларина" active="spina" pageStyles={styles}>
  <Fragment set:html={body} />
  <script define:vars={{ enrolled, isLoggedIn: !!user }}>
    if (enrolled) {
      // Eyebrow
      const eyebrow = document.querySelector('.eyebrow-text');
      if (eyebrow) eyebrow.textContent = 'Доступ открыт · 11 уроков · онлайн';

      // Promise
      const promise = document.querySelector('.hero-promise p');
      if (promise) promise.innerHTML = 'У вас уже есть доступ к курсу. <strong>Все 11 уроков открыты</strong> – переходите к занятиям и начинайте в любом порядке.';

      // CTA button
      const btn = document.querySelector('.btn-hero');
      if (btn) {
        btn.textContent = 'Перейти к урокам →';
        btn.setAttribute('href', '/cabinet/zdorovaya-spina');
        btn.removeAttribute('onclick');
      }

      // Hide safety text and start-pill
      const safety = document.querySelector('.hero-safety');
      if (safety) safety.style.display = 'none';

      // Hide tariffs, FAQ, final-cta sections
      ['#tariffs', '.final-cta', '.guarantee-faq'].forEach(sel => {
        const el = document.querySelector(sel);
        if (el) el.style.display = 'none';
      });
    }

    // ─── Tariff buttons → POST /checkout → редирект на Продамус ─────────
    async function startCheckout(tariff) {
      // незалогиненный юзер: редирект на регистрацию с возвратом сюда
      if (!isLoggedIn) {
        const next = encodeURIComponent('/courses/zdorovaya-spina?tariff=' + tariff);
        window.location.href = '/auth/register?next=' + next;
        return;
      }
      const r = await fetch('/api/courses/zdorovaya-spina/checkout?tariff=' + encodeURIComponent(tariff), {
        method: 'POST',
      });
      const data = await r.json().catch(() => ({}));
      if (r.ok && data.payment_url) {
        window.location.href = data.payment_url;
        return;
      }
      switch (data.error) {
        case 'email_not_verified':
          alert('Перед оплатой подтвердите email — ссылка отправлена в письме после регистрации.');
          break;
        case 'already_enrolled':
          window.location.href = '/cabinet/zdorovaya-spina';
          break;
        case 'bad_tariff':
        case 'tariff_required':
          alert('Неизвестный тариф. Обновите страницу и попробуйте снова.');
          break;
        default:
          alert('Не удалось создать платёж. Попробуйте позже или напишите в Telegram @larin_lesha.');
      }
    }

    document.querySelectorAll('[data-tariff]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const key = el.getAttribute('data-tariff');
        if (key !== 'self' && key !== 'support') return;
        const origLabel = el.textContent;
        el.style.pointerEvents = 'none';
        el.textContent = 'Открываю оплату…';
        startCheckout(key)
          .catch(() => alert('Ошибка соединения. Попробуйте ещё раз.'))
          .finally(() => {
            el.style.pointerEvents = '';
            el.textContent = origLabel;
          });
      });
    });

    // Если страница открыта с ?tariff=... и юзер залогинен — автозапуск чекаута.
    // Это срабатывает после регистрации (мы редиректим обратно на эту URL).
    const _q = new URLSearchParams(window.location.search);
    const _autoTariff = _q.get('tariff');
    if (_autoTariff && isLoggedIn && !enrolled) {
      history.replaceState({}, '', window.location.pathname);
      startCheckout(_autoTariff);
    }
  </script>
</SiteLayout>
