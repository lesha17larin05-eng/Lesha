---
// Лендинг бесплатного курса «Мягкий старт» (стили – landing.css, классы gp-*).
// Уроки и описания – из API (таблица lessons), здесь только оформление.
import SiteLayout from '../../layouts/SiteLayout.astro';
import { apiJson } from '../../lib/api';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import QuickSignupForm from '../../components/QuickSignupForm.astro';
import ReviewsCarousel from '../../components/ReviewsCarousel.astro';
import '../../styles/landing.css';

const cookie = Astro.request.headers.get('cookie') || '';
const user = (Astro.locals as any).user;

const slug = 'myagkiy-start';

const { data, status } = await apiJson<any>(`/api/courses/${slug}`, { cookie });
if (status !== 200) return Astro.redirect('/courses', 302);

const enrolled: boolean = !!data.enrolled;
const course = data.course;
const rawLessons: any[] = data.lessons || [];
// Бесплатный курс – все уроки доступны без enrollment
const isFreeCourse = course?.kind === 'free';

// UI-only metadata keyed by lesson slug (colours/tags – not content)
const slugMeta: Record<string, { tag: string; tagBg: string; tagColor: string }> = {
  'vvodnyy':               { tag: 'Введение',  tagBg: '', tagColor: '' },
  'sustavnaya-gimnastika': { tag: 'Всё тело',  tagBg: '', tagColor: '' },
  'sheya':                 { tag: 'Шея',       tagBg: '', tagColor: '' },
  'zdorovaya-spina':       { tag: 'Спина',     tagBg: '', tagColor: '' },
  'stopy':                 { tag: 'Стопы',     tagBg: '', tagColor: '' },
  'tazobedrennyye-sustavy':{ tag: 'Таз и бёдра', tagBg: '', tagColor: '' },
  'meditatsiya':           { tag: 'Медитация', tagBg: '', tagColor: '' },
  'itogovyy':              { tag: 'Итог',      tagBg: '', tagColor: '' },
};

// Ссылки на YouTube и ВК для каждого урока – кнопки под видео.
const videoLinks: Record<string, { youtube: string; vk: string }> = {
  'vvodnyy':               { youtube: 'https://youtu.be/unnNrpAhZXw', vk: 'https://vkvideo.ru/video-141544391_456239600?list=ln-curpXNJ6WIAAZE4QYq' },
  'sustavnaya-gimnastika': { youtube: 'https://youtu.be/FmMPe-kj-vc', vk: 'https://vkvideo.ru/video-141544391_456239626?list=ln-0zqbHz4u7E4LIi08BF' },
  'sheya':                 { youtube: 'https://youtu.be/WkpJ91SuzMQ', vk: 'https://vkvideo.ru/video-141544391_456239602?list=ln-lJenrW8Aw9WvjKOUph' },
  'zdorovaya-spina':       { youtube: 'https://youtu.be/2SteUTw8W70', vk: 'https://vkvideo.ru/video-141544391_456239603?list=ln-3uhrATQFzcGbPm733E' },
  'stopy':                 { youtube: 'https://youtu.be/YjBP2ZfncGQ', vk: 'https://vkvideo.ru/video-141544391_456239604?list=ln-gWUMLYyhdzuOpH97Ev' },
  'tazobedrennyye-sustavy':{ youtube: 'https://youtu.be/EVL0Ptb80Hk', vk: 'https://vkvideo.ru/video-141544391_456239605?list=ln-lzKgZrMzUEtSTRxRxZ' },
  'meditatsiya':           { youtube: 'https://youtu.be/n__CTTITCzI', vk: 'https://vkvideo.ru/video-141544391_456239606?list=ln-zXzqkZWLYscI6e5vdL' },
  'itogovyy':              { youtube: 'https://youtu.be/YU806LDeie0', vk: 'https://vkvideo.ru/video-141544391_456239607?list=ln-zj1WZXmZgvtVCnakJ1' },
};

const lessons = rawLessons.map((l: any, i: number) => {
  const meta = slugMeta[l.slug] ?? { tag: '', tagBg: '#f0f0f0', tagColor: '#444' };
  const mins = l.duration_sec ? Math.round(l.duration_sec / 60) : 0;
  const video = videoLinks[l.slug] ?? { youtube: '', vk: '' };
  return {
    num: i,
    slug: l.slug,
    title: l.title,
    desc: l.content_md || '',
    duration: mins ? `${mins} мин` : '',
    tag: meta.tag,
    tagBg: meta.tagBg,
    tagColor: meta.tagColor,
    isFree: !!l.is_preview,
    video,
  };
});
const reviews = [
  { v: 36, name: 'Алёна', text: 'Позвоночник «кайфанул» уже после первой тренировки' },
  { v: 61, name: 'Мария', text: 'Десятиминутные зарядки каждый день преображают весь день' },
  { v: 11, name: 'Александр', text: 'Бодрость и спокойствие одновременно' },
  { v: 64, name: 'Анна', text: 'Встроила спорт в жизнь, ушли зажимы в плечах и спине' },
  { v: 14, name: 'Мария', text: 'Прилив сил после каждого занятия, спина гибкая и лёгкая' },
  { v: 12, name: 'Варвара', text: 'Укрепление без изнурения, сон стал крепче' },
  { v: 10, name: 'Елена', text: 'Ушла скованность в шее и плечах' },
  { v: 62, name: 'Елизавета', text: 'Мягкость, поддержка и желание продолжать' },
  { v: 20, name: 'Елена', text: 'Засыпает быстрее – проблема со сном почти ушла' },
  { v: 58, name: 'Дарья', text: 'Взяла себя в руки, вернула энергию и начала бегать' },
];
---
<SiteLayout title="Мягкий старт – бесплатный курс Алексея Ларина" description="Бесплатный курс «Мягкий старт»: 8 коротких практик – суставная гимнастика, шея, спина, стопы, медитация. Доступ сразу после регистрации." active="courses">

  <!-- ПЕРВЫЙ ЭКРАН -->
  <section class="gp-hero">
    <div class="gp-hero-text">
      <p class="gp-eyebrow"><span class="dot"></span>Бесплатный курс · онлайн</p>
      <h1>Мягкий <em>старт</em></h1>
      <p class="gp-sub">Восемь коротких практик для тех, кто давно хотел начать: суставная гимнастика, шея, спина, стопы, медитация. В своём темпе, с любого урока.</p>
      <div class="gp-params">
        <div><b>8</b><span>практик</span></div>
        <div><b>3–36 мин</b><span>каждая</span></div>
        <div><b>0 ₽</b><span>доступ навсегда</span></div>
      </div>
      <div class="gp-cta">
        {enrolled
          ? <a href="/cabinet/myagkiy-start" class="btn-main">Перейти к урокам →</a>
          : user
            ? <button type="button" id="enroll-btn" class="btn-main">Получить доступ бесплатно</button>
            : <a href="#get-access" class="btn-main">Получить доступ бесплатно ↓</a>}
      </div>
    </div>
    <div class="gp-hero-photo">
      <picture>
        <source type="image/webp" srcset="/img/IMG_3990.webp 1x, /img/IMG_3990@2x.webp 2x" />
        <img src="/img/IMG_3990.jpg" srcset="/img/IMG_3990.jpg 1x, /img/IMG_3990@2x.jpg 2x" alt="Алексей Ларин" width="1155" height="1733" loading="eager" fetchpriority="high" />
      </picture>
    </div>
  </section>

  {/* ДЛЯ КОГО */}
  {!enrolled && (
  <section class="gp-section">
    <div class="gp-inner">
      <p class="gp-label">Для кого</p>
      <h2>Если вам <em>знакомо</em></h2>
      <div class="gp-cards3">
        <div class="gp-card">
          <h3>Давно собираетесь начать</h3>
          <p>Хочется двигаться, но непонятно, с чего начать и сколько нужно. Здесь – короткие практики: выбираете одну и делаете.</p>
        </div>
        <div class="gp-card">
          <h3>Много сидите</h3>
          <p>К вечеру тяжелеют шея, плечи и спина. Есть практики, которые можно сделать прямо после рабочего дня.</p>
        </div>
        <div class="gp-card">
          <h3>Хочется мягко, без перегруза</h3>
          <p>Без изнурения и сложных программ. Движения в комфортной амплитуде – тело само подскажет, когда можно больше.</p>
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- УРОКИ -->
  <section class={`gp-section${enrolled ? '' : ' gp-cream'}`} id="lessons">
    <div class="gp-inner">
      <p class="gp-label">Уроки курса</p>
      <h2>Восемь практик – <em>начните с любой</em></h2>
      <p class="gp-desc">Каждый урок самостоятельный: выберите тот, что сейчас актуален. После регистрации все видео открываются в личном кабинете.</p>
      <div class="ms-grid">
        {lessons.map((l) => {
          const href = enrolled ? `/cabinet/${slug}#${l.slug}` : '#get-access';
          return (
            <a href={href} class="ms-card">
              <div class="ms-cover">
                <ResponsiveImage base={`/img/myagkiy-start/${l.slug}`} ext="jpg" width="640" height="360" alt={`Урок «${l.title}»`} class="ms-cover-img" loading="lazy" />
                <span class="ms-play" aria-hidden="true"><svg viewBox="0 0 24 24"><polygon points="7,4 20,12 7,20" /></svg></span>
                {l.duration && <span class="ms-dur">{l.duration}</span>}
              </div>
              <div class="ms-body">
                {l.tag && <span class="ms-tag">{l.tag}</span>}
                <h3>{l.title}</h3>
                <p>{l.desc}</p>
                <span class="ms-go">{enrolled ? 'Смотреть урок →' : 'Получить доступ →'}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* КАК НАЧАТЬ */}
  {!enrolled && (
  <section class="gp-section">
    <div class="gp-inner">
      <p class="gp-label">Как это устроено</p>
      <h2>Три шага <em>до первой практики</em></h2>
      <div class="gp-steps ms-steps">
        <div class="gp-step"><div class="gp-num">1</div><div><h3>Оставьте имя и почту</h3><p>Пароль придумывать не нужно – доступ открывается сразу.</p></div></div>
        <div class="gp-step"><div class="gp-num">2</div><div><h3>Выберите урок</h3><p>Под то, что беспокоит сейчас: шея, спина, всё тело или голова, которая не выключается.</p></div></div>
        <div class="gp-step"><div class="gp-num">3</div><div><h3>Сделайте одну практику</h3><p>Сегодня или завтра. А в следующие дни пришлю пару писем – подскажу, как продолжить.</p></div></div>
      </div>
    </div>
  </section>
  )}

  <!-- КТО ВЕДЁТ -->
  <section class="gp-author">
    <div class="gp-author-photo">
      <picture>
        <source type="image/webp" srcset="/img/IMG_4046.webp 1x, /img/IMG_4046@2x.webp 2x" />
        <img src="/img/IMG_4046.jpg" srcset="/img/IMG_4046.jpg 1x, /img/IMG_4046@2x.jpg 2x" alt="Алексей Ларин" width="1155" height="1733" loading="lazy" />
      </picture>
    </div>
    <div class="gp-author-text">
      <p class="gp-label">Кто ведёт</p>
      <h2>Алексей Ларин</h2>
      <p class="gp-quote">Тренировки, после которых хочется жить.</p>
      <p>Сам восстанавливался после травм спины и плеча – через движение. Знаю этот путь изнутри.</p>
      <p>Больше 10 лет тренирую детей и взрослых, магистр Российского университета спорта «ГЦОЛИФК». За это время со мной занимались больше 8 000 человек – на курсах, в детских лагерях, на групповых и личных занятиях.</p>
      <p>В курсе – практики, которые я делаю сам и даю ученикам на занятиях. Собрал их в простой и понятный формат.</p>
    </div>
  </section>

  <!-- ОТЗЫВЫ -->
  <section class="gp-section">
    <div class="gp-inner">
      <p class="gp-label gp-center">Отзывы</p>
      <h2 class="gp-center">Люди, которые <em>начали</em></h2>
      <div class="gp-reviews-wrap"><ReviewsCarousel reviews={reviews} /></div>
      <p class="gp-center gp-more"><a href="/results">Все отзывы →</a></p>
    </div>
  </section>

  {!enrolled && (
    <section class="ms-enroll" id="get-access">
      <div class="ms-enroll-inner">
        <p class="gp-label gp-center">Получить доступ</p>
        <h2 class="gp-center">Начните сегодня – <em>это бесплатно</em></h2>
        {user ? (
          <>
            <p class="ms-enroll-desc">Нажмите кнопку – и сразу получите доступ ко всем 8 урокам.</p>
            <button type="button" id="enroll-btn-bottom" class="btn-main btn-full">Получить доступ бесплатно</button>
          </>
        ) : (
          <>
            <p class="ms-enroll-desc">Оставьте имя и почту – и сразу получите доступ ко всем 8 урокам.</p>
            <QuickSignupForm />
          </>
        )}
      </div>
    </section>
  )}

  <!-- ДАЛЬШЕ -->
  <section class="gp-section gp-cream">
    <div class="gp-inner ms-next">
      <div>
        <h2>Захочется <em>больше</em></h2>
        <p class="gp-desc">Программа на три недели – <a href="/courses/zdorovaya-spina">«Здоровая спина»</a>. А если хочется тренироваться с тренером – <a href="/#so-mnoy">персональные тренировки, группа или личное ведение</a>.</p>
      </div>
      <a href="https://t.me/lesha_larin" target="_blank" rel="noopener" class="ms-tg">Telegram-канал: короткие практики и разборы →</a>
    </div>
  </section>

  <style>
    .ms-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .ms-card { display: flex; flex-direction: column; background: white; border: 1px solid var(--border, #ece8e0); border-radius: 20px; overflow: hidden; text-decoration: none; color: inherit; transition: transform .2s, box-shadow .2s; }
    @media (hover: hover) { .ms-card:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(26,39,68,.09); } .ms-card:hover .ms-play { background: var(--orange); } }
    .ms-card:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
    .ms-cover { position: relative; aspect-ratio: 16 / 9; background: #e8e4dc; overflow: hidden; }
    .ms-cover :global(picture) { position: absolute; inset: 0; }
    .ms-cover :global(.ms-cover-img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ms-play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 60px; height: 60px; border-radius: 50%; background: var(--navy); display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 24px rgba(0,0,0,.25); transition: background .2s; }
    .ms-play svg { width: 22px; height: 22px; fill: white; margin-left: 3px; }
    .ms-dur { position: absolute; right: 12px; bottom: 12px; background: rgba(255,255,255,.9); color: var(--navy); font-size: 15px; font-weight: 600; padding: 4px 12px; border-radius: 100px; }
    .ms-body { padding: 22px 24px 24px; display: flex; flex-direction: column; flex: 1; }
    .ms-tag { font-size: 15px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--orange); margin-bottom: 8px; }
    .ms-body h3 { font-size: 20px; font-weight: 600; color: var(--navy); margin: 0 0 8px; line-height: 1.3; }
    .ms-body p { font-size: 17px; line-height: 1.7; color: var(--text-muted, #555); margin: 0 0 14px; flex: 1; }
    .ms-go { font-size: 16px; font-weight: 600; color: var(--orange); }
    .ms-steps { grid-template-columns: repeat(3, 1fr); }

    .ms-enroll { padding: 96px 24px; background: var(--navy); }
    .ms-enroll-inner { max-width: 600px; margin: 0 auto; }
    .ms-enroll h2 { font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: clamp(34px, 3.4vw, 50px); line-height: 1.12; color: white; margin: 0 0 14px; }
    .ms-enroll h2 em { font-style: italic; color: #8bb8f0; }
    .ms-enroll-desc { text-align: center; font-size: 18px; line-height: 1.6; color: rgba(255,255,255,.85); margin: 0 0 30px; }

    .ms-next { display: flex; align-items: center; justify-content: space-between; gap: 32px; }
    .ms-next .gp-desc { margin: 0; }
    .ms-next .gp-desc a { color: var(--navy); font-weight: 600; text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 4px; transition: color .2s; }
    .ms-next .gp-desc a:hover { color: var(--orange); }
    .ms-tg { flex-shrink: 0; font-size: 17px; font-weight: 600; color: #229ed9; text-decoration: none; transition: color .2s; }
    .ms-tg:hover { color: var(--navy); }
    .ms-tg:focus-visible { outline: 2px solid #229ed9; outline-offset: 3px; border-radius: 4px; }

    @media (max-width: 1000px) { .ms-steps { grid-template-columns: 1fr; } .ms-next { flex-direction: column; align-items: flex-start; } }
    @media (max-width: 800px) { .ms-grid { grid-template-columns: 1fr; } }
    @media (max-width: 700px) { .ms-enroll { padding: 64px 20px; } }
  </style>

  <script define:vars={{ slug }}>
    async function enrollFree() {
      const r = await fetch(`/api/courses/${slug}/enroll-free`, { method: 'POST' });
      if (r.ok) location.reload();
      else {
        const j = await r.json().catch(() => ({}));
        alert(j.error || 'Ошибка – попробуйте ещё раз');
      }
    }
    document.getElementById('enroll-btn')?.addEventListener('click', enrollFree);
    document.getElementById('enroll-btn-bottom')?.addEventListener('click', enrollFree);
  </script>
</SiteLayout>
