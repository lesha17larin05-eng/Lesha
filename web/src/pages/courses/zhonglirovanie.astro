---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CourseBuy from '../../components/CourseBuy.astro';
import { apiJson } from '../../lib/api';
import '../../styles/landing.css';

// Лендинг курса «Жонглирование: у вас получится» (стили – landing.css, gp-*).
// Покупка в один шаг – компонент CourseBuy (quick-checkout). Цены – из API
// (tariffs, с учётом стартовой цены со сроком). Если курс снят с публикации
// в /admin/courses, API отвечает 404 – страницу видит только админ.
const cookie = Astro.request.headers.get('cookie') || '';
const user = (Astro.locals as any).user;
const isAdmin = user?.role === 'admin';
const { data, status } = await apiJson<any>('/api/courses/zhonglirovanie', { cookie });
if (status !== 200 && !isAdmin) {
  return new Response(null, { status: 404 });
}
const enrolled = status === 200 && !!data?.enrolled;
const isDraft = status !== 200;

const fmtRub = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
type T = { price: number; base_price: number; promo_until?: string };
const tariffs: Record<string, T> = data?.tariffs || {};
const self: T = tariffs.self || { price: 1490, base_price: 1490 };
const support: T = tariffs.support || { price: 3990, base_price: 3990 };
const promoUntil = self.promo_until || support.promo_until || null;
const promoLastDay = promoUntil
  ? new Date(new Date(promoUntil).getTime() - 1000).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', timeZone: 'Europe/Moscow' })
  : '';

const ASK = 'Здравствуйте, Алексей! Есть вопрос по курсу «Жонглирование»: ';
const TG = 'https://t.me/larin_lesha?text=' + encodeURIComponent(ASK);
const MAX = 'https://max.ru/u/f9LHodD0cOJK26BnKhvEBfpuj05eZ2Tn1oTqJ7kv0OoP_WfKwTiqDPGe-Nc?text=' + encodeURIComponent(ASK);

const program = [
  { n: 0, t: 'Знакомство с курсом', d: 'Как устроена методика и как по ней заниматься.', free: true },
  { n: 1, t: 'Фундамент – один мяч', d: 'Бросок «ковшом» через центр по дуге и 4 частые ошибки.' },
  { n: 2, t: 'Два мяча', d: 'Оба броска вверх, в обе стороны – и почему нельзя передавать мяч внизу.' },
  { n: 3, t: 'Два мяча в одной руке', d: 'Хват, который готовит руку к третьему мячу. И интервью с вожатой Катей.' },
  { n: 4, t: 'Три броска', d: 'Раз, два, три – поймали. Что делать, если третий мяч «не отпускается».' },
  { n: 5, t: 'Без остановки', d: 'Четвёртый, пятый бросок и дальше. Однажды случится магия – как первый шаг ребёнка.' },
  { n: 6, t: 'Вершина – 30 секунд', d: 'Подходы, отдых, секундомер – и подарок себе, который вы придумаете заранее.' },
  { n: 7, t: 'Что дальше', d: 'Жонглирование как медитация на 3–5 минут, следующий трюк и как научить близкого.' },
];

const faq = [
  { q: 'Мне кажется, у меня совсем нет координации. Получится?', a: 'Курс сделан в первую очередь для вас. Мы начинаем с одного мяча, и на каждом шаге есть понятный критерий. Уметь заранее ничего не нужно – нужно пройти шаги по порядку и практиковать.' },
  { q: 'Сколько времени нужно, чтобы научиться?', a: 'Индивидуально. В лагере кому-то на первый шаг хватало 15 минут, кому-то – нескольких дней. Хватит коротких подходов с отдыхом, например по 10–15 минут в день. Отдых тоже важен: в это время нервная система усваивает навык.' },
  { q: 'С какого возраста можно?', a: 'Методику проходили дети, подростки, вожатые и взрослые. Если ребёнок может удержать внимание на объяснении и повторить за видео – ему подойдёт. Верхнего предела по возрасту нет.' },
  { q: 'Какие мячи нужны и где их взять?', a: 'Для начала – любой мяч, который есть дома, например теннисный: первые уроки вы всё равно занимаетесь с одним мячом. И сразу закажите на маркетплейсе набор «мячи для жонглирования» – с мелким песком внутри, они не отскакивают и лучше слушаются руки.' },
  { q: 'Сколько нужно места?', a: 'Немного свободного пространства перед собой и над головой. Удобнее всего стоять перед кроватью или диваном – упавшие мячи будет проще поднимать.' },
  { q: 'Что делать, если застрял на каком-то шаге?', a: 'Вернуться на шаг назад – это нормально и работает. Пересмотреть урок и сверить технику. Снять себя на телефон – со стороны ошибки видно сразу. А в тарифе «С разбором» я посмотрю ваши видео и подскажу сам.' },
  { q: 'Можно заниматься вместе с ребёнком по одной покупке?', a: 'Да, смотрите уроки вместе. Разборы видео в тарифе «С разбором» – для одного человека.' },
  { q: 'Как я получу доступ?', a: 'Регистрироваться заранее не нужно: укажите имя и почту и оплатите. Уроки откроются в личном кабинете сразу после оплаты, а ссылка для входа придёт на почту. Доступ – на 1 год, смотреть можно с телефона и компьютера.' },
];
const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---
<SiteLayout
  title="Жонглирование: у вас получится – курс Алексея Ларина"
  description="Онлайн-курс жонглирования для новичков: научитесь жонглировать тремя мячами с нуля. 8 видеоуроков, 6 шагов и понятный критерий перехода в каждом упражнении."
  active="courses"
  ogImage="/img/zhonglirovanie/juggling@2x.jpg"
  noindex={isDraft}>
  {isDraft && <div class="zh-draft">Черновик: курс не опубликован – страницу видите только вы (админ). Опубликовать – в /admin/courses.</div>}
  <script type="application/ld+json" set:html={faqJsonLd} />

  <!-- ПЕРВЫЙ ЭКРАН -->
  <section class="gp-hero">
    <div class="gp-hero-text">
      <p class="gp-eyebrow"><span class="dot"></span>{enrolled ? 'Доступ открыт · 8 видеоуроков' : 'Онлайн-курс · 8 видеоуроков'}</p>
      <h1>Жонглирование: <em>у вас получится</em></h1>
      <p class="gp-sub">Научитесь жонглировать тремя мячами с нуля – шаг за шагом. По этой методике я научил жонглировать больше 50 детей и взрослых.</p>
      <div class="gp-params">
        <div><b>8</b><span>видеоуроков</span></div>
        <div><b>6 шагов</b><span>до трёх мячей</span></div>
        <div><b>30 сек</b><span>цель курса</span></div>
      </div>
      <div class="gp-cta">
        {enrolled
          ? <a href="/cabinet/zhonglirovanie" class="btn-main">Перейти к урокам →</a>
          : <a href="#tariffs" class="btn-main">Выбрать тариф ↓</a>}
      </div>
      {!enrolled && <p class="gp-safe">{promoUntil ? `Стартовая цена до ${promoLastDay} · ` : ''}Первые броски – сегодня, для начала хватит одного мяча</p>}
    </div>
    <div class="gp-hero-photo">
      <picture>
        <source type="image/webp" srcset="/img/zhonglirovanie/hero.webp 1x, /img/zhonglirovanie/hero@2x.webp 2x" />
        <img src="/img/zhonglirovanie/hero.jpg" srcset="/img/zhonglirovanie/hero.jpg 1x, /img/zhonglirovanie/hero@2x.jpg 2x" alt="Алексей Ларин жонглирует" width="859" height="1289" loading="eager" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <!-- ДЛЯ КОГО -->
  <section class="gp-section">
    <div class="gp-inner">
      <p class="gp-label">Для кого</p>
      <h2>Если вы хоть раз подумали <em>«я бы тоже так хотел»</em></h2>
      <p class="gp-desc">Я предлагаю этот курс в первую очередь тем, кто заранее решил, что у него не получится. Именно у таких людей самые яркие истории.</p>
      <div class="zh-who">
        <div class="gp-card"><h3>«У меня плохая координация»</h3><p>Особый талант не нужен. Начинаем с одного мяча и идём маленькими шагами – каждый следующий опирается на предыдущий.</p></div>
        <div class="gp-card"><h3>Давно не учились чему-то новому</h3><p>Кажется, что про себя уже всё понятно. Жонглирование – быстрый и честный способ снова почувствовать: «я могу больше, чем думал».</p></div>
        <div class="gp-card"><h3>Хотите заниматься с ребёнком</h3><p>Методика выросла в детском лагере. Учиться вместе и видеть глаза ребёнка, когда у него получилось, – отдельное удовольствие.</p></div>
        <div class="gp-card"><h3>Пробовали по роликам – и бросили</h3><p>В роликах обычно показывают результат, путь к нему остаётся за кадром. Здесь – последовательные упражнения, разбор частых ошибок и понятно, когда идти дальше.</p></div>
      </div>
    </div>
  </section>

  <!-- ЗНАКОМСТВО -->
  <section class="gp-section gp-cream" id="video">
    <div class="gp-inner zh-intro">
      <div>
        <p class="gp-label">Первый урок – бесплатно</p>
        <h2>Как устроен <em>курс</em></h2>
        <p class="gp-desc">Первое видео курса – знакомство, 3,5 минуты. Как устроена методика, как по ней заниматься и почему она подходит тем, кто сомневается, что у него получится.</p>
        {!enrolled && <a href="#tariffs" class="btn-main">Выбрать тариф ↓</a>}
      </div>
      <div class="zh-video">
        <video controls preload="none" playsinline poster="/img/zhonglirovanie/intro-poster.jpg" src="/lesson-videos/promo/zhonglirovanie-znakomstvo.mp4"></video>
      </div>
    </div>
  </section>

  <!-- ПРОГРАММА -->
  <section class="gp-section">
    <div class="gp-inner">
      <p class="gp-label">Программа</p>
      <h2>8 уроков – <em>шаг за шагом к трём мячам</em></h2>
      <p class="gp-desc">Вы не прыгаете сразу к трём мячам. Каждый урок – одно упражнение: получилось – идёте дальше. В каждом – разбор ошибок, которые встречались почти у всех.</p>
      <div class="zh-program">
        {program.map((l) => (
          <div class="gp-step">
            <div class="gp-num">{l.n}</div>
            <div><h3>{l.t}{l.free && <span class="zh-free">бесплатно</span>}</h3><p>{l.d}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ПОЧЕМУ Я -->
  <section class="gp-author">
    <div class="gp-author-photo">
      <picture>
        <source type="image/webp" srcset="/img/zhonglirovanie/author.webp 1x, /img/zhonglirovanie/author@2x.webp 2x" />
        <img src="/img/zhonglirovanie/author.jpg" srcset="/img/zhonglirovanie/author.jpg 1x, /img/zhonglirovanie/author@2x.jpg 2x" alt="Алексей Ларин с мячами в детском лагере" width="1200" height="800" loading="lazy" style="object-position: 45% 40%" />
      </picture>
    </div>
    <div class="gp-author-text">
      <p class="gp-label">Почему именно я</p>
      <h2>Методика родилась в детском лагере</h2>
      <p class="gp-quote">От простого к сложному, с понятным критерием на каждом шаге.</p>
      <p>Работая тренером в лагере, я предлагал научиться жонглировать всем желающим – и уже сбился со счёта: больше 50 детей, вожатых и взрослых. Так сложилась методика: последовательные шаги, понятные критерии и разбор ошибок, которые встречаются почти у всех.</p>
      <p>Меня больше всего вдохновляют люди, которые заранее решили, что у них не получится. Они доверяются, делают первый шаг, практикуют – и у них получается. Этот опыт потом помогает пробовать новое и в других сферах жизни.</p>
      <p>Магистр Российского университета спорта «ГЦОЛИФК», больше 10 лет работаю с детьми и взрослыми.</p>
    </div>
  </section>

  <!-- В ЛАГЕРЕ -->
  <section class="gp-section">
    <div class="gp-inner zh-camp">
      <div class="zh-reels">
        <div class="zh-reel-main"><video controls preload="none" playsinline poster="/img/zhonglirovanie/reel-1.jpg" src="/lesson-videos/promo/zh-reel-1.mp4" aria-label="Ролик из лагеря"></video></div>
        <div class="zh-thumbs">
          {[1, 2, 3, 4].map((n) => (
            <button type="button" class={`zh-thumb${n === 1 ? ' is-active' : ''}`} data-reel={n} aria-label={`Ролик ${n}`}><img src={`/img/zhonglirovanie/reel-${n}.jpg`} alt="" width="90" height="160" loading="lazy" /></button>
          ))}
        </div>
      </div>
      <div>
        <p class="gp-label">Как это было в лагере</p>
        <h2>Учились <em>между делом</em> – и получалось</h2>
        <blockquote class="zh-quote">«Меня очень веселит сам процесс. Первые 2–3 минутки ещё никакие, а потом входишь в кураж – и какое-то веселье, и даже физическая активность, хотя, казалось бы, только мячи. А потом можно хвастаться: смотрите, что умею!»<cite>Катя, вожатая – забегала на жонглирование в перерывах. Её интервью есть в третьем уроке</cite></blockquote>
        <div class="zh-facts">
          <p><b>3 мяча</b>дарили в лагере тем, кто продержался 30 секунд – чтобы дома оставалось напоминание: «я не умел, продолжал – и у меня получилось».</p>
          <p><b>15 минут – 5 дней</b>столько в лагере уходило на первый шаг, а кому-то и больше. У каждого свой темп, критерий один для всех.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ЧТО ОСТАНЕТСЯ -->
  <section class="gp-section gp-cream">
    <div class="gp-inner">
      <p class="gp-label">Больше, чем три мяча</p>
      <h2>Что останется с вами <em>после курса</em></h2>
      <div class="gp-cards3">
        <div class="gp-card"><h3>Опыт «я могу больше»</h3><p>Вы берётесь за то, что казалось «для циркачей», идёте по шагам – и получается. Этот опыт переносится на музыку, спорт, работу – куда угодно.</p></div>
        <div class="gp-card"><h3>Перезагрузка за 5 минут</h3><p>Взяли мячи – и мысли отпустили. Внимание на броске, тело включилось. А если добавить внимание к дыханию, получается настоящая медитация.</p></div>
        <div class="gp-card"><h3>Навык, который впечатляет</h3><p>«Ого, ты умеешь жонглировать!» – и, возможно, вы вдохновите кого-то пройти этот путь. А научить его сможете уже сами.</p></div>
      </div>
    </div>
  </section>

  <!-- МЯЧИ -->
  <section class="gp-section">
    <div class="gp-inner">
      <p class="gp-label">Что понадобится</p>
      <h2>Мячи: <em>начните с того, что есть</em></h2>
      <p class="gp-desc">Покупать что-то заранее и ждать доставку не нужно – начать можно уже сегодня.</p>
      <ol class="gp-how zh-balls">
        <li><b>Возьмите мяч, который есть дома.</b> Подойдёт теннисный или любой другой примерно такого размера, чтобы удобно лежал в ладони. Если мяча нет – найдите что-то похожее. Только, пожалуйста, не еду :)</li>
        <li><b>Сразу закажите мячи для жонглирования</b> на маркетплейсе – они так и называются. Внутри у них мелкий песок: мяч не отскакивает и лучше слушается руки. Берите набор из трёх одинаковых.</li>
        <li><b>Первое время вы всё равно работаете с одним мячом.</b> Пока едут хорошие мячи, вы отработаете точный бросок. А когда они приедут – закрепите опыт и пойдёте дальше.</li>
      </ol>
      <p class="zh-tip"><b>Лайфхак для первых недель:</b> практикуйтесь, стоя перед кроватью или диваном. Мячи будут падать – это часть пути, – и поднимать их с кровати гораздо проще, чем с пола.</p>
    </div>
  </section>

  {!enrolled && (
    <section class="gp-section gp-cream" id="tariffs">
      <div class="gp-inner">
        <p class="gp-label gp-center">Тарифы</p>
        <h2 class="gp-center">Выберите, <em>как пройти курс</em></h2>
        <p class="gp-desc gp-center">Без регистрации: имя, почта – и оплата. Уроки откроются сразу, можно начать сегодня.</p>
        <div class="zs-tariffs">
          <div class="zs-tariff">
            <h3>Самостоятельный</h3>
            <p class="zs-price">{self.price !== self.base_price && <s>{fmtRub(self.base_price)} ₽</s>}{fmtRub(self.price)} ₽</p>
            {self.promo_until && <p class="zs-promo">Стартовая цена до {promoLastDay} · осталось <b data-countdown>…</b></p>}
            <ul class="zs-list">
              <li>8 видеоуроков</li>
              <li>6 шагов с понятным критерием перехода</li>
              <li>Разбор частых ошибок в каждом уроке</li>
              <li>Доступ в личном кабинете на 1 год</li>
            </ul>
            <a href="#" class="btn-main btn-full" data-tariff="self" data-label="Самостоятельный" data-price={`${fmtRub(self.price)} ₽`}>Купить за {fmtRub(self.price)} ₽</a>
          </div>
          <div class="zs-tariff zs-tariff-main">
            <p class="zs-rec">Быстрее к результату</p>
            <h3>С разбором</h3>
            <p class="zs-price">{support.price !== support.base_price && <s>{fmtRub(support.base_price)} ₽</s>}{fmtRub(support.price)} ₽</p>
            {support.promo_until && <p class="zs-promo">Стартовая цена до {promoLastDay} · осталось <b data-countdown>…</b></p>}
            <ul class="zs-list">
              <li>Всё из тарифа «Самостоятельный»</li>
              <li>30 дней на связи в Телеграме или Max: присылайте видео и вопросы – разберу столько, сколько нужно</li>
              <li>Отвечаю текстом, голосом или коротким видео с показом</li>
              <li>Личная онлайн-консультация 30 минут: посмотрю ваши броски вживую</li>
            </ul>
            <a href="#" class="btn-main btn-full" data-tariff="support" data-label="С разбором" data-price={`${fmtRub(support.price)} ₽`}>Купить за {fmtRub(support.price)} ₽</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {!enrolled && (
    <section class="gp-section">
      <div class="gp-inner gp-faq">
        <p class="gp-label gp-center">Вопросы</p>
        <h2 class="gp-center">Частые <em>вопросы</em></h2>
        <div class="zs-guarantee">
          <h3>Гарантия 7 дней</h3>
          <p>Если курс по любой причине не подойдёт в первые 7 дней – верну деньги без вопросов. Напишите мне в Телеграм @larin_lesha – оформлю возврат.</p>
        </div>
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </section>
  )}

  {!enrolled && (
    <section class="gp-section gp-cream">
      <div class="gp-inner gp-form-wrap">
        <p class="gp-label gp-center">Первый шаг</p>
        <h2 class="gp-center">Пусть этот курс будет <em>не только про жонглирование</em></h2>
        <p class="gp-desc gp-center">А про то, что новому можно учиться в любом возрасте. Возьмите мяч – и сделайте первый бросок уже сегодня.</p>
        <a href="#tariffs" class="btn-main btn-full">Выбрать тариф</a>
        <a href={TG} class="gp-max" target="_blank" rel="noopener" data-goal="messenger_click">Задать вопрос в Телеграме</a>
        <a href={MAX} class="gp-max" target="_blank" rel="noopener" data-goal="messenger_click">Нет Телеграма – написать в Max</a>
      </div>
    </section>
  )}

  <CourseBuy slug="zhonglirovanie" promoUntil={promoUntil} />

  <style>
    .zh-draft { position: fixed; left: 0; right: 0; bottom: 0; z-index: 200; background: #fff3cd; color: #6b4e00; border-top: 1px solid #f0d98a; padding: 10px 20px; font-size: 15px; text-align: center; }
    .zh-who { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .zh-intro { display: grid; grid-template-columns: 1fr 1.3fr; gap: 56px; align-items: center; }
    .zh-video { border-radius: 20px; overflow: hidden; background: #000; aspect-ratio: 16 / 9; }
    .zh-video video { width: 100%; height: 100%; display: block; }
    .zh-program { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .zh-free { margin-left: 10px; font-size: 14px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #2e9e63; vertical-align: middle; }
    .zh-camp { display: grid; grid-template-columns: .8fr 1.2fr; gap: 56px; align-items: center; }
    .zh-reel-main { border-radius: 20px; overflow: hidden; background: #000; aspect-ratio: 9 / 16; max-width: 340px; }
    .zh-reel-main video { width: 100%; height: 100%; display: block; object-fit: cover; }
    .zh-thumbs { display: flex; gap: 10px; margin-top: 12px; }
    .zh-thumb { padding: 0; border: 2px solid transparent; border-radius: 10px; overflow: hidden; cursor: pointer; background: none; width: 64px; transition: border-color .2s, transform .2s; }
    .zh-thumb img { width: 100%; height: auto; display: block; }
    .zh-thumb.is-active { border-color: var(--orange); }
    @media (hover: hover) { .zh-thumb:hover { transform: translateY(-2px); } }
    .zh-thumb:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
    .zh-quote { margin: 8px 0 24px; padding: 22px 26px; border-left: 3px solid var(--orange); background: var(--cream, #f8f5ef); border-radius: 0 16px 16px 0; font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 24px; line-height: 1.45; color: var(--navy); }
    .zh-quote cite { display: block; margin-top: 12px; font-family: 'Manrope', sans-serif; font-style: normal; font-size: 15px; color: var(--text-light, #6e6e6e); }
    .zh-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .zh-facts p { margin: 0; font-size: 17px; line-height: 1.6; color: var(--text-mid, #3a3a3a); }
    .zh-facts b { display: block; font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 30px; color: var(--navy); }
    .zh-balls { max-width: 780px; }
    .zh-tip { max-width: 780px; background: var(--cream, #f8f5ef); border: 1px solid var(--border, #ece8e0); border-radius: 16px; padding: 18px 22px; font-size: 17px; line-height: 1.65; color: var(--text-mid, #3a3a3a); margin: 0; }
    .zh-tip b { color: var(--navy); }
    .zs-tariffs { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 920px; margin: 36px auto 0; }
    .zs-tariff { display: flex; flex-direction: column; background: white; border: 1px solid var(--border, #ece8e0); border-radius: 22px; padding: 32px 30px 30px; }
    .zs-tariff-main { background: var(--navy); color: white; border-color: var(--navy); }
    .zs-tariff h3 { font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 32px; color: var(--navy); margin: 0 0 4px; }
    .zs-tariff-main h3 { color: white; }
    .zs-rec { font-size: 15px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #ffb48a; margin: 0 0 6px; }
    .zs-price { font-family: 'Cormorant Garamond', serif; font-size: 46px; line-height: 1.1; color: var(--navy); margin: 0 0 6px; }
    .zs-tariff-main .zs-price { color: white; }
    .zs-price s { font-family: 'Manrope', sans-serif; font-size: 20px; opacity: .55; margin-right: 12px; vertical-align: middle; }
    .zs-promo { display: inline-block; align-self: flex-start; margin: 0 0 10px; padding: 6px 12px; border-radius: 100px; background: rgba(232,101,42,.14); color: var(--orange); font-size: 15px; font-weight: 600; }
    .zs-promo b { font-variant-numeric: tabular-nums; }
    .zs-list { list-style: none; padding: 0; margin: 14px 0 24px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
    .zs-list li { position: relative; padding-left: 26px; font-size: 17px; line-height: 1.55; color: var(--text-mid, #3a3a3a); }
    .zs-tariff-main .zs-list li { color: rgba(255,255,255,.88); }
    .zs-list li::before { content: '✓'; position: absolute; left: 0; color: #2e9e63; font-weight: 700; }
    .zs-tariff-main .zs-list li::before { color: #7fd4a4; }
    .zs-guarantee { background: var(--cream, #f8f5ef); border: 1.5px solid var(--orange); border-radius: 18px; padding: 24px 26px; margin: 0 0 24px; }
    .zs-guarantee h3 { font-size: 20px; color: var(--navy); margin: 0 0 8px; }
    .zs-guarantee p { font-size: 17px; line-height: 1.7; color: var(--text-mid, #3a3a3a); margin: 0; }
    .gp-form-wrap .gp-max + .gp-max { margin-top: 10px; }
    @media (max-width: 1000px) { .zh-intro, .zh-camp { grid-template-columns: 1fr; gap: 32px; } .zh-reel-main { margin: 0 auto; } .zh-thumbs { justify-content: center; } }
    @media (max-width: 760px) { .zh-who, .zh-program, .zs-tariffs, .zh-facts { grid-template-columns: 1fr; } .zs-tariff { padding: 26px 22px; } }
  </style>
  <script>
    document.querySelectorAll<HTMLElement>('[data-goal]').forEach((a) =>
      a.addEventListener('click', () => (window as any).reachGoal?.(a.dataset.goal)));
    // Ролики из лагеря: миниатюры переключают основной ролик.
    const main = document.querySelector<HTMLVideoElement>('.zh-reel-main video');
    const thumbs = document.querySelectorAll<HTMLButtonElement>('.zh-thumb');
    thumbs.forEach((t) => t.addEventListener('click', () => {
      if (!main) return;
      const n = t.dataset.reel;
      thumbs.forEach((x) => x.classList.toggle('is-active', x === t));
      main.poster = `/img/zhonglirovanie/reel-${n}.jpg`;
      main.src = `/lesson-videos/promo/zh-reel-${n}.mp4`;
      main.play().catch(() => {});
    }));
  </script>
</SiteLayout>
