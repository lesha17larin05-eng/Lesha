---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { extractLegacy } from '../../lib/legacy';
import rawHtml from '../../legacy/zhonglirovanie.html?raw';
import { apiJson } from '../../lib/api';

// Лендинг курса «Жонглирование: у вас получится».
// Покупка в один шаг: кнопка тарифа → окно «имя + почта + согласие» →
// POST /api/courses/zhonglirovanie/quick-checkout → Продамус (без пароля и
// подтверждения почты; залогиненный покупает сразу). Стартовая цена тарифа
// приходит из API (поле tariffs) и подставляется в разметку здесь, на SSR.

const cookie = Astro.request.headers.get('cookie') || '';
const user = (Astro.locals as any).user;
const isAdmin = user?.role === 'admin';

// Если курс снять с публикации в /admin/courses, API отвечает 404 –
// страницу видит только админ (с плашкой «Черновик»).
const { data, status } = await apiJson<any>('/api/courses/zhonglirovanie', { cookie });
if (status !== 200 && !isAdmin) {
  return new Response(null, { status: 404 });
}
const enrolled = status === 200 && !!data?.enrolled;
const isDraft = status !== 200;

const { styles, body: rawBody } = extractLegacy(rawHtml);

// ─── Стартовая цена (акция со сроком) ─────────────────────────────
const fmtRub = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
const tariffs: Record<string, { price: number; base_price: number; promo_until?: string }> = data?.tariffs || {};
const self = tariffs.self;
const promoUntil = self?.promo_until || null;
// Последний день акции по Москве (promo_until – полночь следующего дня).
const promoLastDay = promoUntil
  ? new Date(new Date(promoUntil).getTime() - 1000).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', timeZone: 'Europe/Moscow' })
  : '';
let body = rawBody;
if (self && promoUntil) {
  const base = fmtRub(self.base_price), now = fmtRub(self.price);
  body = body
    .replace(`<div class="tariff-price">${base}<small>₽</small></div>`,
      `<div class="tariff-price"><span class="tp-old">${base} ₽</span>${now}<small>₽</small></div>` +
      `<div class="tp-promo">Стартовая цена до ${promoLastDay} · осталось <b data-countdown>…</b></div>`)
    .replace(`Купить за ${base} ₽`, `Купить за ${now} ₽`)
    .replace('<span class="hero-safety">',
      `<span class="hero-promo">Старт продаж: <b>${now} ₽</b> вместо ${base} ₽ до ${promoLastDay}</span><span class="hero-safety">`);
}

// FAQPage JSON-LD – собирается из FAQ прямо на странице (rich snippet в поиске).
const stripTags = (h: string) => h.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const faqMatches = [...rawHtml.matchAll(/<summary>([\s\S]*?)<\/summary>\s*<div class="faq-content">([\s\S]*?)<\/div><\/details>/g)];
const faqJsonLd = faqMatches.length ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqMatches.map((m) => ({
    '@type': 'Question',
    name: stripTags(m[1]),
    acceptedAnswer: { '@type': 'Answer', text: stripTags(m[2]) },
  })),
}) : '';
---
<SiteLayout
  title="Жонглирование: у вас получится – курс Алексея Ларина"
  description="Онлайн-курс жонглирования для новичков: научитесь жонглировать тремя мячами с нуля. 8 видеоуроков, 6 шагов и понятный критерий перехода в каждом упражнении."
  active="courses"
  pageStyles={styles}
  ogImage="/img/IMG_4035.jpg"
  noindex={isDraft}
>
  {isDraft && <div class="tm-draft-bar">Черновик: курс не опубликован – страницу видите только вы (админ). Опубликовать – в /admin/courses.</div>}
  {faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}
  <Fragment set:html={body} />
  <script define:vars={{ enrolled, isLoggedIn: !!user, promoUntil }}>
    if (enrolled) {
      const eyebrow = document.querySelector('.eyebrow-text');
      if (eyebrow) eyebrow.textContent = 'Доступ открыт · 8 видеоуроков · онлайн';

      const promise = document.querySelector('.hero-promise p');
      if (promise) promise.innerHTML = '<strong>Все уроки открыты</strong> – берите мячи и практикуйте. Это единственный путь.';

      const btn = document.querySelector('.btn-hero');
      if (btn) {
        btn.textContent = 'Перейти к урокам →';
        btn.setAttribute('href', '/cabinet/zhonglirovanie');
      }

      ['.hero-safety', '.hero-promo'].forEach(sel => {
        const el = document.querySelector(sel);
        if (el) el.style.display = 'none';
      });
      ['#tariffs', '.final-cta', '.guarantee-faq'].forEach(sel => {
        const el = document.querySelector(sel);
        if (el) el.style.display = 'none';
      });
    }

    // ─── Отсчёт до конца стартовой цены ───────────────────────────
    if (promoUntil) {
      const end = new Date(promoUntil).getTime();
      const els = document.querySelectorAll('[data-countdown]');
      const pad = (n) => String(n).padStart(2, '0');
      const tick = () => {
        const left = Math.max(0, end - Date.now());
        if (left === 0) { location.reload(); return; }
        const d = Math.floor(left / 86400000);
        const h = Math.floor(left / 3600000) % 24;
        const m = Math.floor(left / 60000) % 60;
        const s = Math.floor(left / 1000) % 60;
        const text = (d > 0 ? d + ' дн ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
        els.forEach((el) => { el.textContent = text; });
      };
      tick();
      setInterval(tick, 1000);
    }

    // ─── Покупка в один шаг ───────────────────────────────────────
    // Залогиненный – сразу на оплату. Остальным – окно «имя + почта».
    const ERRORS = {
      bad_email: 'Проверьте адрес почты.',
      name_required: 'Укажите имя.',
      consent_pd_required: 'Чтобы продолжить, отметьте согласие.',
      bad_tariff: 'Неизвестный тариф. Обновите страницу.',
    };

    async function quickCheckout(payload) {
      const r = await fetch('/api/courses/zhonglirovanie/quick-checkout', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(payload),
      });
      const j = await r.json().catch(() => ({}));
      return { ok: r.ok && !!j.payment_url, status: r.status, data: j };
    }

    function goPay(url) {
      window.reachGoal?.('checkout_start');
      window.location.href = url;
    }

    function openBuyModal(tariff, label, priceText) {
      document.getElementById('zs-auth-modal')?.remove();
      const wrap = document.createElement('div');
      wrap.id = 'zs-auth-modal';
      wrap.innerHTML = `
        <div class="zs-modal-back" data-close></div>
        <div class="zs-modal-card" role="dialog" aria-modal="true" aria-labelledby="zs-modal-title">
          <button class="zs-modal-close" data-close aria-label="Закрыть">×</button>
          <h3 id="zs-modal-title">${label}</h3>
          <p class="zs-modal-switch">${priceText}. Доступ к урокам откроется сразу после оплаты, ссылка для входа придёт на почту.</p>
          <form class="zs-form" novalidate>
            <label><span class="zs-lbl">Имя <i class="zs-req">*</i></span><input name="name" required autocomplete="name" /></label>
            <label><span class="zs-lbl">Почта <i class="zs-req">*</i></span><input name="email" type="email" required autocomplete="email" inputmode="email" /></label>
            <label class="zs-check">
              <input type="checkbox" name="consent_pd" required />
              <span>Даю <a href="/legal/consent" target="_blank">согласие на обработку персональных данных</a> и принимаю <a href="/legal/offer" target="_blank">оферту</a>.</span>
            </label>
            <button class="zs-submit" type="submit">Перейти к оплате</button>
            <div class="zs-msg" hidden></div>
          </form>
        </div>`;
      document.body.appendChild(wrap);
      document.body.style.overflow = 'hidden';
      const close = () => { wrap.remove(); document.body.style.overflow = ''; };
      wrap.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
      document.addEventListener('keydown', function onEsc(e) {
        if (e.key === 'Escape') { close(); document.removeEventListener('keydown', onEsc); }
      });
      const form = wrap.querySelector('form');
      const msg = wrap.querySelector('.zs-msg');
      const btn = wrap.querySelector('.zs-submit');
      const say = (html, ok) => { msg.innerHTML = html; msg.className = 'zs-msg ' + (ok ? 'is-ok' : 'is-err'); msg.hidden = false; };
      setTimeout(() => wrap.querySelector('input[name="name"]')?.focus(), 50);
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const name = String(fd.get('name') || '').trim();
        const email = String(fd.get('email') || '').trim();
        if (!name) return say(ERRORS.name_required);
        if (!email.includes('@') || !email.includes('.')) return say(ERRORS.bad_email);
        if (!fd.get('consent_pd')) return say(ERRORS.consent_pd_required);
        btn.disabled = true; btn.textContent = 'Открываю оплату…';
        try {
          const res = await quickCheckout({ tariff, name, email, consent_pd: true });
          if (res.ok) return goPay(res.data.payment_url);
          if (res.data.error === 'already_enrolled') {
            say('У этого адреса уже есть доступ к курсу. <a href="/auth/login?next=/cabinet/zhonglirovanie">Войдите</a>, чтобы перейти к урокам.');
          } else {
            say(ERRORS[res.data.error] || 'Не получилось открыть оплату. Напишите мне в Телеграм @larin_lesha – разберёмся.');
          }
        } catch {
          say('Ошибка соединения. Попробуйте ещё раз.');
        }
        btn.disabled = false; btn.textContent = 'Перейти к оплате';
      });
    }

    document.querySelectorAll('[data-tariff]').forEach((el) => {
      el.addEventListener('click', async (e) => {
        e.preventDefault();
        const tariff = el.getAttribute('data-tariff');
        const card = el.closest('.tariff-card');
        const label = card?.querySelector('.tariff-name')?.textContent?.trim() || 'Курс';
        const priceText = (el.textContent || '').replace('Купить за', 'Стоимость').trim();
        if (!isLoggedIn) { openBuyModal(tariff, 'Тариф «' + label.charAt(0) + label.slice(1).toLowerCase() + '»', priceText); return; }
        const orig = el.textContent;
        el.style.pointerEvents = 'none';
        el.textContent = 'Открываю оплату…';
        try {
          const res = await quickCheckout({ tariff });
          if (res.ok) return goPay(res.data.payment_url);
          if (res.data.error === 'already_enrolled') { window.location.href = '/cabinet/zhonglirovanie'; return; }
          alert('Не получилось открыть оплату. Напишите мне в Телеграм @larin_lesha – разберёмся.');
        } catch {
          alert('Ошибка соединения. Попробуйте ещё раз.');
        }
        el.style.pointerEvents = '';
        el.textContent = orig;
      });
    });
  </script>
  <style is:global>
    .tp-old { font-family: 'Manrope', sans-serif; font-size: 22px; color: rgba(255,255,255,0.55); text-decoration: line-through; margin-right: 12px; vertical-align: middle; }
    .tp-promo { display: inline-block; margin: 4px 0 18px; padding: 6px 12px; border-radius: 100px; background: rgba(232,101,42,0.18); color: #ffb48a; font-size: 14px; font-weight: 600; }
    .tp-promo b { color: #fff; font-variant-numeric: tabular-nums; }
    .hero-promo { display: inline-block; font-size: 16px; color: #ffb48a; }
    .hero-promo b { color: #fff; }
    .tm-draft-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 200; background: #fff3cd; color: #6b4e00; border-top: 1px solid #f0d98a; padding: 10px 20px; font-size: 14px; text-align: center; }
    #zs-auth-modal {
      position: fixed; inset: 0; z-index: 1000;
      display: flex; align-items: center; justify-content: center;
      padding: 20px;
      animation: zs-modal-fade .18s ease-out;
    }
    @keyframes zs-modal-fade { from { opacity: 0; } to { opacity: 1; } }
    .zs-modal-back {
      position: absolute; inset: 0;
      background: rgba(15, 21, 32, 0.55);
      backdrop-filter: blur(4px);
      cursor: pointer;
    }
    .zs-modal-card {
      position: relative;
      background: var(--warm-white, #fdfaf5);
      border-radius: 20px;
      padding: 36px 32px 28px;
      max-width: 460px; width: 100%;
      max-height: calc(100vh - 40px);
      overflow-y: auto;
      box-shadow: 0 24px 64px rgba(15, 21, 32, 0.25);
      animation: zs-modal-pop .22s cubic-bezier(.2,.9,.3,1.2);
    }
    @keyframes zs-modal-pop { from { transform: translateY(12px) scale(.97); opacity: 0; } to { transform: translateY(0) scale(1); opacity: 1; } }
    .zs-modal-close {
      position: absolute; top: 14px; right: 14px;
      width: 32px; height: 32px; border: none; border-radius: 50%;
      background: transparent; color: var(--text-muted, #777);
      font-size: 23px; line-height: 1; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background .15s, color .15s;
    }
    .zs-modal-close:hover { background: rgba(0,0,0,0.06); color: var(--text, #1a1a1a); }
    .zs-modal-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 28px; font-weight: 500;
      color: var(--navy, #1a2744);
      margin: 0 0 6px;
      letter-spacing: -0.01em;
    }
    .zs-modal-switch {
      font-size: 15px;
      color: var(--text-mid, #444);
      margin: 0 0 18px;
    }
    .zs-modal-switch a {
      color: var(--orange, #e8652a);
      text-decoration: none;
      font-weight: 600;
      border-bottom: 1px solid transparent;
      transition: border-color .2s;
    }
    @media (hover: hover) {
      .zs-modal-switch a:hover { border-bottom-color: var(--orange, #e8652a); }
    }
    .zs-form {
      display: flex; flex-direction: column; gap: 12px;
    }
    .zs-form label {
      display: flex; flex-direction: column; gap: 6px;
      font-size: 14px; color: var(--text-mid, #444);
      font-weight: 500;
    }
    .zs-lbl { display: inline-flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
    .zs-req {
      display: inline-block; color: var(--orange, #e8652a);
      font-style: normal; font-weight: 700; font-size: 14px; line-height: 1;
    }
    .zs-opt {
      display: inline-block; color: var(--text-muted, #777);
      font-style: normal; font-weight: 400; font-size: 13px; line-height: 1;
    }
    .zs-form input[type="email"],
    .zs-form input[type="password"],
    .zs-form input[type="tel"],
    .zs-form input[type="text"],
    .zs-form input:not([type]) {
      padding: 12px 14px;
      border: 1.5px solid var(--border, #ece8e0);
      border-radius: 10px;
      font-size: 16px;
      font-family: inherit;
      background: white;
      color: var(--text, #1a1a1a);
      transition: border-color .15s, box-shadow .15s;
      width: 100%;
    }
    .zs-form input:focus {
      outline: none;
      border-color: var(--orange, #e8652a);
      box-shadow: 0 0 0 3px rgba(232,101,42,0.12);
    }
    .zs-check {
      flex-direction: row !important;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px; line-height: 1.5;
      cursor: pointer;
      font-weight: 400 !important;
      margin-top: 4px;
    }
    .zs-check input[type="checkbox"] {
      margin-top: 2px;
      flex-shrink: 0;
      accent-color: var(--orange, #e8652a);
      width: 16px; height: 16px;
      cursor: pointer;
    }
    .zs-check a {
      color: var(--orange, #e8652a);
      text-decoration: underline;
    }
    .zs-submit {
      margin-top: 8px;
      padding: 14px 22px;
      border-radius: 100px;
      border: none;
      background: var(--orange, #e8652a);
      color: white;
      font-size: 16px; font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(232, 101, 42, 0.32);
      transition: background .2s, transform .15s, box-shadow .2s;
    }
    @media (hover: hover) {
      .zs-submit:hover:not(:disabled) {
        background: var(--orange-warm, #f07530);
        transform: translateY(-1px);
        box-shadow: 0 10px 24px rgba(232,101,42,0.38);
      }
    }
    .zs-submit:disabled { opacity: 0.7; cursor: progress; }
    .zs-forgot { font-size: 14px; text-align: center; margin: 0; }
    .zs-forgot a { color: var(--text-muted, #777); text-decoration: none; border-bottom: 1px dashed currentColor; }
    .zs-forgot a:hover { color: var(--navy, #1a2744); }
    .zs-msg {
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 15px; line-height: 1.45;
    }
    .zs-msg.is-err { background: rgba(220, 38, 38, 0.08); color: #b91c1c; border: 1px solid rgba(220,38,38,0.18); }
    .zs-msg.is-ok  { background: rgba(34, 139, 84, 0.08); color: #1b6e3e; border: 1px solid rgba(34,139,84,0.18); }
    @media (max-width: 480px) {
      .zs-modal-card { padding: 28px 22px 22px; border-radius: 16px; }
      .zs-modal-card h3 { font-size: 24px; }
      .zs-form input { font-size: 17px; /* iOS не зумит при 16px+ */ }
    }
  </style>
</SiteLayout>
