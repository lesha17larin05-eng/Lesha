---
import SiteLayout from '../layouts/SiteLayout.astro';
import { extractLegacy } from '../lib/legacy';
import rawHtml from '../legacy/course.html?raw';
const { styles, body } = extractLegacy(rawHtml);
---
<SiteLayout title="Бесплатный курс — Алексей Ларин" active="course" pageStyles={styles}>
  <Fragment set:html={body} />
  <script>
    (async () => {
      const form = document.getElementById('quick-signup-form') as HTMLFormElement | null;
      if (!form) return;
      const note = document.getElementById('quick-signup-note') as HTMLElement | null;
      const btn = document.getElementById('quick-signup-submit') as HTMLButtonElement | null;

      // Если уже залогинен и есть бесплатный курс — заменяем форму на CTA «Перейти к курсу».
      const authed = /(?:^|;\s*)auth=1/.test(document.cookie);
      if (authed) {
        try {
          const res = await fetch('/api/me/courses', { credentials: 'include' });
          if (res.ok) {
            const courses = await res.json();
            const free = Array.isArray(courses)
              ? courses.find((c: any) => c && (c.kind === 'free' || c.price_rub == null || c.price_rub === 0))
              : null;
            const target = free || (Array.isArray(courses) && courses[0]);
            if (target) {
              form.innerHTML =
                '<div style="text-align:center;">' +
                '<p style="margin:0 0 18px; color:rgba(255,255,255,0.7); font-size:15px;">У вас уже есть доступ к курсу</p>' +
                '<a href="/courses/' + target.slug + '" class="btn-cta-full" style="text-decoration:none; display:inline-block;">Перейти к курсу →</a>' +
                '<p class="form-note" style="margin-top:14px;"><a href="/cabinet" style="color:inherit; text-decoration:underline;">Открыть личный кабинет</a></p>' +
                '</div>';
              return;
            }
          }
        } catch {}
      }
      const setNote = (msg: string, color = 'rgba(255,255,255,0.55)') => {
        if (note) { note.textContent = msg; note.style.color = color; }
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const email = String(fd.get('email') || '').trim().toLowerCase();
        const name = String(fd.get('name') || '').trim();
        if (!email || !email.includes('@')) {
          setNote('Введите корректный email', '#ff8a8a');
          return;
        }
        if (btn) { btn.disabled = true; btn.textContent = 'Отправляем...'; }
        try {
          const res = await fetch('/api/auth/quick-signup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ email, name }),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.created) {
            setNote('Аккаунт создан, пароль отправлен на почту. Переходим в кабинет...');
            window.location.href = '/cabinet';
            return;
          }
          if (res.ok && data.exists) {
            setNote('Такой email уже есть — войдите в кабинет');
            window.location.href = '/auth/login?email=' + encodeURIComponent(email);
            return;
          }
          setNote('Не получилось: ' + (data.error || res.status), '#ff8a8a');
        } catch (err) {
          setNote('Ошибка сети, попробуйте ещё раз', '#ff8a8a');
        } finally {
          if (btn) { btn.disabled = false; btn.textContent = 'Получить доступ →'; }
        }
      });
    })();
  </script>
</SiteLayout>
