---
import SiteLayout from '../layouts/SiteLayout.astro';
import { extractLegacy } from '../lib/legacy';
import rawHtml from '../legacy/course.html?raw';
const { styles, body } = extractLegacy(rawHtml);
const user = (Astro.locals as any).user;

const authedStyles = user ? `
  .free-badge { display: none !important; }
  .hero-right { justify-content: flex-start !important; padding-top: 80px !important; }
` : '';
---
<SiteLayout title="Бесплатный курс — Алексей Ларин" active="course" pageStyles={styles + authedStyles}>
  <Fragment set:html={body} />
  <script define:vars={{ isAuthed: !!user }}>
    (() => {
      // Обновляем ссылку «Войти» → «Личный кабинет» для авторизованных
      const navLink = document.getElementById('nav-login-link');
      if (navLink && isAuthed) {
        navLink.textContent = 'Личный кабинет';
        navLink.setAttribute('href', '/cabinet');
      }

      const form = document.getElementById('quick-signup-form');
      const accessBlock = document.getElementById('access-block');

      if (isAuthed) {
        // Скрываем форму и текст над ней, оставляем блок с оранжевой кнопкой
        if (form) form.style.display = 'none';
        if (accessBlock) accessBlock.style.display = 'block';
        const ctaInner = document.querySelector('#get-access .cta-inner');
        if (ctaInner) {
          ctaInner.querySelector('.section-label')?.style.setProperty('display', 'none');
          ctaInner.querySelector('.section-title')?.style.setProperty('display', 'none');
          ctaInner.querySelector('.section-desc')?.style.setProperty('display', 'none');
        }

        // Обновляем левый герой-блок
        const promise = document.querySelector('.hero-promise p');
        if (promise) promise.innerHTML = 'У вас уже есть доступ к курсу. <strong>Все 8 уроков открыты</strong> — переходите в личный кабинет и начинайте в любом порядке.';

        const ctaBtn = document.querySelector('.btn-hero');
        if (ctaBtn) {
          ctaBtn.textContent = 'Перейти к урокам →';
          ctaBtn.setAttribute('href', '/cabinet/myagkiy-start');
        }

        const safety = document.querySelector('.hero-safety');
        if (safety) safety.style.display = 'none';

        const eyebrow = document.querySelector('.eyebrow-text');
        if (eyebrow) eyebrow.textContent = 'Доступ открыт · 8 уроков · онлайн';

        return;
      }

      // Не авторизован — стандартная логика формы регистрации
      if (!form) return;
      const note = document.getElementById('quick-signup-note');
      const btn = document.getElementById('quick-signup-submit');

      const setNote = (msg, color = 'rgba(255,255,255,0.55)') => {
        if (note) { note.textContent = msg; note.style.color = color; }
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const email = String(fd.get('email') || '').trim().toLowerCase();
        const name = String(fd.get('name') || '').trim();
        const phone = String(fd.get('phone') || '').trim();
        const consentPd = !!fd.get('consent_pd');
        const consentMarketing = !!fd.get('consent_marketing');
        if (!name) {
          setNote('Введите имя', '#ff8a8a');
          return;
        }
        if (!email || !email.includes('@')) {
          setNote('Введите корректный email', '#ff8a8a');
          return;
        }
        if (!consentPd) {
          setNote('Чтобы продолжить, нужно согласиться с обработкой персональных данных', '#ff8a8a');
          return;
        }
        if (btn) { btn.disabled = true; btn.textContent = 'Отправляем...'; }
        try {
          const res = await fetch('/api/auth/quick-signup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ email, name, phone, consent_pd: true, consent_marketing: consentMarketing }),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.created) {
            // Письмо с ссылкой подтверждения и паролем уже улетело.
            // Перебрасываем на страницу-инструкцию.
            window.location.href = '/auth/check-email?email=' + encodeURIComponent(email);
            return;
          }
          if (res.ok && data.exists) {
            setNote('Такой email уже есть — войдите в кабинет');
            window.location.href = '/auth/login?email=' + encodeURIComponent(email) + '&next=/cabinet/myagkiy-start';
            return;
          }
          setNote('Не получилось: ' + (data.error || res.status), '#ff8a8a');
        } catch {
          setNote('Ошибка сети, попробуйте ещё раз', '#ff8a8a');
        } finally {
          if (btn) { btn.disabled = false; btn.textContent = 'Получить доступ →'; }
        }
      });
    })();
  </script>
</SiteLayout>
