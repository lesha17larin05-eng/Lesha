/* Стена детских отзывов */
.kids-reviews { margin-bottom: 60px; }
.kids-reviews-title { font-family: 'Cormorant Garamond', serif; font-size: 30px; font-weight: 400; color: var(--navy); margin-bottom: 28px; font-style: italic; }
