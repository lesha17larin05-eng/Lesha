.kid-quote { background: white; border-radius: 14px; padding: 24px 26px 22px; border: 1px solid var(--border); font-size: 17px; color: var(--text-mid); line-height: 1.55; position: relative; transition: all 0.2s; }
.kid-quote:hover { border-color: var(--orange); transform: translateY(-2px); }
.kid-quote::before { content: '"'; font-family: 'Cormorant Garamond', serif; font-size: 44px; color: var(--orange); position: absolute; top: 2px; left: 18px; line-height: 1; opacity: 0.35; }
.kid-quote-text { padding-left: 18px; padding-top: 10px; }
.kid-quote-author { padding-left: 18px; margin-top: 14px; font-size: 13px; font-weight: 600; color: var(--orange); letter-spacing: 0.03em; }
.kid-quote--featured { background: var(--navy); color: white; grid-column: span 3; padding: 30px 36px; }
.kid-quote--featured::before { color: var(--gold); opacity: 0.5; font-size: 56px; }
.kid-quote--featured .kid-quote-text { font-family: 'Cormorant Garamond', serif; font-size: 30px; line-height: 1.4; font-style: italic; color: white; padding-top: 14px; }
.kid-quote--featured .kid-quote-author { color: var(--gold); font-style: normal; }

/* Отзывы родителей */
.parent-reviews { margin-bottom: 24px; }
.parent-reviews-title { font-family: 'Cormorant Garamond', serif; font-size: 30px; font-weight: 400; color: var(--navy); margin-bottom: 28px; font-style: italic; }
.parent-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
.parent-card { background: white; border-radius: 18px; padding: 28px 32px; border: 1px solid var(--border); display: flex; flex-direction: column; }
.parent-stars { color: var(--orange); font-size: 14px; margin-bottom: 14px; letter-spacing: 2px; }
.parent-text { font-size: 16px; color: var(--text); line-height: 1.75; margin-bottom: 18px; flex-grow: 1; }
.parent-text em { font-style: italic; color: var(--navy); font-weight: 500; }
.parent-meta { display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px solid var(--border); }
.parent-av { width: 36px; height: 36px; border-radius: 50%; background: var(--navy); color: white; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; flex-shrink: 0; }
.parent-name { font-size: 15px; font-weight: 600; color: var(--navy); }
.parent-role { font-size: 13px; color: var(--text-light); }

/* Скрины переписок — лента после parent reviews, без отдельных заголовков */
.screens-section { margin-top: 24px; }
.screens-strip { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 16px; scrollbar-width: thin; }
.screens-strip::-webkit-scrollbar { height: 8px; }
.screens-strip::-webkit-scrollbar-track { background: var(--border); border-radius: 4px; }
.screens-strip::-webkit-scrollbar-thumb { background: var(--text-light); border-radius: 4px; }
.screen-card { flex: 0 0 auto; width: 280px; background: white; border-radius: 16px; padding: 14px; border: 1px solid var(--border); }
.screen-card img { width: 100%; max-height: 260px; object-fit: contain; object-position: top; border-radius: 8px; display: block; }
.screen-card-meta { font-size: 13px; color: var(--text-light); margin-top: 10px; text-align: center; letter-spacing: 0.03em; }

/* GUARANTEE + FAQ */
.guarantee-faq { padding: 100px 80px; background: white; }
.guarantee-faq > .section-label,
.guarantee-faq > .section-title,
.guarantee-faq > .section-desc { max-width: 720px; }
.gf-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; align-items: start; margin-top: 8px; }
.guarantee-box { background: var(--cream); border: 1px solid var(--border); border-radius: 20px; padding: 36px 32px; position: sticky; top: 84px; }
.guarantee-icon { width: 56px; height: 56px; border-radius: 14px; background: var(--orange); color: white; display: flex; align-items: center; justify-content: center; margin-bottom: 22px; }
.guarantee-icon svg { width: 28px; height: 28px; }
.guarantee-box h3 { font-family: 'Cormorant Garamond', serif; font-size: 28px; font-weight: 500; color: var(--navy); line-height: 1.2; margin: 0 0 14px; letter-spacing: -0.005em; }
.guarantee-box p { font-size: 16px; color: var(--text-mid); line-height: 1.7; margin-bottom: 12px; }
.guarantee-box p:last-child { margin-bottom: 0; }
.guarantee-box .small { font-size: 14px; color: var(--text-muted); font-style: italic; }
.faq-list { display: flex; flex-direction: column; gap: 12px; }
.faq-item { background: white; border: 1px solid var(--border); border-radius: 14px; overflow: hidden; transition: border-color 0.2s; }
.faq-item:hover { border-color: var(--text-light); }
.faq-item[open] { border-color: var(--orange); background: var(--cream); }
.faq-item summary { padding: 22px 26px; font-size: 17px; font-weight: 600; color: var(--navy); cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 20px; transition: color 0.2s; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after { content: '+'; font-size: 26px; font-weight: 300; color: var(--text-light); flex-shrink: 0; transition: transform 0.3s, color 0.2s; }
.faq-item[open] summary::after { content: '–'; color: var(--orange); }
.faq-item summary:hover { color: var(--orange); }
.faq-content { padding: 0 26px 26px; font-size: 16px; color: var(--text-mid); line-height: 1.8; }
.faq-content p { margin-bottom: 10px; }
.faq-content p:last-child { margin-bottom: 0; }

/* TG CHANNEL STRIP */
.tg-strip { background: var(--cream); padding: 56px 80px; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.tg-strip-wrap { max-width: 820px; margin: 0 auto; display: flex; align-items: center; gap: 32px; flex-wrap: wrap; }
.tg-strip-icon { width: 64px; height: 64px; border-radius: 18px; background: #2aabee; display: flex; align-items: center; justify-content: center; color: white; flex-shrink: 0; box-shadow: 0 8px 24px rgba(42,171,238,0.25); }
.tg-strip-icon svg { width: 32px; height: 32px; }
.tg-strip-content { flex: 1; min-width: 280px; }
.tg-strip-title { font-family: 'Cormorant Garamond', serif; font-size: 26px; font-weight: 500; color: var(--navy); line-height: 1.25; margin-bottom: 6px; }
.tg-strip-text { font-size: 15px; color: var(--text-muted); line-height: 1.6; }
.tg-strip-link { display: inline-flex; align-items: center; gap: 8px; background: #2aabee; color: white; text-decoration: none; padding: 14px 24px; border-radius: 100px; font-size: 15px; font-weight: 600; transition: background 0.2s, transform 0.2s; flex-shrink: 0; }
.tg-strip-link:hover { background: #229ed9; transform: translateY(-1px); }

/* PRICE & CTA */
.cta-section { padding: 100px 80px; background: var(--navy); }
.cta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
.cta-left .section-label { color: #7ab0f0; }
.cta-left .section-title { color: white; }
.cta-left .section-desc { color: rgba(255,255,255,0.85); max-width: none; margin-bottom: 24px; }
.cta-howto { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 20px 24px; }
.cta-howto-title { font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.82); margin-bottom: 14px; }
.cta-howto-list { display: flex; flex-direction: column; gap: 10px; }
.cta-howto-item { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; color: rgba(255,255,255,0.75); line-height: 1.5; }
.cta-howto-num { width: 22px; height: 22px; border-radius: 50%; background: var(--orange); color: white; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0; margin-top: 1px; }

.price-box { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 24px; padding: 40px; }
.price-main { font-family: 'Cormorant Garamond', serif; font-size: 56px; font-weight: 400; color: white; line-height: 1; margin-bottom: 4px; }
.price-per { font-size: 15px; color: rgba(255,255,255,0.82); margin-bottom: 28px; }
.price-features { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }
.price-feature { display: flex; align-items: flex-start; gap: 10px; font-size: 15px; color: rgba(255,255,255,0.72); line-height: 1.5; }
.pf-check { color: var(--green); font-weight: 700; flex-shrink: 0; }
.pf-highlight { color: var(--gold); font-weight: 600; }
.price-discount { background: rgba(244,195,97,0.1); border: 1px solid rgba(244,195,97,0.2); border-radius: 12px; padding: 14px 18px; font-size: 14px; color: rgba(255,255,255,0.9); line-height: 1.6; margin-bottom: 24px; }
.price-discount strong { color: var(--gold); }
.btn-cta { display: flex; align-items: center; justify-content: center; gap: 10px; background: var(--orange); color: white; text-decoration: none; padding: 17px 32px; border-radius: 100px; width: 100%; font-size: 15px; font-weight: 600; transition: all 0.25s; box-shadow: 0 8px 28px rgba(232,101,42,0.3); margin-bottom: 10px; }
.btn-cta:hover { background: var(--orange-warm); transform: translateY(-2px); }
.btn-cta-alt { display: flex; align-items: center; justify-content: center; gap: 8px; color: rgba(255,255,255,0.9); text-decoration: none; padding: 12px; font-size: 14px; transition: color 0.2s; border-bottom: 1px dashed rgba(255,255,255,0.18); }
.btn-cta-alt:hover { color: white; }
.cta-reply { text-align: center; margin-top: 14px; font-size: 13px; color: rgba(255,255,255,0.7); }

/* FOOTER */
footer { background: #0f1520; padding: 36px 80px; display: flex; align-items: center; justify-content: space-between; }
.footer-logo { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: white; text-decoration: none; }
.footer-links { display: flex; gap: 24px; }
.footer-links a { font-size: 14px; color: rgba(255,255,255,0.82); text-decoration: none; transition: color 0.2s; }
.footer-links a:hover { color: white; }
.footer-copy { font-size: 13px; color: rgba(255,255,255,0.6); }

/* VIDEO PLAY OVERLAY */
.video-wrap { position: relative; }
.video-play-btn {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 84px; height: 84px; border-radius: 50%;
  background: rgba(255,255,255,0.95);
  border: none; cursor: pointer; padding: 0;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8px 32px rgba(0,0,0,0.35);
  transition: transform 0.2s, opacity 0.2s, background 0.2s;
  z-index: 3;
}
.video-play-btn::before {
  content: '';
  width: 0; height: 0;
  border-left: 24px solid var(--navy);
  border-top: 16px solid transparent;
  border-bottom: 16px solid transparent;
  margin-left: 6px;
}
.video-play-btn:hover { background: white; transform: translate(-50%, -50%) scale(1.06); }
.video-wrap.is-playing .video-play-btn { opacity: 0; pointer-events: none; transform: translate(-50%, -50%) scale(0.85); }
@media (max-width: 700px) { .video-play-btn { width: 64px; height: 64px; } .video-play-btn::before { border-left-width: 18px; border-top-width: 12px; border-bottom-width: 12px; margin-left: 4px; } }

/* LIGHTBOX */
.lightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.92); z-index: 9999; cursor: zoom-out; align-items: center; justify-content: center; padding: 40px; }
.lightbox.active { display: flex; }
.lightbox img { max-width: 92vw; max-height: 88vh; object-fit: contain; border-radius: 8px; cursor: default; }
.lightbox-close { position: absolute; top: 24px; right: 32px; width: 44px; height: 44px; border-radius: 50%; color: white; font-size: 28px; cursor: pointer; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); transition: all 0.2s; display: flex; align-items: center; justify-content: center; line-height: 1; padding: 0; }
.lightbox-close:hover { background: rgba(255,255,255,0.2); }
.lightbox-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 56px; height: 56px; border-radius: 50%; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); color: white; font-size: 40px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; line-height: 1; padding: 0 0 6px; font-weight: 300; }
.lightbox-nav:hover { background: rgba(255,255,255,0.22); transform: translateY(-50%) scale(1.05); }
.lightbox-prev { left: 24px; }
.lightbox-next { right: 24px; padding: 0 0 6px 4px; }
.lightbox-counter { position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); color: rgba(255,255,255,0.7); font-size: 14px; letter-spacing: 0.06em; font-weight: 500; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); padding: 7px 16px; border-radius: 100px; }
@media (max-width: 700px) { .lightbox-nav { width: 44px; height: 44px; font-size: 30px; } .lightbox-prev { left: 12px; } .lightbox-next { right: 12px; } }

/* ANIMATIONS */
@keyframes fadeUp { from{opacity:0;transform:translateY(20px);} to{opacity:1;transform:translateY(0);} }
.hero-eyebrow{animation:fadeUp 0.6s 0.1s both;}
.hero h1{animation:fadeUp 0.6s 0.2s both;}
.hero-sub{animation:fadeUp 0.6s 0.3s both;}
.hero-promise{animation:fadeUp 0.6s 0.4s both;}
.hero-cta{animation:fadeUp 0.6s 0.5s both;}
.hero-meta{animation:fadeUp 0.6s 0.6s both;}

/* RESPONSIVE */
@media(max-width:1100px){
  .bonus-grid, .about, .cta-grid { grid-template-columns: 1fr; gap: 48px; }
  .prog-lessons-row { grid-template-columns: 1fr; }
  .prog-video-block { grid-template-columns: 1fr; gap: 24px; }
  .prog-details { grid-template-columns: repeat(2, 1fr); }
  .gf-grid { grid-template-columns: 1fr; gap: 32px; }
  .guarantee-box { position: static; }
  .seasons-grid { grid-template-columns: repeat(2, 1fr); }
  .fw-grid, .safety-grid { grid-template-columns: repeat(2, 1fr); }
  .takeaways-grid { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  .stat-breakdown { grid-template-columns: 1fr; gap: 24px; }
  .stat-bd-divider { width: 100%; height: 1px; }
  .kids-grid { grid-template-columns: repeat(2, 1fr); }
  .kid-quote--featured { grid-column: span 2; }
  .parent-grid { grid-template-columns: 1fr; }
  .course-videos-grid { grid-template-columns: 1fr; }
}
@media(max-width:760px){
  nav { padding: 0 20px; }

  .hero { grid-template-columns: 1fr; }
  .hero-left { padding: 56px 24px; }
  .hero-right { min-height: 320px; }

  /* CTA-кнопка на всю ширину — стрелка не съезжает на новую строку */
  .hero-cta { align-items: stretch; }
  .btn-hero {
    width: 100%; justify-content: center;
    padding: 16px 20px; font-size: 15px;
    box-sizing: border-box;
  }
  .btn-hero-secondary { align-self: center; }

  /* Hero-фото на мобиле — без масштабирования, в естественных пропорциях,
     лица не обрезаются ни сверху, ни снизу */
  .hero-right { min-height: 0; aspect-ratio: 4 / 5; }
  .hero-photo { transform: none; object-fit: cover; object-position: center top; }
  .seasons-pill, .hero-badge { position: static; box-shadow: none; }
  .seasons-pill {
    width: 100%; padding: 12px 20px;
    border-radius: 0; justify-content: center;
    background: var(--navy); max-width: none;
  }
  .hero-badge {
    display: flex; gap: 12px; max-width: none;
    padding: 16px 20px; border-radius: 0;
    background: var(--cream);
    border-top: 1px solid rgba(0,0,0,0.08);
  }

  .hero-meta { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .seasons, .for-whom, .programme, .bonus, .about, .safety, .takeaways, .media-section, .reviews, .guarantee-faq, .cta-section, .tg-strip { padding: 60px 24px; }
  .tg-strip-wrap { flex-direction: column; align-items: flex-start; gap: 20px; }
  .kid-quote--featured { grid-column: span 1; }
  .kid-quote--featured .kid-quote-text { font-size: 22px; }
  .seasons-grid, .fw-grid, .safety-grid, .takeaways-grid { grid-template-columns: 1fr; }
  .prog-details { grid-template-columns: 1fr 1fr; padding: 28px; gap: 20px; }
  .gallery-grid { grid-template-columns: 1fr; }
  .survey-stats { padding: 32px 24px; }
  .kids-grid { grid-template-columns: 1fr; }
  .kid-quote--featured { grid-column: span 1; }
  footer { flex-direction: column; gap: 18px; padding: 32px 24px; text-align: center; }
  .price-box { padding: 28px; }
  .price-main { font-size: 44px; }
}

