<!-- Lightbox -->
<div class="lightbox" id="lightbox">
  <button class="lightbox-close" onclick="closeLightbox(event)" aria-label="Закрыть">×</button>
  <button class="lightbox-nav lightbox-prev" onclick="navLightbox(-1, event)" aria-label="Предыдущее фото">‹</button>
  <button class="lightbox-nav lightbox-next" onclick="navLightbox(1, event)" aria-label="Следующее фото">›</button>
  <div class="lightbox-counter" id="lightbox-counter"></div>
  <img id="lightbox-img" src="" alt="" onclick="event.stopPropagation()">
</div>

<script is:inline>
  const imageSets = {
    gallery: [
      '/salut-2026/img/class-circle-overview.jpg',
      '/salut-2026/img/group-relaxed-after.jpg',
      '/salut-2026/img/exam-flexing.jpg',
      '/salut-2026/img/group-mixed-selfie.jpg',
      '/salut-2026/img/exam-certificates-1.jpg',
      '/salut-2026/img/group-kids-selfie.jpg',
      '/salut-2026/img/group-teens-selfie.jpg',
      '/salut-2026/img/trainer-stretch.jpg',
      '/salut-2026/img/trainer-plank.jpg'
    ],
    takeaway: [
      '/salut-2026/img/certificate-front.jpg',
      '/salut-2026/img/certificate-back.jpg',
      '/salut-2026/img/methodichka-theory.jpg',
      '/salut-2026/img/methodichka-exercises.jpg'
    ]
  };
  let currentSet = null;
  let currentIdx = -1;

  function showImage() {
    const arr = imageSets[currentSet];
    document.getElementById('lightbox-img').src = arr[currentIdx];
    document.getElementById('lightbox-counter').textContent = (currentIdx + 1) + ' / ' + arr.length;
  }
  function openSet(setName, idx) {
    currentSet = setName;
    currentIdx = idx;
    document.querySelectorAll('.lightbox-nav, #lightbox-counter').forEach(el => el.style.display = '');
    showImage();
    document.getElementById('lightbox').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function openGallery(idx) { openSet('gallery', idx); }
  function openTakeaway(idx) { openSet('takeaway', idx); }
  function openLightbox(src) {
    // одиночное фото (без навигации)
    currentSet = null;
    currentIdx = -1;
    document.getElementById('lightbox-img').src = src;
    document.querySelectorAll('.lightbox-nav, #lightbox-counter').forEach(el => el.style.display = 'none');
    document.getElementById('lightbox').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox(e) {
    if (e) e.stopPropagation();
    document.getElementById('lightbox').classList.remove('active');
    document.body.style.overflow = '';
  }
  function navLightbox(delta, e) {
    if (e) e.stopPropagation();
    if (!currentSet || currentIdx < 0) return;
    const arr = imageSets[currentSet];
    currentIdx = (currentIdx + delta + arr.length) % arr.length;
    showImage();
  }
  document.getElementById('lightbox').addEventListener('click', closeLightbox);
  document.addEventListener('keydown', function(e) {
    if (!document.getElementById('lightbox').classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (currentSet) {
      if (e.key === 'ArrowRight') navLightbox(1);
      if (e.key === 'ArrowLeft') navLightbox(-1);
    }
  });

  // Кнопка Play по центру + click to toggle
  document.querySelectorAll('.video-wrap').forEach(wrap => {
    const video = wrap.querySelector('.js-vid');
    const btn = wrap.querySelector('.video-play-btn');
    if (!video || !btn) return;
    function sync() { wrap.classList.toggle('is-playing', !video.paused && !video.ended); }
    btn.addEventListener('click', e => {
      e.preventDefault();
      if (video.paused) video.play(); else video.pause();
    });
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    video.addEventListener('ended', sync);
    sync();
  });

  // Гарантированно плавный скролл по якорным ссылкам.
  // Event delegation — работает даже если ссылок ещё нет в DOM при загрузке.
  document.addEventListener('click', (e) => {
    const link = e.target.closest && e.target.closest('a[href^="#"]');
    if (!link) return;
    const href = link.getAttribute('href');
    if (!href || href === '#') return;
    const target = document.querySelector(href);
    if (!target) return;
    e.preventDefault();
    const rect = target.getBoundingClientRect();
    const top = window.pageYOffset + rect.top - 70; // зазор под фикс-шапку
    window.scrollTo({ top, behavior: 'smooth' });
    history.replaceState(null, '', href);
  });
</script>
</Base>
