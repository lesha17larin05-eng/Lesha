/* Цифры опроса */
.survey-stats { background: white; border-radius: 24px; padding: 48px 56px; border: 1px solid var(--border); margin-bottom: 56px; box-shadow: 0 12px 40px rgba(0,0,0,0.04); }
.stat-headline { text-align: center; padding-bottom: 40px; border-bottom: 1px solid var(--border); margin-bottom: 36px; }
.stat-headline-label { font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--orange); margin-bottom: 16px; }
.stat-headline-num { font-family: 'Cormorant Garamond', serif; font-size: clamp(72px,7vw,120px); font-weight: 400; color: var(--navy); line-height: 1; letter-spacing: -0.02em; }
.stat-headline-num span { color: var(--text-light); font-size: 0.5em; font-weight: 300; }
.stat-headline-sub { font-size: 16px; color: var(--text-muted); margin-top: 14px; font-style: italic; font-family: 'Cormorant Garamond', serif; font-size: 20px; }
