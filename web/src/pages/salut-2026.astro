---
import Base from '../layouts/Base.astro';
---
<Base title="Здоровая спина в Салюте · Алексей Ларин" active="salyut">
<style>

:root {
  --navy: #1a2744;
  --navy-mid: #243058;
  --navy-light: #2e3d6b;
  --orange: #e8652a;
  --orange-warm: #f07530;
  --orange-soft: #fbe6d4;
  --cream: #f8f5ef;
  --warm-white: #fdfaf5;
  --gold: #f4c361;
  --gold-soft: #fdf3dc;
  --text: #1a1a1a;
  --text-mid: #444;
  --text-muted: #777;
  --text-light: #aaa;
  --border: #ece8e0;
  --border-light: #f2ede5;
  --green: #4ade80;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
/* Чтобы #zapis не уходил под fixed-шапку сайта (64px) */
.cta-section { scroll-margin-top: 80px; }
body { font-family: 'Manrope', sans-serif; background: var(--warm-white); color: var(--text); overflow-x: hidden; -webkit-font-smoothing: antialiased; }

/* HERO */
.hero { min-height: 100vh; display: grid; grid-template-columns: 52% 48%; }
.hero-left {
  background: var(--navy); padding: 80px 72px 80px 80px;
  display: flex; flex-direction: column; justify-content: center;
  position: relative; overflow: hidden;
}
.hero-left::before {
  content: ''; position: absolute; top: -80px; right: -80px;
  width: 480px; height: 480px;
  background: radial-gradient(circle, rgba(244,195,97,0.15) 0%, transparent 65%);
  pointer-events: none;
}
.hero-left::after {
  content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, var(--orange) 0%, transparent 60%);
}
.hero-eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; position: relative; }
.eyebrow-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--orange); }
.eyebrow-text { font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.85); }
.hero h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(40px,4.2vw,62px); font-weight: 400; line-height: 1.08; color: white; margin-bottom: 14px; letter-spacing: -0.015em; position: relative; }
.hero h1 em { font-style: italic; color: var(--gold); }
.hero-sub { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 300; font-style: italic; color: rgba(255,255,255,0.82); margin-bottom: 32px; line-height: 1.5; position: relative; }
.hero-promise { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 22px 26px; margin-bottom: 36px; position: relative; }
.hero-promise p { font-size: 18px; line-height: 1.8; color: rgba(255,255,255,0.82); }
.hero-promise strong { color: white; font-weight: 600; }
.hero-cta { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; position: relative; }
.btn-hero {
  display: inline-flex; align-items: center; gap: 12px;
  background: var(--orange); color: white; text-decoration: none;
  padding: 18px 36px; border-radius: 100px; font-size: 17px; font-weight: 600;
  transition: all 0.25s; box-shadow: 0 8px 32px rgba(232,101,42,0.35);
}
.btn-hero:hover { background: var(--orange-warm); transform: translateY(-2px); }
.btn-hero-secondary {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 14px; color: rgba(255,255,255,0.7); text-decoration: none;
  padding: 6px 0; border-bottom: 1px dashed rgba(255,255,255,0.25);
  transition: color 0.2s;
}
.btn-hero-secondary:hover { color: white; border-color: rgba(255,255,255,0.82); }
.hero-reply { font-size: 14px; color: rgba(255,255,255,0.75); margin-top: 6px; display: flex; align-items: center; gap: 6px; }
.hero-reply::before { content: '✓'; color: var(--green); }
.hero-meta { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 52px; padding-top: 36px; border-top: 1px solid rgba(255,255,255,0.08); position: relative; }
.meta-num { font-family: 'Cormorant Garamond', serif; font-size: 32px; font-weight: 500; color: white; line-height: 1; display: block; margin-bottom: 8px; }
.meta-label { font-size: 13px; color: rgba(255,255,255,0.85); line-height: 1.45; }

.hero-right { background: var(--cream); position: relative; overflow: hidden; }
.hero-photo { width: 100%; height: 100%; object-fit: cover; display: block; transform: scale(1.04); transform-origin: center bottom; }
.hero-badge { position: absolute; bottom: 28px; left: 28px; background: white; border-radius: 16px; padding: 14px 18px; box-shadow: 0 8px 32px rgba(0,0,0,0.12); display: flex; align-items: center; gap: 12px; max-width: 280px; z-index: 5; }
.badge-icon { width: 42px; height: 42px; border-radius: 12px; background: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }
.badge-title { font-size: 15px; font-weight: 700; color: var(--navy); margin-bottom: 3px; }
.badge-sub { font-size: 13px; color: var(--text-muted); line-height: 1.4; }
.seasons-pill { position: absolute; top: 28px; right: 28px; background: var(--navy); color: white; padding: 10px 18px; border-radius: 100px; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px; z-index: 5; }
.seasons-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); animation: pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.4;} }

/* SECTIONS */
.section-label { font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--orange); margin-bottom: 16px; }
.section-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(36px,3.5vw,52px); font-weight: 400; line-height: 1.15; color: var(--navy); margin-bottom: 16px; letter-spacing: -0.01em; }
.section-title em { font-style: italic; }
.section-desc { font-size: 18px; color: var(--text-muted); line-height: 1.8; max-width: 640px; margin-bottom: 56px; }

/* SEASONS */
.seasons { padding: 90px 80px 80px; background: var(--cream); }
.seasons-head { max-width: 720px; margin-bottom: 48px; }
.seasons-head .section-desc { margin-bottom: 0; }
.prog-head .section-desc,
.safety-head .section-desc,
.takeaways-head .section-desc,
.reviews-head .section-desc,
.media-head .section-desc { margin-bottom: 0; }
.seasons-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
.season-card { background: white; border-radius: 18px; padding: 28px 24px; border: 1px solid var(--border); transition: all 0.2s; position: relative; }
.season-card:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(0,0,0,0.05); }
.season-name { font-size: 22px; font-weight: 700; color: var(--navy); margin-bottom: 14px; line-height: 1.2; }
.season-dates { font-size: 16px; color: var(--text-mid); line-height: 1.5; margin-bottom: 16px; }
.season-status { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; }
.season-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--green); }
.season-card--done { background: #f5f1ea; }
.season-status--done { color: var(--text-light); }
.season-status--done::before { background: var(--text-light); }
.season-card--live { border-color: var(--orange); box-shadow: 0 12px 36px rgba(232,101,42,0.08); }
.season-status--live { color: var(--orange); }
.season-status--live::before { background: var(--orange); animation: pulse 2s infinite; }

/* FOR WHOM */
.for-whom { padding: 100px 80px; background: white; }
.fw-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.fw-card { background: var(--cream); border-radius: 18px; padding: 32px 28px; border: 1px solid var(--border); transition: all 0.2s; }
.fw-card:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(0,0,0,0.06); }
.fw-icon { width: 48px; height: 48px; border-radius: 12px; background: var(--navy); display: flex; align-items: center; justify-content: center; margin-bottom: 18px; }
.fw-icon svg { width: 22px; height: 22px; stroke: white; }
.fw-card h3 { font-size: 22px; font-weight: 700; margin-bottom: 14px; color: var(--navy); line-height: 1.3; }
.fw-card p { font-size: 17px; color: var(--text-muted); line-height: 1.7; }

/* PROGRAMME */
.programme { padding: 100px 80px; background: var(--cream); position: relative; overflow: hidden; }
.prog-head { max-width: 660px; margin-bottom: 56px; }
.prog-lessons-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 48px; }
.prog-lesson { background: white; border-radius: 16px; padding: 26px 28px; border: 1px solid var(--border); display: flex; flex-direction: column; gap: 14px; align-items: flex-start; transition: all 0.2s; }
.prog-lesson:hover { border-color: var(--orange); transform: translateY(-2px); box-shadow: 0 12px 32px rgba(0,0,0,0.05); }

/* Новая структура 5 занятий */
.prog-sessions { display: flex; flex-direction: column; gap: 14px; margin-bottom: 48px; }
.prog-session { background: white; border-radius: 18px; border: 1px solid var(--border); overflow: hidden; transition: all 0.2s; }
.prog-session:hover { border-color: var(--orange); transform: translateY(-2px); box-shadow: 0 12px 32px rgba(0,0,0,0.05); }
.prog-session-head { display: flex; align-items: center; gap: 22px; padding: 22px 32px; background: linear-gradient(90deg, var(--navy) 0%, var(--navy-mid) 100%); }
.prog-session-num { font-family: 'Cormorant Garamond', serif; font-size: 32px; font-weight: 500; color: var(--gold); line-height: 1; flex-shrink: 0; min-width: 44px; }
.prog-session-name { font-size: 21px; font-weight: 600; color: white; line-height: 1.3; }
.prog-session-blocks { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
.prog-session-block { padding: 26px 32px; }
.prog-theory { background: var(--warm-white); border-right: 1px solid var(--border-light); }
.prog-practice { background: white; }
.prog-block-label { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--orange); margin-bottom: 12px; }
.prog-theory .prog-block-label { color: var(--orange); }
.prog-practice .prog-block-label { color: var(--navy); }
.prog-block-text { font-size: 16px; color: var(--text-mid); line-height: 1.65; }
.prog-session--final .prog-session-head { background: linear-gradient(90deg, var(--orange) 0%, var(--orange-warm) 100%); }
.prog-session--final .prog-session-num { color: white; }
@media(max-width:760px){
  .prog-session-head { padding: 18px 22px; gap: 16px; }
  .prog-session-num { font-size: 26px; min-width: 36px; }
  .prog-session-name { font-size: 18px; }
  .prog-session-blocks { grid-template-columns: 1fr; }
  .prog-session-block { padding: 22px 22px; }
  .prog-theory { border-right: none; border-bottom: 1px solid var(--border-light); }
}

.prog-video-block { display: grid; grid-template-columns: 1fr 1.6fr; gap: 40px; align-items: center; background: white; border-radius: 22px; padding: 28px; border: 1px solid var(--border); margin-bottom: 56px; }
.prog-video-text { padding: 8px 0; }
.prog-video-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--orange); margin-bottom: 12px; }
.prog-video-h { font-family: 'Cormorant Garamond', serif; font-size: 30px; font-weight: 500; color: var(--navy); line-height: 1.15; margin: 0 0 14px; letter-spacing: -0.005em; }
.prog-video-desc { font-size: 16px; color: var(--text-muted); line-height: 1.7; margin: 0; }
.prog-video { border-radius: 14px; overflow: hidden; aspect-ratio: 16/9; background: var(--navy); position: relative; box-shadow: 0 8px 28px rgba(0,0,0,0.1); }
.prog-video video { width: 100%; height: 100%; object-fit: cover; display: block; }
.prog-lesson-num { font-family: 'Cormorant Garamond', serif; font-size: 36px; font-weight: 400; color: var(--orange); line-height: 1; flex-shrink: 0; }
.prog-lesson-content h4 { font-size: 18px; font-weight: 700; color: var(--navy); margin-bottom: 6px; }
.prog-lesson-content p { font-size: 15px; color: var(--text-muted); line-height: 1.65; }

.prog-details { background: white; border-radius: 20px; padding: 36px 40px; border: 1px solid var(--border); display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
.prog-detail-icon { width: 36px; height: 36px; border-radius: 10px; background: var(--orange-soft); display: flex; align-items: center; justify-content: center; margin-bottom: 12px; font-size: 18px; }
.prog-detail-num { font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 500; color: var(--navy); line-height: 1; margin-bottom: 6px; }
.prog-detail-label { font-size: 14px; color: var(--text-muted); line-height: 1.5; }

/* BONUS */
.bonus { padding: 100px 80px; background: linear-gradient(135deg, var(--gold-soft) 0%, var(--orange-soft) 100%); position: relative; overflow: hidden; }
.bonus::before {
  content: ''; position: absolute; top: -100px; right: -100px;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(244,195,97,0.3) 0%, transparent 70%);
  pointer-events: none;
}
.bonus-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; position: relative; }
.bonus-tag { display: inline-flex; align-items: center; gap: 10px; background: var(--navy); color: white; padding: 8px 18px; border-radius: 100px; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 22px; }
.bonus h2 { font-family: 'Cormorant Garamond', serif; font-size: clamp(38px,3.5vw,54px); font-weight: 400; line-height: 1.1; color: var(--navy); margin-bottom: 20px; letter-spacing: -0.01em; }
.bonus h2 em { font-style: italic; color: var(--orange); }
.bonus-lead { font-size: 19px; color: var(--text-mid); line-height: 1.7; margin-bottom: 28px; }
.bonus-lead strong { color: var(--navy); font-weight: 600; }
.bonus-features { display: flex; flex-direction: column; gap: 14px; margin-bottom: 28px; }
.bonus-feature { display: flex; align-items: flex-start; gap: 12px; font-size: 17px; color: var(--text-mid); line-height: 1.6; }
.bonus-check { width: 22px; height: 22px; border-radius: 50%; background: var(--orange); color: white; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0; margin-top: 2px; }
.bonus-value { background: white; border-radius: 16px; padding: 22px 26px; display: flex; align-items: center; gap: 18px; box-shadow: 0 4px 24px rgba(0,0,0,0.04); }
.bonus-value-old { font-family: 'Cormorant Garamond', serif; font-size: 32px; font-weight: 400; color: var(--text-light); text-decoration: line-through; }
.bonus-value-new { font-family: 'Cormorant Garamond', serif; font-size: 36px; font-weight: 500; color: var(--orange); }
.bonus-value-label { font-size: 14px; color: var(--text-muted); line-height: 1.4; }
.bonus-card {
  background: var(--navy); border-radius: 24px; padding: 36px 36px 32px;
  display: flex; flex-direction: column; gap: 28px;
  box-shadow: 0 24px 60px rgba(26,39,68,0.25);
  position: relative; overflow: hidden;
}
.bonus-card::before {
  content: ''; position: absolute; top: -80px; right: -80px;
  width: 280px; height: 280px;
  background: radial-gradient(circle, rgba(244,195,97,0.18) 0%, transparent 65%);
  pointer-events: none;
}
.bonus-card-top { position: relative; }
.bonus-card-tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
.bonus-card-title { font-family: 'Cormorant Garamond', serif; font-size: 42px; font-weight: 400; color: white; line-height: 1.05; letter-spacing: -0.01em; }
.bonus-card-title em { font-style: italic; color: var(--gold); }
.bonus-card-sub { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-style: italic; font-weight: 300; color: rgba(255,255,255,0.82); margin-top: 6px; }
.bonus-card-modules { display: flex; flex-direction: column; gap: 12px; padding: 22px 0; border-top: 1px solid rgba(255,255,255,0.1); border-bottom: 1px solid rgba(255,255,255,0.1); position: relative; }
.bcm-row { display: flex; align-items: center; gap: 16px; font-size: 15px; color: rgba(255,255,255,0.78); }
.bcm-num { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: var(--orange); font-weight: 500; min-width: 28px; }
.bonus-card-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; position: relative; }
.bonus-card-stats > div { text-align: center; padding: 4px 0; }
.bcs-num { font-family: 'Cormorant Garamond', serif; font-size: 32px; font-weight: 500; color: white; line-height: 1; margin-bottom: 4px; }
.bcs-lab { font-size: 12px; color: rgba(255,255,255,0.82); letter-spacing: 0.04em; text-transform: uppercase; }

/* ABOUT */
.about { padding: 100px 80px; background: var(--navy); display: grid; grid-template-columns: 1fr 1.2fr; gap: 72px; align-items: center; position: relative; overflow: hidden; }
.about::before { content: '"'; position: absolute; top: -20px; left: 60px; font-family: 'Cormorant Garamond', serif; font-size: 320px; color: rgba(255,255,255,0.03); line-height: 1; pointer-events: none; }
.about-photo { border-radius: 24px; overflow: hidden; aspect-ratio: 3/4; }
.about-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
.about-content .section-label { color: #7ab0f0; }
.about-content .section-title { color: white; margin-bottom: 24px; }
.about-pull { background: rgba(255,255,255,0.05); border-left: 3px solid var(--orange); padding: 18px 22px; border-radius: 0 12px 12px 0; margin: 24px 0; font-family: 'Cormorant Garamond', serif; font-size: 21px; font-style: italic; font-weight: 300; color: rgba(255,255,255,0.78); line-height: 1.5; }
.about-text { font-size: 17px; color: rgba(255,255,255,0.7); line-height: 1.8; margin-bottom: 14px; }
.about-creds { display: flex; flex-direction: column; gap: 14px; margin-top: 28px; padding-top: 28px; border-top: 1px solid rgba(255,255,255,0.08); }
.about-cred { display: flex; align-items: center; gap: 12px; font-size: 16px; color: rgba(255,255,255,0.9); }
.cred-icon { width: 30px; height: 30px; border-radius: 8px; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }

/* PERCEPTIONS — до/после анкеты */
.perceptions { padding: 100px 80px; background: white; }
.perc-head { max-width: 720px; margin-bottom: 56px; }
.perc-head .section-desc { margin-bottom: 0; }
.perc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
.perc-pair { background: var(--cream); border-radius: 20px; padding: 28px; border: 1px solid var(--border); display: flex; flex-direction: column; gap: 14px; }
.perc-pair--final { background: var(--gold-soft); border-color: var(--gold); }
.perc-card { background: white; border-radius: 14px; padding: 22px 24px; border: 1px solid var(--border); }
.perc-before { border-left: 3px solid var(--text-light); }
.perc-after { border-left: 3px solid var(--orange); }
.perc-label { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 12px; }
.perc-after .perc-label { color: var(--orange); }
.perc-text { font-size: 16px; color: var(--text); line-height: 1.7; margin-bottom: 12px; }
.perc-text strong { color: var(--navy); font-weight: 700; }
.perc-text em { font-style: italic; color: var(--navy); }
.perc-author { font-size: 13px; color: var(--text-muted); font-weight: 500; letter-spacing: 0.02em; }
.perc-arrow { text-align: center; font-size: 28px; color: var(--orange); line-height: 1; font-weight: 300; }
@media(max-width:1100px){
  .perc-grid { grid-template-columns: 1fr; }
}
@media(max-width:760px){
  .perceptions { padding: 60px 24px; }
  .perc-pair { padding: 22px; }
  .perc-card { padding: 18px 20px; }
}

/* SAFETY */
.safety { padding: 100px 80px; background: white; }
.safety-head { max-width: 620px; margin-bottom: 56px; }
.safety-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.safety-card { background: var(--cream); border-radius: 20px; padding: 36px 32px; border: 1px solid var(--border); }
.safety-icon { width: 52px; height: 52px; border-radius: 14px; background: var(--orange); display: flex; align-items: center; justify-content: center; margin-bottom: 20px; }
.safety-icon svg { width: 24px; height: 24px; stroke: white; }
.safety-card h3 { font-size: 22px; font-weight: 700; color: var(--navy); margin-bottom: 14px; line-height: 1.3; }
.safety-card p { font-size: 17px; color: var(--text-muted); line-height: 1.7; }

/* TAKEAWAYS — методички и сертификат */
.takeaways { padding: 100px 80px; background: var(--cream); }
.takeaways-head { max-width: 680px; margin-bottom: 56px; }
.takeaways-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
.takeaway-block { background: white; border-radius: 20px; overflow: hidden; border: 1px solid var(--border); transition: all 0.25s; display: flex; flex-direction: column; }
.takeaway-block:hover { transform: translateY(-3px); box-shadow: 0 20px 50px rgba(0,0,0,0.06); border-color: var(--orange); }
.takeaway-images { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 12px; background: var(--cream); }
.takeaway-images img { width: 100%; aspect-ratio: 3/4; object-fit: contain; background: white; border-radius: 8px; padding: 8px; cursor: zoom-in; transition: transform 0.2s; }
.takeaway-images img:hover { transform: scale(1.02); }
.takeaway-body { padding: 28px 32px 32px; }
.takeaway-tag { display: inline-block; font-size: 12px; font-weight: 700; color: var(--orange); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px; }
