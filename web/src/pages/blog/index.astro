---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { apiJson } from '../../lib/api';

const cookie = Astro.request.headers.get('cookie') || '';
const { data } = await apiJson<any[]>('/api/articles?limit=100', { cookie });
const articles = Array.isArray(data) ? data : [];

const tagClasses: Record<string, string> = {
  'Начало пути':        'tag-start',
  'Спина и суставы':    'tag-pain',
  'Энергия':            'tag-energy',
  'Ментальное здоровье':'tag-mind',
  'Похудение':          'tag-weight',
};

const coverPositions: Record<string, string> = {
  'kak-nachat-trenirovatsya':                  'center 25%',
  'pochemu-brosaju-trenirovki':                'center 15%',
  'zaryadka':                                  'center center',
  'bolit-poyasnitsa-sidjachaja-rabota':        'center center',
  'pochemu-net-energii':                       'center 30%',
  'pochemu-ne-hudeu-hotja-treniruus':          'center 25%',
  'kak-uluchshit-son':                         'center 30%',
  'sustavnaja-gimnastika-dlja-nachinajuschih': 'center 25%',
  'kak-uluchshit-osanku':                      'center 40%',
  'kak-snizit-trevozhnost':                    'center 30%',
  'istorija-pereloma-pozvonochnika':           'center 15%',
  'kak-pravilno-podnimat-tyazhesti':           'center center',
  'mpk-chto-eto-i-kak-uluchshit':             'center 20%',
  'kak-sformirovat-privychku-trenirovatsya':   'center 25%',
  'kak-nachat-begat':                          'center 50%',
  'trenirovki-i-mentalnoe-zdorove':            'center 25%',
  'kak-pitatsya-chtoby-pohudjet':              'center 20%',
  'sotsialnoe-zdorove':                        'center 25%',
  'princip-malenkih-shagov':                   'center 30%',
  'uprazhnenija-ot-otekov':                    'center 65%',
  'gimnastika-dlja-glaz':                      'center 55%',
  'uprazhnenija-dlja-shei':                    'center 20%',
  'uprazhnenija-pri-sidjachej-rabote':         'center center',
  'kak-razvit-gibkost':                        'center 30%',
  'kak-begat-zimoj':                           'center 30%',
  'banja-i-zdorove':                           'center center',
  'kak-nauchitsja-meditirovat':                'center center',
  'akrojoga-chto-eto':                         'center center',
  'obuchenie-novomu-navyku':                   'center 15%',
  'dyhatelnye-tehniki':                        'center center',
  'kak-trenirujet-detej':                      'center center',
  'muzhskoe-zhenskoe-zdorove':                 'center center',
};

const blogStyles = `
.blog-page-header { padding: 120px 80px 60px; background: var(--navy); position: relative; overflow: hidden; }
.blog-page-header::before { content: ''; position: absolute; top: -80px; right: -80px; width: 480px; height: 480px; background: radial-gradient(circle, rgba(46,61,107,0.6) 0%, transparent 65%); pointer-events: none; }
.blog-page-header::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--orange) 0%, transparent 60%); }
.blog-page-header .header-label { font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 16px; position: relative; }
.blog-page-header h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(40px,4vw,60px); font-weight: 400; color: white; line-height: 1.1; margin-bottom: 12px; position: relative; }
.blog-page-header h1 em { font-style: italic; color: #8bb8f0; }
.blog-page-header p { font-size: 17px; color: rgba(255,255,255,0.5); max-width: 520px; line-height: 1.75; position: relative; }
.blog-filters { padding: 32px 80px; background: white; border-bottom: 1px solid var(--border); display: flex; gap: 12px; flex-wrap: wrap; }
.filter-btn { padding: 8px 18px; border-radius: 100px; font-size: 13px; font-weight: 600; cursor: pointer; border: 1.5px solid var(--border); background: transparent; color: var(--text-muted); transition: all 0.2s; font-family: 'Manrope', sans-serif; }
.filter-btn:hover { border-color: var(--navy); color: var(--navy); }
.filter-btn.active { background: var(--navy); border-color: var(--navy); color: white; }
.blog-grid { padding: 60px 80px 100px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
.article-card { background: white; border-radius: 20px; border: 1px solid var(--border); overflow: hidden; transition: transform .2s, box-shadow .2s; text-decoration: none; display: flex; flex-direction: column; color: inherit; }
.article-card:hover { transform: translateY(-4px); box-shadow: 0 16px 48px rgba(0,0,0,0.07); }
.card-img { width: 100%; height: 200px; background: linear-gradient(160deg, #e8edf5 0%, #d4dce8 100%); display: flex; align-items: center; justify-content: center; font-size: 13px; color: var(--text-light); font-weight: 500; background-size: cover; background-position: center; }
.card-body { padding: 28px; flex: 1; display: flex; flex-direction: column; }
.card-tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 12px; border-radius: 100px; margin-bottom: 14px; align-self: flex-start; }
.tag-start  { background: #dbeeff; color: #1060a0; }
.tag-pain   { background: #d4f0e4; color: #0a6040; }
.tag-energy { background: #fdefd4; color: #8a5010; }
.tag-mind   { background: #f0e4ff; color: #6020a0; }
.tag-weight { background: #ffe4e4; color: #a02020; }
.card-title { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 400; color: var(--navy); line-height: 1.3; margin-bottom: 12px; flex: 1; }
.card-desc { font-size: 14px; color: var(--text-muted); line-height: 1.7; margin-bottom: 20px; }
.card-meta { display: flex; align-items: center; justify-content: space-between; font-size: 13px; color: var(--text-light); border-top: 1px solid var(--border); padding-top: 16px; }
.card-read { color: var(--orange); font-weight: 600; }
.blog-empty { padding: 100px 80px; text-align: center; color: var(--text-muted); }
@media (max-width: 900px) { .blog-grid { grid-template-columns: repeat(2,1fr); padding: 60px 24px 100px; } .blog-page-header { padding: 100px 24px 48px; } .blog-filters { padding: 24px; } }
@media (max-width: 600px) { .blog-grid { grid-template-columns: 1fr; gap: 20px; } }
`;
---
<SiteLayout title="Блог — Алексей Ларин" active="blog" pageStyles={blogStyles}>
  <div class="blog-page-header">
    <div class="header-label">Блог</div>
    <h1>Статьи о <em>здоровье</em><br>и движении</h1>
    <p>Практичные советы, личный опыт и всё, что помогает чувствовать себя лучше.</p>
  </div>

  <div class="blog-filters">
    <button class="filter-btn active" data-filter="all">Все</button>
    <button class="filter-btn" data-filter="Начало пути">Начало пути</button>
    <button class="filter-btn" data-filter="Спина и суставы">Спина и суставы</button>
    <button class="filter-btn" data-filter="Энергия">Энергия</button>
    <button class="filter-btn" data-filter="Похудение">Похудение</button>
    <button class="filter-btn" data-filter="Ментальное здоровье">Ментальное здоровье</button>
  </div>

  {articles.length === 0
    ? <div class="blog-empty">Пока статей нет. Загляните позже.</div>
    : <div class="blog-grid" id="blog-grid">
        {articles.map(a => {
          const tagClass = tagClasses[a.tag] ?? 'tag-start';
          return (
            <a href={`/blog/${a.slug}`} class="article-card" data-tag={a.tag || ''}>
              <div class="card-img" style={a.cover_image_url ? `background-image:url(${a.cover_image_url});background-position:${coverPositions[a.slug] ?? 'center center'}` : ''}>
                {!a.cover_image_url && <span>Фото к статье</span>}
              </div>
              <div class="card-body">
                {a.tag && <span class={`card-tag ${tagClass}`}>{a.tag}</span>}
                <div class="card-title">{a.title}</div>
                {a.excerpt && <p class="card-desc">{a.excerpt}</p>}
                <div class="card-meta">
                  <span>{a.reading_minutes ? `${a.reading_minutes} мин` : 'Читать'}</span>
                  <span class="card-read">Читать →</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
  }

  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.article-card');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.dataset.filter;
        cards.forEach(card => {
          card.style.display = (filter === 'all' || card.dataset.tag === filter) ? '' : 'none';
        });
      });
    });
  </script>
</SiteLayout>
