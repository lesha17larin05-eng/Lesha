---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { apiJson } from '../../lib/api';

const slug = Astro.params.slug;
const cookie = Astro.request.headers.get('cookie') || '';
const { status, data } = await apiJson<any>(`/api/articles/${slug}`, { cookie });
if (status !== 200 || !data) {
  return new Response('Not found', { status: 404 });
}
const a = data;

const articleStyles = `
.article-header { padding: 120px 80px 60px; background: var(--navy); position: relative; overflow: hidden; }
.article-header::before { content: ''; position: absolute; top: -80px; right: -80px; width: 480px; height: 480px; background: radial-gradient(circle, rgba(46,61,107,0.6) 0%, transparent 65%); pointer-events: none; }
.article-header::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--orange) 0%, transparent 60%); }
.article-tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 5px 14px; border-radius: 100px; margin-bottom: 20px; background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.6); position: relative; }
.article-header h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(32px,3.5vw,52px); font-weight: 400; color: white; line-height: 1.15; margin-bottom: 20px; position: relative; }
.article-header h1 em { font-style: italic; color: #8bb8f0; }
.article-meta { display: flex; align-items: center; gap: 20px; font-size: 14px; color: rgba(255,255,255,0.4); position: relative; }
.article-body { max-width: 720px; margin: 0 auto; padding: 64px 24px 100px; }
.article-body p { font-size: 17px; line-height: 1.9; color: var(--text-mid); margin-bottom: 24px; }
.article-body h2 { font-family: 'Cormorant Garamond', serif; font-size: 30px; font-weight: 400; color: var(--navy); margin: 48px 0 16px; line-height: 1.2; }
.article-body h2 em { font-style: italic; }
.article-body h3 { font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 400; color: var(--navy); margin: 36px 0 14px; }
.article-body strong { color: var(--text); font-weight: 600; }
.article-body ul, .article-body ol { margin: 0 0 24px 24px; color: var(--text-mid); }
.article-body ul li, .article-body ol li { margin-bottom: 10px; line-height: 1.8; }
.article-body a { color: var(--orange); }
.article-body img { max-width: 100%; height: auto; border-radius: 12px; margin: 24px 0; display: block; }
.article-body blockquote { border-left: 3px solid var(--orange); padding: 16px 24px; margin: 32px 0; font-style: italic; color: var(--text-mid); background: var(--cream); border-radius: 0 12px 12px 0; }
.article-pull { background: var(--cream); border-left: 3px solid var(--orange); padding: 20px 24px; border-radius: 0 12px 12px 0; margin: 36px 0; font-family: 'Cormorant Garamond', serif; font-size: 22px; font-style: italic; font-weight: 300; color: var(--navy); line-height: 1.6; }
.back-link { display: inline-flex; align-items: center; gap: 8px; color: var(--text-muted); text-decoration: none; font-size: 14px; margin-bottom: 48px; }
.back-link:hover { color: var(--navy); }
.article-cta-final { background: var(--navy); border-radius: 24px; padding: 40px 48px; margin: 60px 0 0; text-align: center; }
.article-cta-final p { font-size: 16px; color: rgba(255,255,255,0.6); line-height: 1.7; margin-bottom: 24px; }
.article-cta-final strong { color: white; }
.article-cta-final a { display: inline-flex; align-items: center; gap: 10px; background: var(--orange); color: white; text-decoration: none; padding: 16px 32px; border-radius: 100px; font-weight: 600; }
@media (max-width: 700px) { .article-header { padding: 100px 24px 48px; } .article-cta-final { padding: 32px 24px; } }
`;
---
<SiteLayout title={`${a.title} — Алексей Ларин`} description={a.excerpt} active="blog" pageStyles={articleStyles}>
  <div class="article-header">
    {a.tag && <span class="article-tag">{a.tag}</span>}
    <h1 set:html={a.title} />
    <div class="article-meta">
      <span>Алексей Ларин</span>
      {a.reading_minutes ? <span>· {a.reading_minutes} мин чтения</span> : null}
    </div>
  </div>
  <div class="article-body">
    <a href="/blog" class="back-link">← Все статьи</a>
    <Fragment set:html={a.content_html} />
    <div class="article-cta-final">
      <p><strong>Хотите начать мягко — с поддержкой и конкретным планом?</strong><br/>Пройдите бесплатный курс — несколько уроков, которые помогут начать и не бросить.</p>
      <a href="/course">Получить курс бесплатно →</a>
    </div>
  </div>
</SiteLayout>
