---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { apiJson } from '../../lib/api';
import { coverPositionsArticle, coverPositionsCard } from '../../lib/covers';

const slug = Astro.params.slug;
const cookie = Astro.request.headers.get('cookie') || '';
const { status, data } = await apiJson<any>(`/api/articles/${slug}`, { cookie });
if (status !== 200 || !data) {
  return new Response('Not found', { status: 404 });
}
const a = data;
const coverPos = coverPositionsArticle[a.slug] ?? 'center center';

// Похожие статьи: тот же тег, кроме текущей; добираем свежими, если мало.
const { data: allData } = await apiJson<any[]>('/api/articles?limit=100', { cookie });
const all = Array.isArray(allData) ? allData : [];
const sameTag = all.filter(x => x.slug !== a.slug && x.tag && x.tag === a.tag);
const others = all.filter(x => x.slug !== a.slug && (!x.tag || x.tag !== a.tag));
const related = [...sameTag, ...others].slice(0, 3);

const fmtDate = (iso?: string) => {
  if (!iso) return '';
  const d = new Date(iso);
  if (isNaN(d.getTime())) return '';
  return d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
};
const published = fmtDate(a.published_at);

// BlogPosting JSON-LD — rich snippets в Яндексе/Google
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: a.title,
  ...(a.excerpt ? { description: a.excerpt } : {}),
  ...(a.cover_image_url ? { image: 'https://leshalarin.ru' + a.cover_image_url } : {}),
  ...(a.published_at ? { datePublished: a.published_at } : {}),
  author: { '@type': 'Person', name: 'Алексей Ларин', url: 'https://leshalarin.ru/' },
  mainEntityOfPage: `https://leshalarin.ru/blog/${a.slug}`,
});

const articleStyles = `
.article-header { padding: 120px 80px 60px; background: var(--navy); position: relative; overflow: hidden; }
.article-header::before { content: ''; position: absolute; top: -80px; right: -80px; width: 480px; height: 480px; background: radial-gradient(circle, rgba(46,61,107,0.6) 0%, transparent 65%); pointer-events: none; }
.article-header::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--orange) 0%, transparent 60%); }
.article-tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 5px 14px; border-radius: 100px; margin-bottom: 20px; background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.88); position: relative; }
.article-header h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(32px,3.5vw,52px); font-weight: 400; color: white; line-height: 1.15; margin-bottom: 20px; position: relative; }
.article-header h1 em { font-style: italic; color: #8bb8f0; }
.article-meta { display: flex; align-items: center; gap: 20px; font-size: 14px; color: rgba(255,255,255,0.7); position: relative; }
.article-body { max-width: 720px; margin: 0 auto; padding: 64px 24px 100px; }
.article-body p { font-size: 17px; line-height: 1.9; color: var(--text-mid); margin-bottom: 24px; }
.article-body h2 { font-family: 'Cormorant Garamond', serif; font-size: 30px; font-weight: 400; color: var(--navy); margin: 48px 0 16px; line-height: 1.2; }
.article-body h2 em { font-style: italic; }
.article-body h3 { font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 400; color: var(--navy); margin: 36px 0 14px; }
.article-body strong { color: var(--text); font-weight: 600; }
.article-body ul, .article-body ol { margin: 0 0 24px 24px; color: var(--text-mid); }
.article-body ul li, .article-body ol li { margin-bottom: 10px; line-height: 1.8; }
.article-body a { color: var(--orange); }
.article-body img { max-width: 100%; height: auto; border-radius: 12px; margin: 24px 0; display: block; }
.article-cover { width: 100%; border-radius: 12px; object-fit: cover; aspect-ratio: 16/9; display: block; margin: 0 0 40px; }
.article-body blockquote { border-left: 3px solid var(--orange); padding: 16px 24px; margin: 32px 0; font-style: italic; color: var(--text-mid); background: var(--cream); border-radius: 0 12px 12px 0; }
.article-pull { background: var(--cream); border-left: 3px solid var(--orange); padding: 20px 24px; border-radius: 0 12px 12px 0; margin: 36px 0; font-family: 'Cormorant Garamond', serif; font-size: 22px; font-style: italic; font-weight: 300; color: var(--navy); line-height: 1.6; }
.back-link { display: inline-flex; align-items: center; gap: 8px; color: var(--text-muted); text-decoration: none; font-size: 14px; margin-bottom: 48px; }
.back-link:hover { color: var(--navy); }
.article-cta-final { background: var(--navy); border-radius: 24px; padding: 40px 48px; margin: 60px 0 0; text-align: center; }
.article-cta-final p { font-size: 16px; color: rgba(255,255,255,0.88); line-height: 1.7; margin-bottom: 24px; }
.article-cta-final strong { color: white; }
.article-cta-final a { display: inline-flex; align-items: center; gap: 10px; background: var(--orange); color: white; text-decoration: none; padding: 16px 32px; border-radius: 100px; font-weight: 600; }
.tg-inline { display: flex; align-items: center; gap: 20px; background: #eef6ff; border: 1px solid #c5dcf7; border-radius: 16px; padding: 22px 28px; margin: 48px 0 0; }
.tg-inline-icon { flex-shrink: 0; width: 44px; height: 44px; background: #2aabee; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; }
.tg-inline-text { flex: 1; }
.tg-inline-text strong { display: block; font-size: 16px; font-weight: 600; color: var(--navy); margin-bottom: 3px; }
.tg-inline-text span { font-size: 14px; color: var(--text-muted); }
.tg-inline .tg-inline-btn { flex-shrink: 0; display: inline-flex; align-items: center; gap: 8px; background: #2aabee; color: white; text-decoration: none; padding: 12px 22px; border-radius: 100px; font-size: 14px; font-weight: 600; white-space: nowrap; transition: background 0.2s, transform 0.15s; }
@media (hover: hover) { .tg-inline .tg-inline-btn:hover { background: #229ed9; transform: translateY(-1px); } }
.tg-inline .tg-inline-btn:focus-visible { outline: 2px solid #2aabee; outline-offset: 3px; }
@media (max-width: 700px) { .article-header { padding: 100px 24px 48px; } .article-cta-final { padding: 32px 24px; } .tg-inline { flex-direction: column; text-align: center; } .tg-inline .tg-inline-btn { width: 100%; justify-content: center; } }

/* Похожие статьи */
.related { margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--border); }
.related-title { font-family: 'Cormorant Garamond', serif; font-size: 26px; font-weight: 500; color: var(--navy); margin-bottom: 20px; }
.related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.related-card { background: white; border: 1px solid var(--border); border-radius: 14px; overflow: hidden; text-decoration: none; color: inherit; display: flex; flex-direction: column; transition: transform 0.2s, box-shadow 0.2s; }
@media (hover: hover) { .related-card:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(0,0,0,0.07); } }
.related-card:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
.related-img { width: 100%; aspect-ratio: 16/10; background: var(--cream) center/cover no-repeat; }
.related-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
.related-name { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: var(--navy); line-height: 1.3; flex: 1; }
.related-meta { font-size: 12px; color: var(--text-light); }
@media (max-width: 700px) { .related-grid { grid-template-columns: 1fr; } }
`;
---
<SiteLayout title={`${a.title} — Алексей Ларин`} description={a.excerpt} active="blog" pageStyles={articleStyles} ogImage={a.cover_image_url || undefined}>
  <script type="application/ld+json" set:html={jsonLd} />
  <div class="article-header">
    {a.tag && <span class="article-tag">{a.tag}</span>}
    <h1 set:html={a.title} />
    <div class="article-meta">
      <span>Алексей Ларин</span>
      {published ? <span>· {published}</span> : null}
      {a.reading_minutes ? <span>· {a.reading_minutes} мин чтения</span> : null}
    </div>
  </div>
  <div class="article-body">
    <a href="/blog" class="back-link">← Все статьи</a>
    {a.cover_image_url && <img src={a.cover_image_url} alt={a.title} class="article-cover" loading="eager" style={`object-position:${coverPos}`} />}
    <Fragment set:html={a.content_html} />
    {related.length > 0 && (
      <div class="related">
        <div class="related-title">Похожие статьи</div>
        <div class="related-grid">
          {related.map(r => (
            <a href={`/blog/${r.slug}`} class="related-card">
              <div class="related-img" style={r.cover_image_url ? `background-image:url(${r.cover_image_url});background-position:${coverPositionsCard[r.slug] ?? 'center center'}` : ''}></div>
              <div class="related-body">
                <div class="related-name">{r.title}</div>
                <div class="related-meta">{[r.tag, r.reading_minutes ? `${r.reading_minutes} мин` : ''].filter(Boolean).join(' · ')}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="article-cta-final">
      <p><strong>Хотите начать мягко — с поддержкой и конкретным планом?</strong><br/>Пройдите бесплатный курс — несколько уроков, которые помогут начать и не бросить.</p>
      <a href="/course">Получить курс бесплатно →</a>
    </div>
    <div class="tg-inline">
      <div class="tg-inline-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.248l-1.97 9.289c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12L7.88 13.617l-2.967-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.943.969z"/></svg>
      </div>
      <div class="tg-inline-text">
        <strong>Пока не готовы к курсу?</strong>
        <span>Подпишитесь на канал — советы о здоровье приходят бесплатно и без обязательств</span>
      </div>
      <a href="https://t.me/lesha_larin" target="_blank" rel="noopener" class="tg-inline-btn">Подписаться →</a>
    </div>
  </div>
</SiteLayout>
