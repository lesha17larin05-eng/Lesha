    .gp-leave > summary::-webkit-details-marker { display: none; }
    .gp-leave > summary span { color: var(--orange); text-decoration: underline; text-underline-offset: 3px; }
    @media (hover: hover) { .gp-leave > summary:hover { background: white; } }
    .gp-leave[open] > summary { margin-bottom: 16px; }
    .gp-leave .gp-form { text-align: left; }
    .gp-form { display: flex; flex-direction: column; gap: 12px; }
    .gp-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .gp-input { width: 100%; padding: 15px 18px; border-radius: 12px; border: 1.5px solid var(--border, #ece8e0); background: white; font-size: 17px; font-family: 'Manrope', sans-serif; color: var(--text, #1a1a1a); outline: none; transition: border-color .2s, box-shadow .2s; box-sizing: border-box; }
    .gp-input:focus { border-color: var(--orange); box-shadow: 0 0 0 3px rgba(232,101,42,.12); }
    textarea.gp-input { resize: vertical; min-height: 84px; }
    .gp-consent { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 1.5; color: var(--text-mid, #3a3a3a); cursor: pointer; }
    .gp-consent input { margin-top: 2px; width: 16px; height: 16px; accent-color: var(--orange); flex-shrink: 0; cursor: pointer; }
    .gp-consent a { color: var(--orange); }
    .gp-note { text-align: center; font-size: 15px; color: var(--text-light, #6e6e6e); min-height: 1em; margin: 0; }
    .gp-note.is-error { color: #c53030; }
    .gp-alt { text-align: center; font-size: 15px; color: var(--text-light, #6e6e6e); margin: 18px 0 0; }
    .gp-alt a { color: var(--navy); font-weight: 600; }
    .gp-success { text-align: center; background: white; border: 1px solid var(--border, #ece8e0); border-radius: 18px; padding: 30px 24px; }
    .gp-success h3 { font-size: 21px; color: var(--navy); margin: 0 0 8px; }
    .gp-success p { margin: 0; color: var(--text-muted, #555); }
    .gp-pay { margin-top: 40px; background: white; border: 1.5px solid var(--orange); border-radius: 20px; padding: 28px 24px; scroll-margin-top: 90px; }
    .gp-pay h3 { font-size: 21px; color: var(--navy); margin: 0 0 16px; text-align: center; }
    .gp-pay form { display: flex; flex-direction: column; gap: 12px; }
