---
import SiteLayout from '../layouts/SiteLayout.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import { apiJson } from '../lib/api';
import '../styles/landing.css';
// Групповое ведение: 8 недель, до 7 человек. Запись – через заявку (имя,
// контакт, цель); Алексей пишет человеку и присылает ссылку /gruppa#oplata,
// по ней открывается скрытый блок оплаты (POST /api/checkout/service,
// service=gruppa). После оплаты – письмо с анкетой и замерами (anketa ?k=gruppa).
const MAX = 'https://max.ru/u/f9LHodD0cOJK26BnKhvEBfpuj05eZ2Tn1oTqJ7kv0OoP_WfKwTiqDPGe-Nc?text=' + encodeURIComponent('Здравствуйте, Алексей! Хочу в групповое ведение. Моя цель: ');
const TG_JOIN = 'https://t.me/larin_lesha?text=' + encodeURIComponent('Здравствуйте, Алексей! Хочу в групповое ведение. Моя цель: ');
// Свободные места – по оплаченным заказам (GET /api/services/gruppa/seats).
let seats = 7, left = 7;
try {
  const { status, data } = await apiJson<{ seats: number; left: number }>('/api/services/gruppa/seats');
  if (status === 200 && data) { seats = data.seats; left = data.left; }
} catch {}
const plural = (n: number, one: string, few: string, many: string) => {
  const m10 = n % 10, m100 = n % 100;
  return m10 === 1 && m100 !== 11 ? one : m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14) ? few : many;
};
const seatsText = left <= 0
  ? 'Места закончились – напишите, добавлю в лист ожидания'
  : left === seats
    ? `${seats} мест · набор до 6 ноября`
    : `Осталось ${left} ${plural(left, 'место', 'места', 'мест')} из ${seats} · набор до 6 ноября`;
const reviews = [
  { v: 50, name: 'Екатерина', text: 'Оформились мышцы, укрепились суставы, выросла выносливость' },
  { v: 41, name: 'Ксения', text: '−11 кг за 3 месяца и совсем другое внутреннее состояние' },
  { v: 13, name: 'Екатерина', text: '«После курса хочется жить и делать ещё больше»' },
  { v: 54, name: 'Елена', text: 'Выстроила тренировки под сложный посменный график' },
  { v: 40, name: 'Ксения', text: 'Ушли боли в тазобедренных суставах, влезла в старые джинсы' },
  { v: 58, name: 'Дарья', text: 'Взяла себя в руки, вернула энергию и начала бегать' },
  { v: 12, name: 'Варвара', text: 'Укрепление без изнурения, сон стал крепче' },
  { v: 48, name: 'Маргарита', text: 'Привела тело в тонус и вернула вдохновение' },
  { v: 56, name: 'Наталия', text: 'Системный подход без перегруза, лёгкая и задорная атмосфера' },
  { v: 47, name: 'Денис', text: 'Огонь и командный дух на групповых занятиях' },
  { v: 64, name: 'Анна', text: 'Встроила спорт в жизнь, ушли зажимы в плечах и спине' },
  { v: 32, name: 'Кристина', text: 'Прошла курс до конца, ушёл лишний вес, поясница перестала болеть' },
  { v: 14, name: 'Мария', text: 'Прилив сил после каждого занятия, спина гибкая и лёгкая' },
  { v: 18, name: 'Алина', text: 'База и варианты – каждый нашёл свою точку роста' },
  { v: 60, name: 'Анна', text: 'Теорию перенесла в практику, занимается намного чаще' },
  { v: 7, name: 'Ольга', text: 'Боль ушла на 1–2 неделе, энергии прибавилось' },
  { v: 57, name: 'Надежда', text: 'Системный подход для любого уровня подготовки' },
  { v: 16, name: 'Дарья', text: 'Стало легче держать спину и просто ходить по жизни' },
  { v: 53, name: 'Сергей', text: 'Укрепил «спящие» мышцы, тело работает цельнее' },
];
---
<SiteLayout
  title="Групповое ведение – Алексей Ларин"
  description="8 недель тренировок дома в группе до 7 человек: свой план, разбор каждую субботу и поддержка в чате. Старт 7 ноября, 9 900 ₽."
  active="gruppa">

  <!-- ПЕРВЫЙ ЭКРАН -->
  <section class="gp-hero">
    <div class="gp-hero-text">
      <p class="gp-eyebrow"><span class="dot"></span>Групповое ведение · старт 7 ноября</p>
      <h1>Войти в Новый год <em>сильнее</em></h1>
      <p class="gp-sub">8 недель тренировок дома: я составлю план под вас, по субботам разберём неделю на общем созвоне, а в чате я на связи</p>
      <div class="gp-params">
        <div><b>8</b><span>недель</span></div>
        <div><b>до {seats}</b><span>человек в группе</span></div>
        <div><b>9 900 ₽</b><span>за всё время · можно частями</span></div>
      </div>
      <div class="gp-cta">
        <a href="#zapis" class="btn-main">Записаться в группу ↓</a>
      </div>
      <p class="gp-safe">{seatsText}</p>
    </div>
    <div class="gp-hero-photo">
      <picture>
        <source type="image/webp" srcset="/img/IMG_3934.webp 1x, /img/IMG_3934@2x.webp 2x" />
        <img src="/img/IMG_3934.jpg" srcset="/img/IMG_3934.jpg 1x, /img/IMG_3934@2x.jpg 2x" alt="Алексей Ларин" width="1155" height="1733" loading="eager" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <!-- ЗНАКОМО? -->
  <section class="gp-section">
    <div class="gp-inner">
      <p class="gp-label">Для кого</p>
      <h2>Если вам <em>знакомо</em></h2>
      <div class="gp-cards3">
        <div class="gp-card">
          <h3>Начинали много раз</h3>
          <p>Абонемент, марафон, приложение – и через пару недель всё сходит на нет. Одному держать ритм трудно, и это нормально.</p>
        </div>
        <div class="gp-card">
          <h3>Хочется выглядеть и чувствовать себя лучше</h3>
          <p>Подтянутое тело, больше сил, хороший сон и настроение. Без жёстких диет и тренировок «через не могу».</p>
        </div>
        <div class="gp-card">
          <h3>Нужен понятный план</h3>
          <p>Что делать, сколько и в какие дни – чтобы не гадать каждый раз, а просто открыть план и сделать.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ВМЕСТЕ ЛЕГЧЕ -->
  <section class="gp-together">
    <div class="gp-inner">
      <h2>Вместе путь проходить <em>легче</em></h2>
      <p>Когда в субботу расскажешь группе, как прошла неделя, тренировку пропустить сложнее. А когда видишь, что другие тоже занимаются, – самому хочется.</p>
    </div>
  </section>

  <!-- КАК УСТРОЕНО -->
  <section class="gp-section gp-cream">
    <div class="gp-inner">
      <p class="gp-label">Как это устроено</p>
      <h2>Каждая неделя – <em>по понятному ритму</em></h2>
      <div class="gp-steps">
        <div class="gp-step">
          <div class="gp-num">1</div>
          <div>
            <h3>План на неделю – под вас</h3>
            <p>Я составляю план для каждого: две силовые тренировки дома (третья – по желанию), прогулки и шаги. Упражнения и нагрузка – под ваш уровень и вашу цель. Тренируетесь в удобное время, общих тренировок нет. Нужен только коврик.</p>
          </div>
        </div>
        <div class="gp-step">
          <div class="gp-num">2</div>
          <div>
            <h3>Созвон по субботам в 10:10</h3>
            <p>Каждый рассказывает, как прошла неделя, а я разбираю и подстраиваю нагрузку. В группе не больше {seats} человек – так я успеваю уделить внимание каждому. Не получилось прийти – будет запись.</p>
          </div>
        </div>
        <div class="gp-step">
          <div class="gp-num">3</div>
          <div>
            <h3>Чат группы в Telegram</h3>
            <p>Отмечаетесь после тренировок и задаёте вопросы. Я на связи каждый день. Когда видишь, что другие тоже тренируются, самому заниматься проще.</p>
          </div>
        </div>
        <div class="gp-step">
          <div class="gp-num">4</div>
          <div>
            <h3>Короткий отчёт в конце недели</h3>
            <p>Пара строчек или голосовое: что получилось, что было трудно, как самочувствие. Так я готовлюсь к разбору заранее.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 НЕДЕЛЬ -->
  <section class="gp-section">
    <div class="gp-inner">
      <p class="gp-label">8 недель</p>
      <h2>Два цикла <em>с отдыхом</em></h2>
      <p class="gp-desc">Три недели тренируемся, неделю восстанавливаемся. Отдых – часть системы: в это время тело и становится сильнее.</p>
      <div class="gp-timeline">
        <div class="gp-tl">
          <p class="gp-tl-date">7 – 29 ноября</p>
          <h3>Цикл 1. Осваиваемся</h3>
          <p>7 ноября – первый созвон: знакомимся, и каждый получает свой план. Дальше учимся технике и находим ритм.</p>
        </div>
        <div class="gp-tl gp-tl-rest">
          <p class="gp-tl-date">30 ноября – 6 декабря</p>
          <h3>Неделя отдыха</h3>
          <p>Восстанавливаемся и подводим итоги первого цикла.</p>
        </div>
        <div class="gp-tl">
          <p class="gp-tl-date">7 – 27 декабря</p>
          <h3>Цикл 2. Добавляем</h3>
          <p>Упражнения сложнее, нагрузка выше – вы уже готовы.</p>
        </div>
        <div class="gp-tl gp-tl-rest">
          <p class="gp-tl-date">28 декабря – 3 января</p>
          <h3>Финал</h3>
          <p>Повторяем замеры, сравниваем с началом – и встречаем Новый год с результатом.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ЧЕГО ЖДАТЬ + ЦЕНА -->
  <section class="gp-section gp-cream">
    <div class="gp-inner gp-offer">
      <div class="gp-expect">
        <p class="gp-label">Чего ждать</p>
        <h2>Честно <em>о результате</em></h2>
        <ul class="gp-checks">
          <li><b>Первые 2–3 недели</b> – больше сил, лучше сон и настроение. Тренировки перестают быть подвигом.</li>
          <li><b>К концу 8 недель</b> – тело крепче и подтянутее, одежда сидит иначе. Замеры это покажут.</li>
          <li><b>Главное</b> – у вас остаётся привычка и понятная система, с которой хочется продолжать.</li>
        </ul>
      </div>
      <div class="gp-price">
        <p class="gp-price-label">Что входит</p>
        <ul>
          <li>Анкета и простые замеры до старта – талия, вес, задержка дыхания. Фото – только по желанию</li>
          <li>Ваш план на каждую неделю</li>
          <li>Созвоны по субботам с разбором + записи</li>
          <li>Чат группы, я на связи каждый день</li>
          <li>В конце повторяем замеры и видим ваш результат в цифрах</li>
        </ul>
        <div class="gp-price-sum">9 900 ₽</div>
        <p class="gp-price-note">за 8 недель – около 1 240 ₽ в неделю<br>цена первого потока</p>
        <a href="#zapis" class="btn-main btn-full">Записаться</a>
        <p class="gp-price-seats">{seatsText}</p>
        <p class="gp-price-refund">Не подойдёт после первой недели – верну деньги полностью</p>
        <p class="gp-price-ways">Оплатить можно как удобно – картой, по СБП, частями или в рассрочку. Например, 4 платежа по 2 475 ₽ через «Долями». Оптимальный для себя способ выберете на странице оплаты.</p>
      </div>
    </div>
  </section>

  <!-- КТО ВЕДЁТ -->
  <section class="gp-author">
    <div class="gp-author-photo">
      <picture>
        <source type="image/webp" srcset="/img/gruppa-trenirovka@2x.webp" />
        <img src="/img/gruppa-trenirovka@2x.jpg" alt="Алексей Ларин поправляет упражнение на тренировке" width="590" height="690" loading="lazy" />
      </picture>
    </div>
    <div class="gp-author-text">
      <p class="gp-label">Кто ведёт</p>
      <h2>Алексей Ларин</h2>
      <p class="gp-quote">Тренировки, после которых хочется жить.</p>
      <p>Больше 10 лет тренирую детей и взрослых, магистр Российского университета спорта «ГЦОЛИФК». За это время со мной занимались больше 8 000 человек – на курсах, в детских лагерях, на групповых и личных занятиях.</p>
      <p>Работаю с людьми любого уровня – от тех, кто начинает с нуля, до тех, кто давно тренируется. Нагрузку всегда подбираю под человека.</p>
      <p>В тренировках соединяю силовые, бег и йогу – и обязательно отдых.</p>
    </div>
  </section>

  <!-- ОТЗЫВЫ -->
  <section class="gp-section">
    <div class="gp-inner">
      <p class="gp-label gp-center">Отзывы</p>
      <h2 class="gp-center">Люди, которые <em>начали</em></h2>
      <div class="gp-reviews-wrap"><ReviewsCarousel reviews={reviews} /></div>
      <p class="gp-center gp-more"><a href="/results">Все отзывы →</a></p>
    </div>
  </section>

  <!-- ПОДОЙДЁТ / НЕ ПОДОЙДЁТ -->
  <section class="gp-section gp-cream">
    <div class="gp-inner gp-fit">
      <div class="gp-fit-col">
        <h3>Подойдёт, если</h3>
        <ul>
          <li>хотите регулярно тренироваться и прийти к своей цели – выглядеть лучше, стать сильнее и энергичнее;</li>
          <li>нужны план, поддержка и обратная связь;</li>
          <li>готовы заниматься 2 раза в неделю.</li>
        </ul>
      </div>
      <div class="gp-fit-col gp-fit-no">
        <h3>Не подойдёт, если</h3>
        <ul>
          <li>сейчас острая боль или недавняя операция без разрешения врача;</li>
          <li>нужен результат за две недели;</li>
          <li>нет возможности заниматься 2 раза в неделю.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ВОПРОСЫ -->
  <section class="gp-section">
    <div class="gp-inner gp-faq">
      <p class="gp-label gp-center">Вопросы</p>
      <h2 class="gp-center">Что обычно <em>спрашивают</em></h2>
      <details><summary>Я совсем без формы – справлюсь?</summary><p>Да. План собираю под ваш уровень, у каждого упражнения есть вариант полегче. Задача – начать и втянуться.</p></details>
      <details><summary>Что нужно для тренировок?</summary><p>Коврик и немного места дома. Если есть гиря и это подходит под ваши задачи – добавим её.</p></details>
      <details><summary>Сколько времени занимает тренировка?</summary><p>Обычно 30–40 минут – зависит от вашего плана. На тяжёлые недели есть короткий план-минимум.</p></details>
      <details><summary>А если не смогу прийти на созвон?</summary><p>Будет запись. Отчёт и вопросы – в чате, я отвечу.</p></details>
      <details><summary>Я живу не в Москве</summary><p>Всё проходит онлайн. Созвон – по субботам в 10:10 по московскому времени.</p></details>
      <details><summary>Как записаться и оплатить?</summary><p>Напишите мне в Telegram или Max. Я отвечу на вопросы, забронирую место и пришлю ссылку на оплату. После оплаты придёт короткая анкета – по ней я соберу ваш первый план.</p></details>
      <details><summary>Можно оплатить частями?</summary><p>Да. На странице оплаты можно выбрать «Долями» – 4 платежа по 2 475 ₽, Сплит или рассрочку. Выбирайте, как удобно.</p></details>
      <details><summary>Можно вернуть деньги?</summary><p>Да. Если после первой недели поймёте, что формат не ваш, – верну деньги полностью.</p></details>
    </div>
  </section>

  <!-- ЗАПИСЬ -->
  <section class="gp-section gp-cream" id="zapis">
    <div class="gp-inner gp-form-wrap">
      <p class="gp-label gp-center">Запись</p>
      <h2 class="gp-center">Напишите – <em>забронирую место</em></h2>
      <ol class="gp-how">
        <li><b>Напишите мне в Telegram</b> (или в Max) – пару слов о себе и своей цели</li>
        <li><b>Отвечу на вопросы</b>, забронирую место и пришлю ссылку на оплату</li>
        <li><b>После оплаты</b> придёт короткая анкета – по ней я соберу ваш первый план, а 7 ноября – первый созвон</li>
      </ol>
      <a href={TG_JOIN} class="btn-main btn-full" target="_blank" rel="noopener" data-goal="messenger_click">Написать в Telegram</a>
      <a href={MAX} class="gp-max" target="_blank" rel="noopener" data-goal="messenger_click">Нет Telegram – написать в Max</a>
      <p class="gp-alt">Обычно отвечаю в течение дня · можно оплатить частями · {seatsText}</p>

      <details class="gp-leave">
        <summary>Нет мессенджеров? <span>Оставьте контакт</span> – я напишу сам</summary>
        <form id="lead-form" class="gp-form" data-source="gruppa" novalidate>
          <input type="text" name="homepage" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="gp-row">
            <input class="gp-input" name="name" placeholder="Ваше имя" autocomplete="name" required />
            <input class="gp-input" name="contact" placeholder="Телефон или почта" required />
          </div>
          <textarea class="gp-input" name="message" rows="3" placeholder="Чего хотите добиться за 8 недель (по желанию)"></textarea>
          <label class="gp-consent">
            <input type="checkbox" name="consent_pd" value="1" required />
            <span>Согласен с <a href="/legal/privacy" target="_blank" rel="noopener">обработкой персональных данных</a></span>
          </label>
          <button type="submit" class="btn-main btn-full">Отправить</button>
          <p class="gp-note" id="lead-note"></p>
        </form>
      </details>

      <!-- Оплата: скрыта, открывается по ссылке /gruppa#oplata, которую Алексей присылает после переписки -->
      <div class="gp-pay" id="oplata" hidden>
        <h3>Оплата участия – 9 900 ₽</h3>
        <p class="gp-pay-ways">Оплатить можно как удобно – картой, по СБП, частями или в рассрочку. Например, 4 платежа по 2 475 ₽ через «Долями». Оптимальный для себя способ выберете на странице оплаты.</p>
        <form id="pay-form" novalidate>
          <input type="text" name="homepage" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="gp-row">
            <input class="gp-input" name="name" placeholder="Ваше имя" autocomplete="name" required />
            <input class="gp-input" name="email" type="email" placeholder="Почта – на неё придёт анкета" autocomplete="email" required />
          </div>
          <label class="gp-consent">
            <input type="checkbox" name="consent_pd" required />
            <span>Даю <a href="/legal/consent" target="_blank" rel="noopener">согласие на обработку персональных данных</a></span>
          </label>
          <label class="gp-consent">
            <input type="checkbox" name="offer" required />
            <span>Принимаю условия <a href="/legal/offer" target="_blank" rel="noopener">оферты</a></span>
          </label>
          <button type="submit" class="btn-main btn-full">Оплатить 9 900 ₽</button>
          <p class="gp-note" id="pay-note"></p>
        </form>
        <p class="gp-pay-safe">После оплаты на почту придёт короткая анкета – по ней я соберу ваш первый план.</p>
      </div>
    </div>
  </section>


  <script>
    // Нажатия на «Написать в Telegram / Max» – цель Метрики messenger_click.
    document.querySelectorAll<HTMLElement>('[data-goal]').forEach((a) =>
      a.addEventListener('click', () => (window as any).reachGoal?.(a.dataset.goal)));

    // Скрытый блок оплаты открывается по ссылке /gruppa#oplata.
    const payBox = document.getElementById('oplata');
    const showPay = () => {
      if (!payBox || location.hash !== '#oplata') return;
      payBox.hidden = false;
      payBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    showPay();
    window.addEventListener('hashchange', showPay);

    // Заявка → POST /api/leads (CSRF подставляет обёртка fetch из SiteLayout).
    const lead = document.getElementById('lead-form') as HTMLFormElement | null;
    lead?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const note = document.getElementById('lead-note') as HTMLElement;
      const btn = lead.querySelector('button[type="submit"]') as HTMLButtonElement;
      const say = (m: string, err = false) => { note.textContent = m; note.classList.toggle('is-error', err); };
      const fd = new FormData(lead);
      const name = String(fd.get('name') || '').trim();
      const contact = String(fd.get('contact') || '').trim();
      if (!name) return say('Укажите имя', true);
      if (contact.length < 5) return say('Укажите телефон или почту – как с вами связаться', true);
      if (!fd.get('consent_pd')) return say('Чтобы продолжить, отметьте согласие', true);
      btn.disabled = true; const orig = btn.textContent; btn.textContent = 'Отправляем…';
      try {
        const r = await fetch('/api/leads', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
          body: JSON.stringify({ name, contact, message: String(fd.get('message') || '').trim(), source: 'gruppa', consent_pd: true, homepage: String(fd.get('homepage') || '') }),
        });
        if (r.ok) {
          (window as any).reachGoal?.('lead_submit');
          const box = document.createElement('div');
          box.className = 'gp-success';
          box.innerHTML = '<h3>Получил, спасибо!</h3><p>Напишу вам в течение дня, отвечу на вопросы и пришлю ссылку на оплату.</p>';
          lead.replaceWith(box);
          return;
        }
        say('Не получилось отправить – попробуйте ещё раз или напишите в Telegram', true);
      } catch { say('Ошибка сети – попробуйте ещё раз', true); }
      finally { btn.disabled = false; btn.textContent = orig; }
    });

    // Оплата → POST /api/checkout/service → Продамус.
    const pay = document.getElementById('pay-form') as HTMLFormElement | null;
    pay?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const note = document.getElementById('pay-note') as HTMLElement;
      const btn = pay.querySelector('button[type="submit"]') as HTMLButtonElement;
      const say = (m: string, err = false) => { note.textContent = m; note.classList.toggle('is-error', err); };
      const fd = new FormData(pay);
      const name = String(fd.get('name') || '').trim();
      const email = String(fd.get('email') || '').trim();
      if (!name) return say('Укажите имя', true);
      if (!email.includes('@') || !email.includes('.')) return say('Проверьте адрес почты', true);
      if (!fd.get('consent_pd')) return say('Чтобы продолжить, отметьте согласие', true);
      if (!fd.get('offer')) return say('Чтобы продолжить, примите условия оферты', true);
      btn.disabled = true; const orig = btn.textContent; btn.textContent = 'Готовим оплату…';
      try {
        const r = await fetch('/api/checkout/service', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
          body: JSON.stringify({ service: 'gruppa', name, email, consent_pd: true, homepage: String(fd.get('homepage') || '') }),
        });
        const d = await r.json().catch(() => ({}));
        if (r.ok && d.url) { (window as any).reachGoal?.('checkout_gruppa'); location.href = d.url; return; }
        if (d.error === 'sold_out') say('Места закончились – напишите мне, добавлю в лист ожидания: если кто-то откажется, место ваше', true);
        else say('Не получилось открыть оплату – напишите мне, разберёмся', true);
      } catch { say('Ошибка сети – попробуйте ещё раз', true); }
      finally { btn.disabled = false; btn.textContent = orig; }
    });
  </script>
</SiteLayout>
