    .gp-faq summary:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; border-radius: 14px; }
    .gp-faq details p { margin: 0; padding: 0 24px 20px; font-size: 16px; line-height: 1.7; color: var(--text-muted, #555); }

    .gp-form-wrap { max-width: 600px; }
    .gp-how { list-style: none; counter-reset: how; padding: 0; margin: 30px 0 30px; display: flex; flex-direction: column; gap: 14px; }
    .gp-how li { counter-increment: how; position: relative; padding: 4px 0 4px 54px; font-size: 17px; line-height: 1.6; color: var(--text-mid, #3a3a3a); }
    .gp-how li::before { content: counter(how); position: absolute; left: 0; top: 0; width: 38px; height: 38px; border-radius: 50%; background: var(--navy); color: white; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .gp-how b { color: var(--navy); }
    .gp-max { display: block; text-align: center; margin: 14px 0 0; color: var(--navy); font-weight: 600; font-size: 16px; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(26,39,68,.3); transition: color .2s; }
    .gp-max:hover { color: var(--orange); }
    .gp-leave { margin-top: 28px; text-align: center; }
