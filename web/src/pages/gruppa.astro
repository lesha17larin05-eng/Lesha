  </style>

  <script>
    // Скрытый блок оплаты открывается по ссылке /gruppa#oplata.
    const payBox = document.getElementById('oplata');
    const showPay = () => {
      if (!payBox || location.hash !== '#oplata') return;
      payBox.hidden = false;
      payBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    showPay();
    window.addEventListener('hashchange', showPay);

    // Заявка → POST /api/leads (CSRF подставляет обёртка fetch из SiteLayout).
    const lead = document.getElementById('lead-form') as HTMLFormElement | null;
    lead?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const note = document.getElementById('lead-note') as HTMLElement;
      const btn = lead.querySelector('button[type="submit"]') as HTMLButtonElement;
      const say = (m: string, err = false) => { note.textContent = m; note.classList.toggle('is-error', err); };
      const fd = new FormData(lead);
      const name = String(fd.get('name') || '').trim();
      const contact = String(fd.get('contact') || '').trim();
      if (!name) return say('Укажите имя', true);
      if (contact.length < 5) return say('Укажите телефон или почту – как с вами связаться', true);
      if (!fd.get('consent_pd')) return say('Чтобы продолжить, отметьте согласие', true);
      btn.disabled = true; const orig = btn.textContent; btn.textContent = 'Отправляем…';
      try {
        const r = await fetch('/api/leads', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
          body: JSON.stringify({ name, contact, message: String(fd.get('message') || '').trim(), source: 'gruppa', consent_pd: true }),
        });
        if (r.ok) {
          (window as any).reachGoal?.('lead_submit');
          const box = document.createElement('div');
          box.className = 'gp-success';
          box.innerHTML = '<h3>Получил 🙌</h3><p>Напишу вам в течение дня, отвечу на вопросы и пришлю ссылку на оплату.</p>';
          lead.replaceWith(box);
          return;
        }
        say('Не получилось отправить – попробуйте ещё раз или напишите в Telegram', true);
      } catch { say('Ошибка сети – попробуйте ещё раз', true); }
      finally { btn.disabled = false; btn.textContent = orig; }
    });

    // Оплата → POST /api/checkout/service → Продамус.
    const pay = document.getElementById('pay-form') as HTMLFormElement | null;
    pay?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const note = document.getElementById('pay-note') as HTMLElement;
      const btn = pay.querySelector('button[type="submit"]') as HTMLButtonElement;
      const say = (m: string, err = false) => { note.textContent = m; note.classList.toggle('is-error', err); };
      const fd = new FormData(pay);
      const name = String(fd.get('name') || '').trim();
      const email = String(fd.get('email') || '').trim();
      if (!name) return say('Укажите имя', true);
      if (!email.includes('@') || !email.includes('.')) return say('Проверьте адрес почты', true);
      if (!fd.get('consent_pd')) return say('Чтобы продолжить, отметьте согласие', true);
      btn.disabled = true; const orig = btn.textContent; btn.textContent = 'Готовим оплату…';
      try {
        const r = await fetch('/api/checkout/service', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
          body: JSON.stringify({ service: 'gruppa', name, email, consent_pd: true }),
        });
        const d = await r.json().catch(() => ({}));
        if (r.ok && d.url) { (window as any).reachGoal?.('checkout_gruppa'); location.href = d.url; return; }
        if (d.error === 'sold_out') say('Все места в этом потоке заняты – напишите мне, запишу в следующий', true);
        else say('Не получилось открыть оплату – напишите мне, разберёмся', true);
      } catch { say('Ошибка сети – попробуйте ещё раз', true); }
      finally { btn.disabled = false; btn.textContent = orig; }
    });
  </script>
</SiteLayout>
