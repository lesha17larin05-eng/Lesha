    @media (hover: hover) { .gp-faq details:hover { border-color: rgba(232,101,42,.35); } }
    .gp-faq summary { cursor: pointer; list-style: none; padding: 20px 24px; font-size: 17px; font-weight: 600; color: var(--navy); position: relative; padding-right: 50px; }
