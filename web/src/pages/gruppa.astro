      .gp-params b { font-size: 28px; }
      .gp-cta { flex-direction: column; align-items: stretch; }
      .gp-cta .btn-main { width: 100%; }
      .gp-ask { text-align: center; }
      .gp-steps, .gp-timeline, .gp-fit, .gp-row { grid-template-columns: 1fr; }
      .gp-step { padding: 22px; }
      .gp-author-text { padding: 48px 20px; }
