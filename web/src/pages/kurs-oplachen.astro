---
import SiteLayout from '../layouts/SiteLayout.astro';
import { apiJson } from '../lib/api';
// Куда человек попадает после оплаты курса, купленного в один шаг
// (POST /api/courses/{slug}/quick-checkout → Продамус → urlSuccess сюда).
//
// Продамус возвращает покупателя сразу, а подтверждение оплаты (webhook)
// приходит отдельно – обычно через секунды, иногда позже. Поэтому страница
// не обещает «курс открыт», пока заказ не стал paid: берёт id заказа из
// параметра _payform_order_id (его добавляет Продамус) и опрашивает
// GET /api/orders/{id}/status.
const user = (Astro.locals as any).user;
const slug = (Astro.url.searchParams.get('course') || '').replace(/[^a-z0-9-]/g, '');
const cabinet = slug ? `/cabinet/${slug}` : '/cabinet';
const orderId = (Astro.url.searchParams.get('_payform_order_id') || Astro.url.searchParams.get('order') || '')
  .replace(/[^0-9a-f-]/gi, '').slice(0, 36);

let status = '';
let emailHint = '';
if (orderId) {
  const cookie = Astro.request.headers.get('cookie') || '';
  // Продамус вернул с отметкой «успешно» – запоминаем момент возврата:
  // если подтверждение не придёт за 10 минут, Алексею уйдёт уведомление.
  const returned = Astro.url.searchParams.get('_payform_status') === 'success' ? '?returned=1' : '';
  const { data, status: code } = await apiJson<any>(`/api/orders/${orderId}/status${returned}`, { cookie });
  if (code === 200) {
    status = data?.status || '';
    emailHint = data?.email_hint || '';
  }
}
// Без id заказа (старые ссылки) показываем прежний текст про письмо.
const paid = status === 'paid' || !orderId;
const tg = 'https://t.me/larin_lesha';
---
<SiteLayout title="Оплата курса – Алексей Ларин" padTop={true} noindex={true}>
  <section class="container paid" data-order={orderId} data-status={status} data-logged={user ? '1' : ''} data-cabinet={cabinet}>

    <div class="st st-paid" hidden={!paid}>
      <h1>Оплата прошла, <em>курс открыт</em></h1>
      {user ? (
        <>
          <p>Спасибо! Уроки уже ждут вас в личном кабинете.</p>
          <div class="paid-actions"><a class="btn-primary" href={cabinet}>Перейти к урокам →</a></div>
        </>
      ) : (
        <>
          <p>Спасибо! Мы отправили письмо со ссылкой для входа{emailHint ? <> на <b class="hint">{emailHint}</b></> : ''}. По ней вы зададите пароль и сразу попадёте к урокам. Логин – этот адрес почты.</p>
          <p class="paid-note">Письма нет через 5 минут? Загляните в «Спам» и «Рассылки» или отправьте ссылку ещё раз.</p>
          <div class="paid-actions">
            <a class="btn-primary" href="/auth/forgot">Отправить ссылку ещё раз</a>
            <a class="paid-link" href={`/auth/login?next=${encodeURIComponent(cabinet)}`}>У меня есть пароль – войти</a>
          </div>
        </>
      )}
    </div>

    <div class="st st-wait" hidden={paid}>
      <h1>Оплата прошла, <em>открываем доступ</em></h1>
      <p>Ждём подтверждение от платёжной системы – обычно это несколько секунд. Страница обновится сама.</p>
      <div class="spinner" aria-hidden="true"></div>
    </div>

    <div class="st st-late" hidden>
      <h1>Подтверждение <em>задерживается</em></h1>
      <p>Деньги списаны – не переживайте, доступ не потеряется. Платёжная система ещё не прислала подтверждение, такое иногда бывает. Страница продолжает проверять сама.</p>
      <p>Если доступ не откроется в течение 15 минут – напишите мне в Телеграм, открою вручную.</p>
      <div class="paid-actions"><a class="btn-primary" href={tg} target="_blank" rel="noopener">Написать в Телеграм</a></div>
    </div>

    <p class="paid-note">Вопросы по курсу или оплате – пишите мне в Телеграм <a class="paid-link" href={tg} target="_blank" rel="noopener">@larin_lesha</a>.</p>
  </section>

  <script>
    const root = document.querySelector('.paid') as HTMLElement | null;
    const order = root?.dataset.order;
    if (root && order && root.dataset.status !== 'paid') {
      const show = (name: string) => root.querySelectorAll<HTMLElement>('.st').forEach((el) => { el.hidden = !el.classList.contains('st-' + name); });
      const started = Date.now();
      let late = false;
      const poll = async () => {
        try {
          const r = await fetch(`/api/orders/${order}/status`, { cache: 'no-store' });
          if (r.ok) {
            const d = await r.json();
            if (d.status === 'paid') { location.reload(); return; }
          }
        } catch { /* сеть моргнула – попробуем ещё */ }
        if (!late && Date.now() - started > 45000) { late = true; show('late'); }
        setTimeout(poll, late ? 15000 : 3000);
      };
      setTimeout(poll, 2000);
    }
  </script>

  <style>
    .paid { max-width: 640px; padding: 80px 20px 100px; }
    .paid h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(32px, 4vw, 44px); font-weight: 400; color: var(--navy); margin-bottom: 18px; }
    .paid h1 em { font-style: italic; }
    .paid p { font-size: 17px; line-height: 1.8; color: var(--text-mid); margin-bottom: 14px; }
    .paid .hint { color: var(--navy); white-space: nowrap; }
    .paid-note { font-size: 15px; color: var(--text-muted); }
    .paid-actions { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; margin: 30px 0 24px; }
    .paid-link { font-size: 15px; color: var(--text-muted); text-decoration: underline; text-underline-offset: 3px; transition: color 0.2s; }
    @media (hover: hover) { .paid-link:hover { color: var(--orange); } }
    .paid-link:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
    .st[hidden] { display: none; }
    .spinner { width: 36px; height: 36px; margin: 24px 0 32px; border-radius: 50%; border: 3px solid rgba(232,101,42,0.2); border-top-color: var(--orange); animation: spin 0.9s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .spinner { animation-duration: 3s; } }
  </style>
</SiteLayout>
