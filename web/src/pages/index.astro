---
import SiteLayout from '../layouts/SiteLayout.astro';
import { apiJson } from '../lib/api';

const cookie = Astro.request.headers.get('cookie') || '';
const { data: articlesData } = await apiJson<any[]>('/api/articles?limit=3', { cookie });
const articles = Array.isArray(articlesData) ? articlesData : [];

const servicesGroup = [
  {
    href: '/consultation',
    image: '/img/IMG_3906.jpg',
    image2x: '/img/IMG_3906@2x.jpg',
    imageWebp: '/img/IMG_3906.webp',
    imageWebp2x: '/img/IMG_3906@2x.webp',
    imgPos: 'center 30%',
    eyebrow: 'Консультация',
    title: 'Разберём запрос за один созвон',
    desc: 'Часовая встреча онлайн: поймём что мешает, наметим первые шаги и формат, если захотите идти дальше.',
    cta: 'Записаться',
  },
  {
    href: '/coaching',
    image: '/img/IMG_3979.jpg',
    image2x: '/img/IMG_3979@2x.jpg',
    imageWebp: '/img/IMG_3979.webp',
    imageWebp2x: '/img/IMG_3979@2x.webp',
    imgPos: 'center 22%',
    eyebrow: 'Личное ведение',
    title: 'Три месяца — и другой человек',
    desc: 'Персональный план, тренировки и поддержка между ними. Мягко, в своём ритме, без жёстких нагрузок.',
    cta: 'Узнать подробнее',
  },
];

const coursesGroup = [
  {
    href: '/course',
    image: '/img/IMG_4046.jpg',
    image2x: '/img/IMG_4046@2x.jpg',
    imageWebp: '/img/IMG_4046.webp',
    imageWebp2x: '/img/IMG_4046@2x.webp',
    imgPos: 'center 22%',
    eyebrow: 'Бесплатно',
    title: '«Мягкий старт» — 8 уроков',
    desc: 'От суставной гимнастики до медитации. Каждый урок отдельный — начните с того, что сейчас важно.',
    cta: 'Получить доступ',
  },
  {
    href: '/courses/zdorovaya-spina',
    image: '/img/spina/hero.jpg',
    image2x: '/img/spina/hero@2x.jpg',
    imageWebp: '/img/spina/hero.webp',
    imageWebp2x: '/img/spina/hero@2x.webp',
    imgPos: 'center 35%',
    eyebrow: 'Курс «Здоровая спина»',
    title: 'Три недели — и спина благодарит',
    desc: '11 уроков, теория и практика. Самостоятельно или с поддержкой автора в Телеграме.',
    cta: 'Посмотреть программу',
  },
];

const pageStyles = `
.home-hero {
  position: relative; padding: 120px 80px 80px;
  background: var(--navy);
  overflow: hidden;
  display: grid; grid-template-columns: 1.15fr 1fr; gap: 64px; align-items: center;
  min-height: calc(100vh - 64px);
}
.home-hero::before {
  content: ''; position: absolute; top: -120px; right: 30%;
  width: 520px; height: 520px;
  background: radial-gradient(circle, rgba(46,61,107,0.55) 0%, transparent 65%);
  pointer-events: none;
}
.home-hero::after {
  content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, var(--orange) 0%, transparent 60%);
}
.home-hero-left { position: relative; z-index: 2; }
.home-eyebrow {
  display: inline-flex; align-items: center; gap: 10px; margin-bottom: 28px;
  font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
  color: rgba(255,255,255,0.5);
}
.home-eyebrow::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--orange); }
.home-hero h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(40px, 4.5vw, 64px); font-weight: 400; line-height: 1.08;
  color: white; margin-bottom: 16px; letter-spacing: -0.01em;
}
.home-hero h1 em { font-style: italic; color: #8bb8f0; }
.home-hero-sub {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px; font-weight: 300; font-style: italic;
  color: rgba(255,255,255,0.55); margin-bottom: 36px; line-height: 1.5; max-width: 540px;
}
.home-hero-points {
  display: flex; flex-direction: column; gap: 12px; margin-bottom: 36px;
}
.home-hero-point {
  display: flex; gap: 12px; font-size: 16px; color: rgba(255,255,255,0.78); line-height: 1.65;
}
.home-hero-point::before {
  content: '·'; color: var(--orange); font-size: 24px; line-height: 1.2; flex-shrink: 0;
}
.home-hero-cta { display: flex; gap: 16px; flex-wrap: wrap; align-items: center; }
.btn-hero-primary {
  display: inline-flex; align-items: center; gap: 10px;
  background: var(--orange); color: white; text-decoration: none;
  padding: 18px 36px; border-radius: 100px; font-size: 16px; font-weight: 600;
  transition: all 0.25s; box-shadow: 0 8px 32px rgba(232,101,42,0.35);
}
.btn-hero-primary:hover { background: var(--orange-warm); transform: translateY(-2px); }
.btn-hero-ghost {
  display: inline-flex; align-items: center; gap: 8px;
  color: rgba(255,255,255,0.65); text-decoration: none;
  font-size: 15px; font-weight: 500;
  border-bottom: 1px solid rgba(255,255,255,0.18); padding-bottom: 4px;
  transition: color 0.2s, border-color 0.2s;
}
.btn-hero-ghost:hover { color: white; border-bottom-color: rgba(255,255,255,0.5); }

.home-hero-photo {
  position: relative; z-index: 1;
  border-radius: 24px; overflow: hidden; aspect-ratio: 4 / 5;
  box-shadow: 0 30px 80px rgba(0,0,0,0.35);
}
.home-hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }

/* STATS */
.home-stats {
  padding: 60px 80px; background: var(--cream);
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 60px; text-align: center;
}
.home-stat-num {
  display: block; font-family: 'Cormorant Garamond', serif;
  font-size: 56px; font-weight: 400; color: var(--navy); line-height: 1; margin-bottom: 8px;
}
.home-stat-label { font-size: 14px; color: var(--text-muted); }

/* SECTIONS */
.home-section { padding: 100px 80px; }
.home-section-label {
  display: inline-block; font-size: 13px; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase; color: var(--orange);
  margin-bottom: 16px;
}
.home-section-title {
  font-family: 'Cormorant Garamond', serif; font-weight: 400;
  font-size: clamp(32px, 3.5vw, 48px); line-height: 1.15; color: var(--navy);
  margin-bottom: 16px; max-width: 720px;
}
.home-section-title em { font-style: italic; }
.home-section-desc {
  font-size: 17px; color: var(--text-muted); line-height: 1.75;
  max-width: 620px; margin-bottom: 56px;
}

/* SERVICES (две колонки: Услуги | Курсы, в каждой — 2 карточки в столбик) */
.services-columns {
  display: grid;
  grid-template-columns: 1fr 1px 1fr;
  gap: 48px;
  align-items: stretch;
}
.services-divider {
  width: 1px;
  background: linear-gradient(180deg, transparent 0%, var(--border) 15%, var(--border) 85%, transparent 100%);
}
.services-block { display: flex; flex-direction: column; }
.services-block-head {
  text-align: center;
  margin-bottom: 24px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
}
.services-block-title {
  font-family: 'Cormorant Garamond', serif; font-weight: 500;
  font-size: 28px; color: var(--navy); letter-spacing: -0.005em;
  display: block; margin-bottom: 4px;
}
.services-block-hint { font-size: 13px; color: var(--text-light); display: block; }
.services-grid {
  display: grid; grid-template-columns: 1fr; gap: 20px;
}
/* плавный якорь #services без захода под фикс. шапку */
#services { scroll-margin-top: 80px; }
.service-card {
  background: white; border: 1px solid var(--border); border-radius: 18px;
  overflow: hidden; display: flex; flex-direction: column;
  text-decoration: none; color: inherit;
  transition: transform 0.2s, box-shadow 0.2s;
}
.service-card:hover {
  transform: translateY(-3px); box-shadow: 0 16px 40px rgba(0,0,0,0.07);
}
.service-img { width: 100%; aspect-ratio: 4 / 5; overflow: hidden; background: var(--cream); }
.service-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s; }
.service-card:hover .service-img img { transform: scale(1.04); }
.service-body { padding: 22px 24px; display: flex; flex-direction: column; flex: 1; gap: 10px; }
.service-eyebrow {
  font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--orange);
}
.service-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px; font-weight: 500; color: var(--navy); line-height: 1.2;
}
.service-desc {
  font-size: 14px; color: var(--text-muted); line-height: 1.65; flex: 1;
}
.service-cta {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 13px; font-weight: 600; color: var(--orange);
  margin-top: 4px;
}
.service-cta::after { content: '→'; transition: transform 0.2s; }
.service-card:hover .service-cta::after { transform: translateX(4px); }

/* ABOUT */
.home-about { padding: 100px 80px; background: var(--navy); color: white; display: grid; grid-template-columns: 1fr 1.4fr; gap: 64px; align-items: center; position: relative; overflow: hidden; }
.home-about::before { content: '"'; position: absolute; top: -40px; left: 40px; font-family: 'Cormorant Garamond', serif; font-size: 320px; color: rgba(255,255,255,0.03); line-height: 1; pointer-events: none; }
.home-about-photo { border-radius: 24px; overflow: hidden; aspect-ratio: 3/4; }
.home-about-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
.home-about .home-section-label { color: #7ab0f0; }
.home-about .home-section-title { color: white; }
.home-about-text { font-size: 16px; color: rgba(255,255,255,0.7); line-height: 1.85; margin-bottom: 14px; }
.home-about-pull {
  font-family: 'Cormorant Garamond', serif; font-size: 22px; font-style: italic;
  color: rgba(255,255,255,0.85); padding: 18px 22px; border-left: 3px solid var(--orange);
  background: rgba(255,255,255,0.04); border-radius: 0 12px 12px 0; margin: 18px 0;
  line-height: 1.5;
}

/* ARTICLES */
.home-articles { padding: 100px 80px; background: var(--warm-white); }
.articles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.article-card {
  background: white; border-radius: 18px; border: 1px solid var(--border);
  overflow: hidden; text-decoration: none; color: inherit;
  display: flex; flex-direction: column;
  transition: transform 0.2s, box-shadow 0.2s;
}
.article-card:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(0,0,0,0.07); }
.article-img { width: 100%; aspect-ratio: 16 / 10; background: var(--cream) center/cover no-repeat; }
.article-body { padding: 22px 24px 24px; display: flex; flex-direction: column; flex: 1; }
.article-tag {
  align-self: flex-start; font-size: 11px; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase;
  padding: 3px 10px; border-radius: 100px; margin-bottom: 10px;
  background: #f0e8e0; color: #6a5030;
}
.article-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 20px; color: var(--navy); line-height: 1.3; margin-bottom: 12px; flex: 1;
}
.article-meta { display: flex; align-items: center; justify-content: space-between; font-size: 13px; color: var(--text-light); border-top: 1px solid var(--border); padding-top: 14px; }
.article-read { color: var(--orange); font-weight: 600; }
.see-all { text-align: center; margin-top: 40px; }
.btn-outline {
  display: inline-flex; align-items: center; gap: 8px;
  border: 1.5px solid var(--navy); color: var(--navy);
  padding: 14px 30px; border-radius: 100px; font-size: 15px; font-weight: 600;
  text-decoration: none; transition: all 0.2s;
}
.btn-outline:hover { background: var(--navy); color: white; }

/* TG */
.tg-strip { padding: 60px 80px; background: #eef6ff; }
.tg-strip-inner { display: flex; align-items: center; gap: 32px; max-width: 1000px; margin: 0 auto; }
.tg-strip-icon { width: 64px; height: 64px; border-radius: 50%; background: #2aabee; color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 12px 32px rgba(42,171,238,0.32); }
.tg-strip-icon svg { width: 32px; height: 32px; }
.tg-strip-text { flex: 1; }
.tg-strip-text h3 { font-family: 'Cormorant Garamond', serif; font-size: 26px; font-weight: 500; color: var(--navy); margin-bottom: 6px; }
.tg-strip-text p { font-size: 15px; color: var(--text-muted); }
.tg-strip-btn {
  display: inline-flex; align-items: center; gap: 8px; flex-shrink: 0;
  background: #2aabee; color: white; text-decoration: none;
  padding: 14px 26px; border-radius: 100px; font-size: 15px; font-weight: 600;
  transition: background 0.2s, transform 0.15s;
}
.tg-strip-btn:hover { background: #229ed9; transform: translateY(-1px); }

/* MOBILE */
@media (max-width: 900px) {
  .home-hero { grid-template-columns: 1fr; padding: 80px 24px 60px; gap: 40px; min-height: 0; }
  .home-hero-photo { aspect-ratio: 4 / 3; max-height: 380px; }
  .home-stats { padding: 40px 24px; gap: 32px; grid-template-columns: 1fr; }
  .home-section, .home-about, .home-articles { padding: 60px 24px; }
  .home-about { grid-template-columns: 1fr; gap: 32px; }
  .home-about-photo { max-height: 360px; }
  /* на мобиле — одна колонка, разделитель становится горизонтальной линией */
  .services-columns { grid-template-columns: 1fr; gap: 28px; }
  .services-divider { width: 100%; height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--border) 15%, var(--border) 85%, transparent 100%); }
  .services-grid { grid-template-columns: 1fr; gap: 18px; }
  .service-img { aspect-ratio: 3 / 4; }
  .articles-grid { grid-template-columns: 1fr; }
  .tg-strip { padding: 48px 24px; }
  .tg-strip-inner { flex-direction: column; text-align: center; gap: 20px; }
}
`;
---
<SiteLayout
  title="Алексей Ларин — тренер по здоровью"
  description="Помогаю мягко вернуться к движению и здоровью. Личное ведение, бесплатный курс, программа для спины и консультации."
  active=""
  pageStyles={pageStyles}
>
  <!-- HERO -->
  <section class="home-hero">
    <div class="home-hero-left">
      <div class="home-eyebrow">Тренер по развитию здоровья · с 2017 года</div>
      <h1>Алексей <em>Ларин</em></h1>
      <p class="home-hero-sub">Помогаю мягко вернуться к движению — без изнурительных диет и сложных программ.</p>
      <div class="home-hero-points">
        <div class="home-hero-point">Работаю онлайн с людьми из разных стран и очно — в Москве.</div>
        <div class="home-hero-point">Магистр с отличием Российского университета спорта. 8000+ человек через проекты.</div>
        <div class="home-hero-point">Подход — внимательный к телу, без насилия над собой.</div>
      </div>
      <div class="home-hero-cta">
        <a href="#services" class="btn-hero-primary">Подобрать формат →</a>
        <a href="/course" class="btn-hero-ghost">Попробовать бесплатно</a>
      </div>
    </div>
    <div class="home-hero-photo">
      <picture>
        <source type="image/webp" srcset="/img/IMG_3979.webp 1x, /img/IMG_3979@2x.webp 2x" />
        <img src="/img/IMG_3979.jpg" srcset="/img/IMG_3979.jpg 1x, /img/IMG_3979@2x.jpg 2x" alt="Алексей Ларин" loading="eager" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <!-- STATS -->
  <section class="home-stats">
    <div><span class="home-stat-num">8 лет</span><span class="home-stat-label">в практике</span></div>
    <div><span class="home-stat-num">8000+</span><span class="home-stat-label">человек через проекты</span></div>
    <div><span class="home-stat-num">4</span><span class="home-stat-label">направления работы</span></div>
  </section>

  <!-- SERVICES — 2 колонки: слева Услуги, справа Курсы -->
  <section class="home-section" id="services">
    <div class="home-section-label">Что предлагаю</div>
    <h2 class="home-section-title">Четыре формата — <em>под разный запрос</em></h2>
    <p class="home-section-desc">От часовой консультации до трёхмесячного ведения. Выберите то, что подходит сейчас — по глубине и темпу.</p>

    <div class="services-columns">
      <div class="services-block">
        <div class="services-block-head">
          <div class="services-block-title">Услуги</div>
          <div class="services-block-hint">работаем напрямую</div>
        </div>
        <div class="services-grid">
          {servicesGroup.map(s => (
            <a href={s.href} class="service-card">
              <div class="service-img">
                <picture>
                  <source type="image/webp" srcset={`${s.imageWebp} 1x, ${s.imageWebp2x} 2x`} />
                  <img src={s.image} srcset={`${s.image} 1x, ${s.image2x} 2x`} alt={s.title} loading="lazy" style={`object-position:${s.imgPos}`} />
                </picture>
              </div>
              <div class="service-body">
                <div class="service-eyebrow">{s.eyebrow}</div>
                <div class="service-title">{s.title}</div>
                <div class="service-desc">{s.desc}</div>
                <div class="service-cta">{s.cta}</div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="services-divider" aria-hidden="true"></div>

      <div class="services-block">
        <div class="services-block-head">
          <div class="services-block-title">Курсы</div>
          <div class="services-block-hint">занимаетесь в своём темпе</div>
        </div>
        <div class="services-grid">
          {coursesGroup.map(s => (
            <a href={s.href} class="service-card">
              <div class="service-img">
                <picture>
                  <source type="image/webp" srcset={`${s.imageWebp} 1x, ${s.imageWebp2x} 2x`} />
                  <img src={s.image} srcset={`${s.image} 1x, ${s.image2x} 2x`} alt={s.title} loading="lazy" style={`object-position:${s.imgPos}`} />
                </picture>
              </div>
              <div class="service-body">
                <div class="service-eyebrow">{s.eyebrow}</div>
                <div class="service-title">{s.title}</div>
                <div class="service-desc">{s.desc}</div>
                <div class="service-cta">{s.cta}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="home-about">
    <div class="home-about-photo">
      <picture>
        <source type="image/webp" srcset="/img/spina/story.webp 1x, /img/spina/story@2x.webp 2x" />
        <img src="/img/spina/story.jpg" srcset="/img/spina/story.jpg 1x, /img/spina/story@2x.jpg 2x" alt="Алексей Ларин" loading="lazy" />
      </picture>
    </div>
    <div>
      <div class="home-section-label">Обо мне коротко</div>
      <h2 class="home-section-title">Через движение <em>я научился чувствовать тело</em> — и помогаю это другим</h2>
      <div class="home-about-pull">В 9 лет — перелом трёх позвонков. Именно через движение я восстановился. С тех пор помогаю другим возвращаться к телу.</div>
      <p class="home-about-text">С 2017 года работаю с детьми, взрослыми и людьми старшего возраста. Магистр Российского университета спорта с отличием. Уделяю внимание не только тренировкам, но и тому, как человек чувствует себя в процессе.</p>
      <p class="home-about-text">Не требую бодибилдерских результатов. Хочу, чтобы вы делали то, что приятно — и постепенно ощущали себя лучше с каждым месяцем.</p>
    </div>
  </section>

  <!-- ARTICLES -->
  {articles.length > 0 && (
    <section class="home-articles">
      <div class="home-section-label">Статьи</div>
      <h2 class="home-section-title">О здоровье, теле <em>и привычках</em></h2>
      <p class="home-section-desc">Короткие тексты, основанные на опыте и проверенные временем.</p>

      <div class="articles-grid">
        {articles.map(a => (
          <a href={`/blog/${a.slug}`} class="article-card">
            <div class="article-img" style={a.cover_image_url ? `background-image:url(${a.cover_image_url})` : ''}></div>
            <div class="article-body">
              {a.tag && <span class="article-tag">{a.tag}</span>}
              <div class="article-title">{a.title}</div>
              <div class="article-meta">
                <span>{a.reading_minutes ? `${a.reading_minutes} мин` : 'Читать'}</span>
                <span class="article-read">Читать →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="see-all">
        <a href="/blog" class="btn-outline">Все статьи →</a>
      </div>
    </section>
  )}

  <!-- TELEGRAM -->
  <section class="tg-strip">
