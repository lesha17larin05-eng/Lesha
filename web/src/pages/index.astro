---
import SiteLayout from '../layouts/SiteLayout.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import { apiJson } from '../lib/api';
import { coverPositionsCard } from '../lib/covers';
import '../styles/landing.css';

// Главная: позиционирование → форматы «со мной» и курсы → отзывы → обо мне →
// статьи → Telegram. Стили – общие с лендингами (landing.css, классы gp-*).
const cookie = Astro.request.headers.get('cookie') || '';
const { data: articlesData } = await apiJson<any[]>('/api/articles?limit=3', { cookie });
const articles = Array.isArray(articlesData) ? articlesData : [];

// Пометка «набор до 6 ноября» у группы – пока идёт набор и есть места.
let groupOpen = Date.now() < Date.parse('2026-11-07T00:00:00+03:00');
if (groupOpen) {
  try {
    const { status, data } = await apiJson<{ left: number }>('/api/services/gruppa/seats');
    if (status === 200 && data && data.left <= 0) groupOpen = false;
  } catch {}
}

const formats = [
  {
    href: '/personal', img: '/img/IMG_3989', pos: 'center 20%',
    title: 'Персональные тренировки',
    desc: 'Каждое занятие – со мной, онлайн или у вас дома в Москве.',
    price: 'от 2 700 ₽ за занятие',
  },
  {
    href: '/gruppa', img: '/img/gruppa-trenirovka@2x', single: true, pos: '40% 30%',
    title: 'Групповое ведение',
    desc: '8 недель. Я составлю план под каждого, тренируетесь дома в удобное время, по субботам – общий созвон с разбором.',
    price: '9 900 ₽ за 8 недель',
    badge: groupOpen ? 'Набор до 6 ноября' : '',
  },
  {
    href: '/coaching', img: '/img/IMG_3979', pos: 'center 15%',
    title: 'Личное ведение',
    desc: 'Раз в неделю тренируемся вместе, на остальные дни – мой план для вас и связь в чате.',
    price: 'от 16 000 ₽ в месяц',
  },
];

const courses = [
  { href: '/courses/myagkiy-start', title: 'Мягкий старт', desc: '8 коротких видеоуроков: суставная гимнастика, дыхание, медитация.', tag: 'Бесплатно' },
  { href: '/courses/zdorovaya-spina', title: 'Здоровая спина', desc: '3 недели тренировок для сильной и подвижной спины – сами или с моей поддержкой.', tag: 'Курс' },
  { href: '/courses/zhonglirovanie', title: 'Жонглирование', desc: '8 коротких видео – научитесь жонглировать с нуля.', tag: 'Курс' },
];

const reviews = [
  { v: 64, name: 'Анна', text: 'Встроила спорт в жизнь, ушли зажимы в плечах и спине' },
  { v: 41, name: 'Ксения', text: '−11 кг за 3 месяца и совсем другое внутреннее состояние' },
  { v: 50, name: 'Екатерина', text: 'Оформились мышцы, укрепились суставы, выросла выносливость' },
  { v: 35, name: 'Анна', text: 'Регулярные тренировки, больше энергии, занимаемся всей семьёй' },
  { v: 13, name: 'Екатерина', text: '«После курса хочется жить и делать ещё больше»' },
  { v: 54, name: 'Елена', text: 'Выстроила тренировки под сложный посменный график' },
  { v: 40, name: 'Ксения', text: 'Ушли боли в тазобедренных суставах, влезла в старые джинсы' },
  { v: 58, name: 'Дарья', text: 'Взяла себя в руки, вернула энергию и начала бегать' },
  { v: 43, name: 'Рузана', text: 'Страх после переломов прошёл, начала доверять своему телу' },
  { v: 12, name: 'Варвара', text: 'Укрепление без изнурения, сон стал крепче' },
  { v: 34, name: 'Яна', text: 'Боль в пояснице ушла, семья тренируется вместе' },
  { v: 48, name: 'Маргарита', text: 'Привела тело в тонус и вернула вдохновение' },
  { v: 36, name: 'Алёна', text: 'Позвоночник «кайфанул» уже после первой тренировки' },
  { v: 56, name: 'Наталия', text: 'Системный подход без перегруза, лёгкая и задорная атмосфера' },
];
---
<SiteLayout
  title="Алексей Ларин – тренер по развитию здоровья"
  description="Тренировки, после которых хочется жить: персональные тренировки, групповое и личное ведение онлайн и на дому в Москве. Бесплатный курс «Мягкий старт» и программа для спины."
  active="">

  <!-- ПЕРВЫЙ ЭКРАН -->
  <section class="gp-hero">
    <div class="gp-hero-text">
      <p class="gp-eyebrow"><span class="dot"></span>Алексей Ларин · тренер по развитию здоровья</p>
      <h1>Тренировки, после которых <em>хочется жить</em></h1>
      <p class="gp-sub">Подтянутое тело, больше сил и хорошее самочувствие – начиная с вашего уровня. Онлайн из любой точки или у вас дома в Москве.</p>
      <div class="gp-params">
        <div><b>10+</b><span>лет тренирую</span></div>
        <div><b>8 000+</b><span>человек занимались со мной</span></div>
        <div><b>магистр</b><span>Российского университета спорта «ГЦОЛИФК»</span></div>
      </div>
      <div class="gp-cta">
        <a href="#so-mnoy" class="btn-main">Тренироваться со мной ↓</a>
        <a href="/courses/myagkiy-start" class="hm-ghost">Начать бесплатно</a>
      </div>
    </div>
    <div class="gp-hero-photo">
      <picture>
        <source type="image/webp" srcset="/img/IMG_3936.webp 1x, /img/IMG_3936@2x.webp 2x" />
        <img src="/img/IMG_3936.jpg" srcset="/img/IMG_3936.jpg 1x, /img/IMG_3936@2x.jpg 2x" alt="Алексей Ларин" width="1155" height="1733" loading="eager" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <!-- СО МНОЙ -->
  <section class="gp-section" id="so-mnoy">
    <div class="gp-inner">
      <p class="gp-label">Тренировки со мной</p>
      <h2>Выберите, <em>как удобнее</em></h2>
      <p class="gp-desc">Во всех форматах начинаю с вашего уровня и подбираю нагрузку под цель и самочувствие.</p>
      <div class="hm-formats">
        {formats.map((f) => (
          <a href={f.href} class="hm-format">
            <div class="hm-format-img">
              {f.single
                ? <picture><source type="image/webp" srcset={`${f.img}.webp`} /><img src={`${f.img}.jpg`} alt="" loading="lazy" style={`object-position:${f.pos}`} /></picture>
                : <picture><source type="image/webp" srcset={`${f.img}.webp 1x, ${f.img}@2x.webp 2x`} /><img src={`${f.img}.jpg`} srcset={`${f.img}.jpg 1x, ${f.img}@2x.jpg 2x`} alt="" loading="lazy" style={`object-position:${f.pos}`} /></picture>}
              {f.badge && <span class="hm-badge">{f.badge}</span>}
            </div>
            <div class="hm-format-body">
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
              <p class="hm-price">{f.price}</p>
              <span class="hm-go">Подробнее →</span>
            </div>
          </a>
        ))}
      </div>

      <h3 class="hm-sub">Или сами, в своём темпе</h3>
      <div class="hm-courses">
        {courses.map((c) => (
          <a href={c.href} class="hm-course">
            <span class="hm-tag">{c.tag}</span>
            <h4>{c.title}</h4>
            <p>{c.desc}</p>
            <span class="hm-go">Подробнее →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ОТЗЫВЫ -->
  <section class="gp-section gp-cream">
    <div class="gp-inner">
      <p class="gp-label gp-center">Отзывы</p>
      <h2 class="gp-center">Люди, которые <em>начали</em></h2>
      <div class="gp-reviews-wrap"><ReviewsCarousel reviews={reviews} /></div>
      <p class="gp-center gp-more"><a href="/results">Все отзывы →</a></p>
    </div>
  </section>

  <!-- ОБО МНЕ -->
  <section class="gp-author">
    <div class="gp-author-photo">
      <picture>
        <source type="image/webp" srcset="/img/spina/story.webp 1x, /img/spina/story@2x.webp 2x" />
        <img src="/img/spina/story.jpg" srcset="/img/spina/story.jpg 1x, /img/spina/story@2x.jpg 2x" alt="Алексей Ларин" loading="lazy" />
      </picture>
    </div>
    <div class="gp-author-text">
      <p class="gp-label">Обо мне</p>
      <h2>Алексей Ларин</h2>
      <p class="gp-quote">Через движение я научился чувствовать тело – и помогаю в этом другим.</p>
      <p>Сам восстанавливался после травм спины и плеча – через движение. Знаю этот путь изнутри.</p>
      <p>Больше 10 лет тренирую детей и взрослых, магистр Российского университета спорта «ГЦОЛИФК». За это время со мной занимались больше 8 000 человек – на курсах, в детских лагерях, на групповых и личных занятиях.</p>
      <p>Не требую бодибилдерских результатов. Хочу, чтобы вы делали то, что приятно, – и постепенно ощущали себя лучше с каждым месяцем.</p>
    </div>
  </section>

  <!-- СТАТЬИ -->
  {articles.length > 0 && (
    <section class="gp-section">
      <div class="gp-inner">
        <p class="gp-label">Статьи</p>
        <h2>О здоровье, теле <em>и привычках</em></h2>
        <div class="hm-articles">
          {articles.map((a) => (
            <a href={`/blog/${a.slug}`} class="hm-article">
              <div class="hm-article-img" style={a.cover_image_url ? `background-image:url(${a.cover_image_url});background-position:${coverPositionsCard[a.slug] ?? 'center center'}` : ''}></div>
              <div class="hm-article-body">
                {a.tag && <span class="hm-tag">{a.tag}</span>}
                <h4>{a.title}</h4>
                <p class="hm-article-meta"><span>{a.reading_minutes ? `${a.reading_minutes} мин` : ''}</span><span class="hm-go">Читать →</span></p>
              </div>
            </a>
          ))}
        </div>
        <p class="gp-center gp-more"><a href="/blog">Все статьи →</a></p>
      </div>
    </section>
  )}

  <!-- TELEGRAM -->
  <section class="gp-section gp-cream">
    <div class="gp-inner hm-tg">
      <div>
        <h2>Пока присматриваетесь – <em>загляните в канал</em></h2>
        <p class="gp-desc">Короткие заметки про движение, сон, питание и привычки.</p>
      </div>
      <a href="https://t.me/lesha_larin" target="_blank" rel="noopener" class="btn-main">Подписаться в Telegram</a>
    </div>
  </section>

  <style>
    .hm-ghost { display: inline-flex; align-items: center; padding: 15px 28px; border-radius: 100px; border: 1.5px solid rgba(255,255,255,.55); color: white; text-decoration: none; font-size: 17px; font-weight: 600; transition: border-color .2s, background .2s; }
    .hm-ghost:hover { border-color: white; background: rgba(255,255,255,.08); }
    .hm-ghost:focus-visible { outline: 2px solid white; outline-offset: 3px; }

    .hm-formats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .hm-format { display: flex; flex-direction: column; background: white; border: 1px solid var(--border, #ece8e0); border-radius: 22px; overflow: hidden; text-decoration: none; color: inherit; transition: transform .2s, box-shadow .2s; }
    @media (hover: hover) { .hm-format:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(26,39,68,.09); } }
    .hm-format:focus-visible, .hm-course:focus-visible, .hm-article:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
    .hm-format-img { position: relative; aspect-ratio: 4 / 3; background: #d9dde3; overflow: hidden; }
    .hm-format-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .hm-badge { position: absolute; top: 14px; left: 14px; background: var(--orange); color: white; font-size: 15px; font-weight: 600; padding: 6px 14px; border-radius: 100px; }
    .hm-format-body { padding: 24px 26px 26px; display: flex; flex-direction: column; flex: 1; }
    .hm-format h3 { font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 30px; line-height: 1.15; color: var(--navy); margin: 0 0 10px; }
    .hm-format p { font-size: 17px; line-height: 1.65; color: var(--text-muted, #555); margin: 0 0 14px; }
    .hm-format .hm-price { font-weight: 700; color: var(--navy); margin: auto 0 0; }
    .hm-go { margin-top: 12px; font-weight: 600; font-size: 16px; color: var(--orange); }

    .hm-sub { font-size: 21px; font-weight: 600; color: var(--navy); margin: 56px 0 20px; }
    .hm-courses { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .hm-course { display: flex; flex-direction: column; align-items: flex-start; background: var(--cream, #f8f5ef); border: 1px solid var(--border, #ece8e0); border-radius: 18px; padding: 24px 24px 22px; text-decoration: none; color: inherit; transition: border-color .2s, transform .2s; }
    @media (hover: hover) { .hm-course:hover { border-color: rgba(232,101,42,.45); transform: translateY(-2px); } }
    .hm-tag { font-size: 15px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--orange); margin-bottom: 8px; }
    .hm-course h4 { font-size: 20px; font-weight: 600; color: var(--navy); margin: 0 0 8px; }
    .hm-course p { font-size: 17px; line-height: 1.6; color: var(--text-muted, #555); margin: 0; flex: 1; }

    .hm-articles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 36px; }
    .hm-article { display: flex; flex-direction: column; background: white; border: 1px solid var(--border, #ece8e0); border-radius: 18px; overflow: hidden; text-decoration: none; color: inherit; transition: transform .2s, box-shadow .2s; }
    @media (hover: hover) { .hm-article:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(26,39,68,.08); } }
    .hm-article-img { aspect-ratio: 16 / 10; background: var(--cream, #f8f5ef) center / cover no-repeat; }
    .hm-article-body { padding: 20px 22px 22px; display: flex; flex-direction: column; flex: 1; }
    .hm-article h4 { font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 24px; line-height: 1.25; color: var(--navy); margin: 0 0 14px; flex: 1; }
    .hm-article-meta { display: flex; justify-content: space-between; align-items: center; font-size: 15px; color: var(--text-light, #6e6e6e); border-top: 1px solid var(--border, #ece8e0); padding-top: 12px; margin: 0; }
    .hm-article-meta .hm-go { margin: 0; }

    .hm-tg { display: flex; align-items: center; justify-content: space-between; gap: 32px; }
    .hm-tg .gp-desc { margin: 0; }
    .hm-tg .btn-main { flex-shrink: 0; }

    @media (max-width: 1000px) {
      .hm-formats, .hm-courses, .hm-articles { grid-template-columns: 1fr; }
      .hm-tg { flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 700px) {
      .hm-ghost { justify-content: center; }
      .hm-format h3 { font-size: 28px; }
      .hm-tg .btn-main { width: 100%; }
    }
  </style>
</SiteLayout>
