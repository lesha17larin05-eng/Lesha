---
import Base from '../../../layouts/Base.astro';
import { apiJson } from '../../../lib/api';

const id = Astro.params.id;
const cookie = Astro.request.headers.get('cookie') || '';
const { status, data } = await apiJson<any>(`/api/admin/articles/${id}`, { cookie });
if (status !== 200 || !data) {
  return new Response('Not found', { status: 404 });
}
const user = (Astro.locals as any).user;
---
<Base title={`Редактировать: ${data.title}`} user={user}>
  <section class="container" style="padding:50px 0;">
    <a href="/admin/blog" class="muted">← Список статей</a>
    <h1 style="margin-top:8px;">Редактирование статьи</h1>
    <article-editor data-mode="edit" data-id={id} data-article={JSON.stringify(data)}></article-editor>
  </section>
  <script is:inline src="/admin-blog-editor.js"></script>
</Base>
