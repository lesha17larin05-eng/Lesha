---
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import { apiJson } from '../../lib/api';
const cookie = Astro.request.headers.get('cookie') || '';
const search = Astro.url.searchParams.get('search') || '';
const course = Astro.url.searchParams.get('course') || '';
const verified = Astro.url.searchParams.get('verified') || '';
const sort = Astro.url.searchParams.get('sort') || '';

const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);

const qs = new URLSearchParams();
if (search) qs.set('search', search);
if (course) qs.set('course', course);
if (verified) qs.set('verified', verified);
if (sort) qs.set('sort', sort);
if (page > 1) qs.set('page', String(page));
const { data: resp } = await apiJson<any>(`/api/admin/users?${qs.toString()}`, { cookie });
const data = Array.isArray(resp?.users) ? resp.users : [];
const total: number = resp?.total ?? data.length;
const perPage: number = resp?.per_page ?? 50;
const pages = Math.max(1, Math.ceil(total / perPage));
const pageUrl = (p: number) => {
  const u = new URLSearchParams(qs);
  if (p > 1) u.set('page', String(p)); else u.delete('page');
  const s = u.toString();
  return '/admin/users' + (s ? '?' + s : '');
};

// курсы для фильтра
const { data: coursesData } = await apiJson<any[]>('/api/admin/courses', { cookie });
const courses = Array.isArray(coursesData) ? coursesData : [];
const user = (Astro.locals as any).user;
---
<Base title="Пользователи" user={user}>
  <AdminNav active="users" />
  <section class="container" style="padding:50px 16px;">
    <h1>Пользователи</h1>

    <details class="anketa-new">
      <summary>Анкета перед занятием для клиента</summary>
      <p class="muted">Для тех, кто платит напрямую. Если человека ещё нет на сайте – заведём аккаунт по почте
        (без пароля и без подписки на письма). Ответы придут вам на почту и появятся в его карточке.</p>
      <form id="anketa-new-form">
        <input name="name" placeholder="Имя" />
        <input name="email" type="email" placeholder="Email клиента" required />
        <button type="submit" data-send="0">Получить ссылку</button>
        <button type="submit" data-send="1">Отправить письмом</button>
      </form>
      <p id="anketa-new-result" class="muted"></p>
    </details>
    <form method="get" class="users-filters">
      <input class="input" name="search" value={search} placeholder="email, имя или телефон" style="max-width:260px;" />
      <select class="input" name="course" style="width:auto;">
        <option value="">Курс: любой</option>
        {courses.map((c: any) => (
          <option value={c.slug} selected={course === c.slug}>{c.title}</option>
        ))}
      </select>
      <select class="input" name="verified" style="width:auto;">
        <option value="">Email: все</option>
        <option value="1" selected={verified === '1'}>подтверждён</option>
        <option value="0" selected={verified === '0'}>не подтверждён</option>
      </select>
      <select class="input" name="sort" style="width:auto;">
        <option value="">Сначала новые</option>
        <option value="last_seen" selected={sort === 'last_seen'}>По последнему визиту</option>
      </select>
      <button class="btn">Показать</button>
      {(search || course || verified || sort) && <a href="/admin/users" class="muted" style="align-self:center;">Сбросить</a>}
      <a class="btn secondary" href={`/api/admin/users/export.csv${qs.toString() ? '?' + qs.toString() : ''}`} title="Только пользователи с согласием на рассылку – для загрузки в сервис рассылок">CSV для рассылки ↓</a>
    </form>
    <p class="muted" style="margin-bottom:8px;">
      Найдено: {total}{pages > 1 ? ` · страница ${page} из ${pages}` : ''}
    </p>
    <table>
      <thead><tr><th>Email</th><th>Имя</th><th>Телефон</th><th>Роль</th><th>Подтв.</th><th>Last seen</th><th></th></tr></thead>
      <tbody>
        {(data || []).map((u: any) => (
          <tr data-uid={u.id} data-email={u.email}>
            <td><a href={`/admin/users/${u.id}`} style="font-weight:600;">{u.email}</a></td>
            <td>{u.name || '–'}</td>
            <td>{u.phone ? <a href={`tel:${u.phone}`}>{u.phone}</a> : '–'}</td>
            <td>{u.role}</td>
            <td>{u.email_verified ? '✅' : '–'}</td>
            <td>{u.last_seen_at?.toString?.().slice(0,16) || '–'}</td>
            <td>
              {u.role !== 'admin' && (
                <button class="btn-del" type="button" aria-label="Удалить пользователя">Удалить</button>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    {pages > 1 && (
      <p style="margin-top:16px; display:flex; gap:14px;">
        {page > 1 && <a href={pageUrl(page - 1)}>← Назад</a>}
        {page < pages && <a href={pageUrl(page + 1)}>Вперёд →</a>}
      </p>
    )}
  </section>
  <style is:global>
    .users-filters { display: flex; gap: 10px; margin: 20px 0; flex-wrap: wrap; align-items: center; }
    .users-filters .input { width: auto; }
    .btn-del { background: transparent; border: 1px solid #d0d0d0; color: #b34040; padding: 4px 10px; border-radius: 6px; cursor: pointer; font-size: 14px; font-family: inherit; transition: background 0.15s, color 0.15s; }
    .btn-del:hover { background: #b34040; color: white; border-color: #b34040; }
    .btn-del:disabled { opacity: 0.5; cursor: wait; }
  </style>
  <script>
    document.querySelectorAll('.btn-del').forEach(btn => {
      btn.addEventListener('click', async () => {
        const row = btn.closest('tr');
        const uid = row?.getAttribute('data-uid');
        const email = row?.getAttribute('data-email');
        if (!uid) return;
        if (!confirm(`Удалить пользователя ${email}?\nДействие необратимо. Если у него были оплаченные заказы – система откажет.`)) return;
        btn.disabled = true; const old = btn.textContent; btn.textContent = 'Удаляем…';
        try {
          const r = await fetch('/api/admin/users/' + uid, { method: 'DELETE', credentials: 'include' });
          const data = await r.json().catch(() => ({}));
          if (r.ok) {
            row?.remove();
          } else {
            const errMap = {
              has_paid_orders: 'У пользователя есть оплаченные заказы – удалять нельзя.',
              cannot_delete_admin: 'Админа удалить нельзя.',
              cannot_delete_self: 'Себя удалить нельзя.',
              not_found: 'Пользователь уже удалён.',
            };
            alert(errMap[data.error] || ('Ошибка: ' + (data.error || r.status)));
            btn.disabled = false; btn.textContent = old;
          }
        } catch {
          alert('Сеть отвалилась, попробуйте ещё раз');
          btn.disabled = false; btn.textContent = old;
        }
      });
    });
  </script>
  <style>
    .anketa-new { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 14px 18px; margin: 10px 0 24px; }
    .anketa-new summary { cursor: pointer; font-weight: 600; color: var(--navy); }
    .anketa-new form { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    .anketa-new input { flex: 1 1 200px; padding: 9px 12px; border: 1px solid var(--border); border-radius: 10px; font: inherit; }
    .anketa-new button { border: none; border-radius: 99px; padding: 9px 16px; font: inherit; font-weight: 600; cursor: pointer; background: var(--navy); color: #fff; }
    .anketa-new button[data-send="1"] { background: var(--orange); }
    #anketa-new-result a { word-break: break-all; }
  </style>
  <script>
    const af = document.getElementById('anketa-new-form') as HTMLFormElement | null;
    const ar = document.getElementById('anketa-new-result') as HTMLElement | null;
    af?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const send = ((e as SubmitEvent).submitter as HTMLElement | null)?.dataset.send === '1';
      const fd = new FormData(af);
      if (!ar) return;
      ar.textContent = 'Секунду…';
      try {
        const r = await fetch('/api/admin/anketa', { method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: fd.get('email'), name: fd.get('name'), send }) });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) { ar.textContent = d.error === 'bad_email' ? 'Проверьте email' : 'Не получилось: ' + (d.error || r.status); return; }
        ar.innerHTML = '';
        ar.append(send ? `Письмо ушло на ${d.email}. Ссылка: ` : 'Ссылка для клиента: ');
        const a = document.createElement('a'); a.href = d.url; a.textContent = d.url; a.target = '_blank'; ar.append(a);
        try { await navigator.clipboard.writeText(d.url); ar.append(' (скопирована)'); } catch {}
        const card = document.createElement('a'); card.href = '/admin/users/' + d.user_id; card.textContent = ' · карточка клиента →'; ar.append(card);
      } catch { ar.textContent = 'Нет сети'; }
    });
  </script>
</Base>
