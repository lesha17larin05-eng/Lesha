---
import Base from '../../layouts/Base.astro';
import { apiJson } from '../../lib/api';
const cookie = Astro.request.headers.get('cookie') || '';
const search = Astro.url.searchParams.get('search') || '';
const { data } = await apiJson<any[]>(`/api/admin/users?search=${encodeURIComponent(search)}`, { cookie });
const user = (Astro.locals as any).user;
---
<Base title="Пользователи" user={user}>
  <section class="container" style="padding:50px 0;">
    <h1>Пользователи</h1>
    <form method="get" style="display:flex; gap:10px; margin:20px 0;">
      <input class="input" name="search" value={search} placeholder="email или имя" />
      <button class="btn">Найти</button>
    </form>
    <table>
      <thead><tr><th>Email</th><th>Имя</th><th>Роль</th><th>Подтв.</th><th>Last seen</th></tr></thead>
      <tbody>
        {(data || []).map((u: any) => (
          <tr>
            <td>{u.email}</td><td>{u.name}</td><td>{u.role}</td>
            <td>{u.email_verified ? '✅' : '—'}</td>
            <td>{u.last_seen_at?.toString?.().slice(0,16) || '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Base>
