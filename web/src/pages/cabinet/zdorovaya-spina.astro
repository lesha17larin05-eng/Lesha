  <script>
    // Большая play-кнопка поверх плеера + Space переключает текущее видео,
    // в том числе когда оно открыто во весь экран.
    let activeVideo = null;
    document.querySelectorAll('[data-video-wrap]').forEach((wrap) => {
      const video = wrap.querySelector('video');
      const btn = wrap.querySelector('.zs-cab-bigplay');
      if (!video || !btn) return;
      btn.addEventListener('click', () => { activeVideo = video; video.focus(); video.play(); });
      video.addEventListener('play',  () => { activeVideo = video; wrap.classList.add('is-playing'); });
      video.addEventListener('pause', () => wrap.classList.remove('is-playing'));
      video.addEventListener('ended', () => wrap.classList.remove('is-playing'));
      video.addEventListener('click',          () => activeVideo = video);
      video.addEventListener('focus',          () => activeVideo = video, true);
      video.addEventListener('webkitbeginfullscreen', () => activeVideo = video);
      video.addEventListener('webkitendfullscreen',   () => activeVideo = null);
    });
    document.addEventListener('fullscreenchange', () => {
      const fs = document.fullscreenElement;
      if (fs && fs.tagName === 'VIDEO') { activeVideo = fs; fs.focus(); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.code !== 'Space' && e.key !== ' ') return;
      const t = e.target;
      if (['INPUT','TEXTAREA','SELECT','BUTTON'].includes(t.tagName)) return;
      if (t.isContentEditable) return;
      if (t.tagName === 'VIDEO') return;
      if (!activeVideo) return;
      e.preventDefault();
      e.stopPropagation();
      if (activeVideo.paused) activeVideo.play();
      else activeVideo.pause();
    }, true);

    // Подсветка урока при скроллe по #slug-якорю
    if (window.location.hash) {
      const el = document.querySelector(window.location.hash);
      if (el) {
        setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
      }
    }
  </script>
