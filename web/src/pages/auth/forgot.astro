---
import Base from '../../layouts/Base.astro';
// ?email=… – подставляется со страницы входа после неудачной попытки.
const prefill = (Astro.url.searchParams.get('email') || '').slice(0, 200);
---
<Base title="Ссылка для входа">
  <section class="container auth-page" style="padding:60px 16px; max-width:480px;">
    <h1>Ссылка для входа</h1>
    <p class="muted">Пришлём на почту ссылку: по ней вы зададите пароль и сразу войдёте. Подходит, если вы забыли пароль или купили курс и ещё его не задавали.</p>
    <form id="f" class="form">
      <div><label class="label">Email</label><input class="input" name="email" type="email" required value={prefill} /></div>
      <button class="btn" type="submit">Отправить ссылку</button>
      <div id="msg" hidden></div>
    </form>
  </section>
  <script>
    const f = document.getElementById('f'), m = document.getElementById('msg');
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(f);
      const r = await fetch('/api/auth/forgot-password', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: fd.get('email') })
      });
      const j = await r.json();
      m.className = 'alert ok';
      // В dev показываем reset-ссылку, чтобы не настраивать SMTP локально. В проде – никогда.
      if (import.meta.env.DEV && j.reset_link_dev) {
        m.innerHTML = 'Если email существует – письмо отправлено.' +
          ' <br/><small>Dev: <a href="'+j.reset_link_dev+'">'+j.reset_link_dev+'</a></small>';
      } else {
        m.textContent = 'Если такая почта есть на сайте, мы отправили на неё ссылку для входа. Письмо приходит за минуту – если его нет, загляните в «Спам» и «Рассылки».';
      }
      m.hidden = false;
    });
  </script>
</Base>
