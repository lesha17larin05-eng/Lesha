---
import Base from '../../layouts/Base.astro';
---
<Base title="Восстановление пароля">
  <section class="container" style="padding:60px 0; max-width:480px;">
    <h1>Восстановление пароля</h1>
    <form id="f" class="form">
      <div><label class="label">Email</label><input class="input" name="email" type="email" required /></div>
      <button class="btn" type="submit">Отправить ссылку</button>
      <div id="msg" hidden></div>
    </form>
  </section>
  <script>
    const f = document.getElementById('f'), m = document.getElementById('msg');
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(f);
      const r = await fetch('/api/auth/forgot-password', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: fd.get('email') })
      });
      const j = await r.json();
      m.className = 'alert ok';
      // В dev показываем reset-ссылку, чтобы не настраивать SMTP локально. В проде — никогда.
      if (import.meta.env.DEV && j.reset_link_dev) {
        m.innerHTML = 'Если email существует — письмо отправлено.' +
          ' <br/><small>Dev: <a href="'+j.reset_link_dev+'">'+j.reset_link_dev+'</a></small>';
      } else {
        m.textContent = 'Если такой email зарегистрирован, мы отправили на него ссылку для сброса пароля. Проверьте почту (в т.ч. папку «Спам»).';
      }
      m.hidden = false;
    });
  </script>
</Base>
