---
import SiteLayout from '../../layouts/SiteLayout.astro';
const email = Astro.url.searchParams.get('email') || '';
const styles = `
.check-email-wrap { max-width: 560px; margin: 0 auto; padding: 80px 24px 100px; text-align: center; }
.check-email-icon { font-size: 56px; line-height: 1; margin-bottom: 20px; }
.check-email h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(28px, 4vw, 40px); font-weight: 500; color: var(--navy); margin-bottom: 16px; line-height: 1.2; }
.check-email-lead { font-size: 17px; color: var(--text-mid); line-height: 1.6; margin-bottom: 28px; }
.check-email-lead b { color: var(--navy); }
.check-email-tip { background: rgba(244,195,97,0.16); border: 1px solid rgba(244,195,97,0.4); border-radius: 14px; padding: 18px 22px; margin-bottom: 28px; text-align: left; font-size: 15px; color: var(--text-mid); line-height: 1.6; }
.check-email-tip b { color: var(--navy); }
.check-email-actions { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-top: 24px; }
.check-email-actions a { font-size: 15px; color: var(--orange); text-decoration: none; border-bottom: 1px dashed rgba(232,101,42,0.4); }
.check-email-actions a:hover { color: var(--orange-warm); }
`;
---
<SiteLayout title="Проверьте почту — Алексей Ларин" padTop={true} pageStyles={styles}>
  <section class="check-email-wrap check-email">
    <div class="check-email-icon">📬</div>
    <h1>Проверьте почту</h1>
    <p class="check-email-lead">
      Отправили ссылку на <b>{email || 'вашу почту'}</b>.<br>
      Откройте письмо и нажмите кнопку — попадёте в курс.
    </p>
    <div class="check-email-tip">
      <b>Не пришло?</b> Загляните в папку <b>«Спам»</b>. Если нашли — отметьте «Не спам», тогда следующие письма попадут во «Входящие».
    </div>
    <div class="check-email-actions">
      {email && <button type="button" id="resend-btn" class="resend-btn">Письмо не пришло — отправить ещё раз</button>}
      <p id="resend-note" class="resend-note" hidden></p>
      <a href="/auth/login">Уже подтвердили — войти</a>
      <a href="/course">На страницу курса</a>
    </div>
  </section>
  <style is:global>
    .resend-btn {
      background: var(--orange); color: white; border: none; cursor: pointer;
      padding: 13px 26px; border-radius: 100px; font-size: 15px; font-weight: 600;
      font-family: 'Manrope', sans-serif; transition: background 0.2s;
    }
    .resend-btn:hover { background: var(--orange-warm); }
    .resend-btn:disabled { opacity: 0.6; cursor: wait; }
    .resend-note { font-size: 14px; color: var(--text-muted); margin: 0; }
  </style>
  <script define:vars={{ email }}>
    const btn = document.getElementById('resend-btn');
    const note = document.getElementById('resend-note');
    btn?.addEventListener('click', async () => {
      btn.disabled = true; btn.textContent = 'Отправляем…';
      try {
        const r = await fetch('/api/auth/resend-verification', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ email }),
        });
        if (r.ok) {
          note.textContent = 'Отправили ещё раз — проверьте почту и папку «Спам».';
          note.hidden = false;
          btn.remove();
          return;
        }
        note.textContent = 'Не получилось — подождите пару минут и попробуйте снова.';
        note.hidden = false;
      } catch {
        note.textContent = 'Ошибка сети — попробуйте ещё раз.';
        note.hidden = false;
      } finally {
        if (btn.isConnected) { btn.disabled = false; btn.textContent = 'Письмо не пришло — отправить ещё раз'; }
      }
    });
  </script>
</SiteLayout>
