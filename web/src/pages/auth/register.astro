---
import Base from '../../layouts/Base.astro';
const next = Astro.url.searchParams.get('next') || '';
const loginHref = next ? '/auth/login?next=' + encodeURIComponent(next) : '/auth/login';
---
<Base title="Регистрация">
  <section class="container auth-page" style="padding:60px 16px; max-width:480px;">
    <h1>Регистрация</h1>
    <p class="auth-switch">
      Уже есть аккаунт? <a href={loginHref}>Войти</a>
    </p>
    <form id="f" class="form">
      <div><label class="label">Имя <i class="req">*</i></label><input class="input" name="name" required /></div>
      <div><label class="label">Email <i class="req">*</i></label><input class="input" name="email" type="email" required /></div>
      <div><label class="label">Телефон</label><input class="input" name="phone" type="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" /></div>
      <div><label class="label">Пароль <em class="opt">минимум 8 символов</em> <i class="req">*</i></label><input class="input" name="password" type="password" required minlength="8" /></div>

      <label class="consent">
        <input type="checkbox" name="consent_pd" required checked />
        <span>Я ознакомлен(а) с <a href="/legal/privacy" target="_blank">Политикой конфиденциальности</a> и даю <a href="/legal/consent" target="_blank">согласие на обработку персональных данных</a>.</span>
      </label>
      <label class="consent">
        <input type="checkbox" name="consent_marketing" checked />
        <span>Получать материалы и анонсы Алексея на почту. Без спама, отписаться можно одним кликом из любого письма.</span>
      </label>

      <button class="btn" type="submit" style="margin-top:14px;">Создать аккаунт</button>
      <div id="msg" hidden></div>
    </form>
  </section>
  <style>
    .auth-page { width: 100%; box-sizing: border-box; }
    .auth-switch {
      margin: -8px 0 22px;
      font-size: 14px;
      color: var(--text-mid);
    }
    .auth-switch a {
      color: var(--orange);
      text-decoration: none;
      font-weight: 600;
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s, color 0.2s;
    }
    @media (hover: hover) {
      .auth-switch a:hover { border-bottom-color: var(--orange); }
    }
    .auth-switch a:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; border-radius: 2px; }
    .consent { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.5; color: var(--text-mid); cursor: pointer; }
    .consent input { margin-top: 3px; flex-shrink: 0; accent-color: var(--orange); width: 16px; height: 16px; cursor: pointer; }
    .consent a { color: var(--orange); text-decoration: underline; }
    .req { display: inline-block; margin-left: 2px; font-size: 14px; font-weight: 700; font-style: normal; color: var(--orange); }
    .opt { display: inline-block; margin-left: 6px; font-size: 12px; font-style: normal; color: var(--text-muted); font-weight: 400; }
    @media (max-width: 480px) {
      .auth-page { padding: 40px 16px !important; }
      .form { max-width: 100%; }
      .input { font-size: 16px; /* iOS не зумит при 16px+ */ }
    }
  </style>
  <script>
    const form = document.getElementById('f');
    const msg = document.getElementById('msg');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      // Дополнительная проверка обязательного согласия — на случай, если кто-то обошёл нативную валидацию.
      if (!String(fd.get('name') || '').trim()) {
        msg.className = 'alert';
        msg.textContent = 'Укажите имя — обращаемся к вам в кабинете и в письмах.';
        msg.hidden = false;
        return;
      }
      if (!fd.get('consent_pd')) {
        msg.className = 'alert';
        msg.textContent = 'Чтобы продолжить, нужно согласиться с обработкой персональных данных.';
        msg.hidden = false;
        return;
      }
      const r = await fetch('/api/auth/register', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          email: fd.get('email'),
          password: fd.get('password'),
          name: fd.get('name'),
          phone: fd.get('phone'),
          consent_pd: true,
          consent_marketing: !!fd.get('consent_marketing'),
        }),
      });
      const j = await r.json();
      if (r.ok) {
        msg.className = 'alert ok';
        // В dev-режиме показываем ссылку для подтверждения, чтобы не настраивать SMTP локально.
        // В проде показываем только сообщение об отправке письма (verify_link_dev не использовать!).
        if (import.meta.env.DEV && j.verify_link_dev) {
          msg.innerHTML = 'Аккаунт создан. Подтвердите email — письмо отправлено.' +
            ' <br/><small>Dev-ссылка: <a href="' + j.verify_link_dev + '">' + j.verify_link_dev + '</a></small>';
        } else {
          msg.textContent = 'Аккаунт создан. Мы отправили письмо на ' + (fd.get('email') || '') +
            ' — перейдите по ссылке в письме, чтобы подтвердить email.';
        }
      } else {
        msg.className = 'alert';
        msg.textContent = j.error || 'Ошибка';
      }
      msg.hidden = false;
    });
  </script>
</Base>
