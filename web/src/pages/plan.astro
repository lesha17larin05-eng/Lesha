---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/landing.css';
// «Тренировки со мной» (/plan; до 10.11.2026 – /napisat). Сюда ведёт первая
// ссылка в описании YouTube-видео («Тренировки со мной») и ссылки в шапках
// профилей. Одно главное действие: Telegram или Max с готовым сообщением
// (в нём слово «План» – Алексей отвечает по документу проекта «Переписка –
// скрипт первого разговора»). Группа и вопрос – мелко внизу.
const TG_BASE = 'https://t.me/larin_lesha?text=';
const MAX_BASE = 'https://max.ru/u/f9LHodD0cOJK26BnKhvEBfpuj05eZ2Tn1oTqJ7kv0OoP_WfKwTiqDPGe-Nc?text=';
const link = (msg: string) => ({ tg: TG_BASE + encodeURIComponent(msg), max: MAX_BASE + encodeURIComponent(msg) });

const MAIN_MSG = 'Здравствуйте, Алексей! План. Хочу тренироваться с вами – подскажите, с чего начать';
const main = link(MAIN_MSG);
// Когда откроется набор в группу – поменять подпись.
const GROUP_NOTE = 'следующий поток – в январе, запишу в лист ожидания';
const group = link('Здравствуйте, Алексей! Хочу в следующий поток группового ведения – запишите меня в лист ожидания');
const ask = link('Здравствуйте, Алексей! У меня вопрос: ');
---
<SiteLayout
  title="Тренировки со мной – Алексей Ларин"
  description="Напишите тренеру Алексею Ларину в Telegram или Max: подберу план под ваш уровень и буду рядом на каждом шаге."
  padTop={true}>

  <section class="nw-top" id="plan">
    <div class="nw-inner">
      <p class="gp-eyebrow"><span class="dot"></span>Алексей Ларин</p>
      <h1>Тренировки <em>со&nbsp;мной</em></h1>
      <p class="nw-sub">Напишите мне – подберу план под ваш уровень и буду рядом на каждом шаге. Сообщение уже готово: откроется Telegram или Max, останется его отправить.</p>
      <div class="nw-main">
        <a href={main.tg} class="btn-main btn-full nw-btn" target="_blank" rel="noopener" data-goal="messenger_click">Написать в Telegram</a>
        <a href={main.max} class="nw-max" target="_blank" rel="noopener" data-goal="messenger_click">или в Max</a>
        <p class="nw-msg"><span>Сообщение</span>{MAIN_MSG}</p>
        <p class="nw-note">Обычно отвечаю в течение дня</p>
      </div>
    </div>
  </section>

  <section class="nw-other">
    <div class="nw-other-inner">
      <p id="gruppa"><b>Хочу в группу</b> – {GROUP_NOTE}: <a href={group.tg} target="_blank" rel="noopener" data-goal="messenger_click">Telegram</a> · <a href={group.max} target="_blank" rel="noopener" data-goal="messenger_click">Max</a> · <a href="/gruppa">о&nbsp;группе</a></p>
      <p id="vopros"><b>Есть вопрос</b> – отвечу лично: <a href={ask.tg} target="_blank" rel="noopener" data-goal="messenger_click">Telegram</a> · <a href={ask.max} target="_blank" rel="noopener" data-goal="messenger_click">Max</a></p>
    </div>
  </section>

  <script>
    // Нажатия на «Написать в Telegram / Max» – цель Метрики messenger_click.
    document.querySelectorAll<HTMLElement>('[data-goal]').forEach((a) =>
      a.addEventListener('click', () => (window as any).reachGoal?.(a.dataset.goal)));
  </script>

  <style>
    .nw-top { background: var(--navy); color: white; padding: 80px 24px 72px; }
    .nw-inner { max-width: 640px; margin: 0 auto; text-align: center; }
    .nw-top .gp-eyebrow { justify-content: center; }
    .nw-top h1 { font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: clamp(44px, 5vw, 66px); line-height: 1.06; margin: 0 0 16px; color: white; }
    .nw-top h1 em { font-style: italic; color: #8bb8f0; }
    .nw-sub { font-size: 19px; line-height: 1.6; color: rgba(255,255,255,.88); margin: 0 auto 30px; max-width: 560px; }
    .nw-main { max-width: 440px; margin: 0 auto; }
    .nw-btn { font-size: 19px; padding: 19px 28px; }
    .nw-max { display: inline-block; margin: 14px 0 0; font-size: 17px; color: white; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(255,255,255,.4); transition: text-decoration-color .2s ease, color .2s ease; }
    .nw-max:hover, .nw-max:focus-visible { text-decoration-color: currentColor; color: #f3a37c; }
    .nw-msg { font-size: 16px; line-height: 1.55; color: rgba(255,255,255,.85); background: rgba(255,255,255,.07); border-radius: 12px; padding: 12px 16px; margin: 24px 0 0; text-align: left; }
    .nw-msg span { display: block; font-size: 15px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #f3a37c; margin-bottom: 4px; }
    .nw-note { font-size: 15px; color: rgba(255,255,255,.65); margin: 14px 0 0; }

    .nw-other { background: var(--cream, #f8f5ef); padding: 36px 24px 72px; }
    .nw-other-inner { max-width: 640px; margin: 0 auto; text-align: center; }
    .nw-other p { font-size: 16px; line-height: 1.6; color: var(--text-muted, #555); margin: 0 0 10px; scroll-margin-top: 90px; }
    .nw-other b { color: var(--navy); font-weight: 600; }
    .nw-other a { color: var(--navy); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(26,39,68,.3); transition: color .2s ease, text-decoration-color .2s ease; }
    .nw-other a:hover, .nw-other a:focus-visible { color: var(--orange); text-decoration-color: currentColor; }

    @media (max-width: 700px) {
      .nw-top { padding: 44px 20px 52px; }
      .nw-sub { font-size: 17px; }
      .nw-other { padding: 28px 20px 56px; }
    }
  </style>
</SiteLayout>
