  <script>
    // Заявка → POST /api/leads (CSRF подставляет обёртка fetch из SiteLayout).
    const lead = document.getElementById('lead-form') as HTMLFormElement | null;
    lead?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const note = document.getElementById('lead-note') as HTMLElement;
      const btn = lead.querySelector('button[type="submit"]') as HTMLButtonElement;
      const say = (m: string, err = false) => { note.textContent = m; note.classList.toggle('is-error', err); };
      const fd = new FormData(lead);
      const name = String(fd.get('name') || '').trim();
      const contact = String(fd.get('contact') || '').trim();
      if (!name) return say('Укажите имя', true);
      if (contact.length < 5) return say('Укажите телефон или почту – как с вами связаться', true);
      if (!fd.get('consent_pd')) return say('Чтобы продолжить, отметьте согласие', true);
      btn.disabled = true; const orig = btn.textContent; btn.textContent = 'Отправляем…';
      try {
        const r = await fetch('/api/leads', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
          body: JSON.stringify({ name, contact, message: String(fd.get('message') || '').trim(), source: 'personal', consent_pd: true }),
        });
        if (r.ok) {
          (window as any).reachGoal?.('lead_submit');
          const box = document.createElement('div');
          box.className = 'gp-success';
          box.innerHTML = '<h3>Получил 🙌</h3><p>Напишу вам в течение дня – договоримся о времени первого занятия.</p>';
          lead.replaceWith(box);
          return;
        }
        say('Не получилось отправить – попробуйте ещё раз или напишите в Telegram', true);
      } catch { say('Ошибка сети – попробуйте ещё раз', true); }
      finally { btn.disabled = false; btn.textContent = orig; }
    });

  </script>
</SiteLayout>
