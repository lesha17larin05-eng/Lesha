APP_ENV=development
APP_HOST=http://localhost
SESSION_SECRET=dev-session-secret-change-me-32-bytes-xx
JWT_SECRET=dev-jwt-secret-change-me-32-bytes-xxxxxxx

DATA_DIR=./data

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgres://app:app@postgres:5432/app?sslmode=disable

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Алексей Ларин <noreply@leshalarin.ru>
# Куда уходят ответы на письма (пусто – SMTP_USER)
SMTP_REPLY_TO=
# Запасной ящик (другой почтовый сервис): письма уходят через него, если основной недоступен.
SMTP2_HOST=
SMTP2_PORT=465
SMTP2_USER=
SMTP2_PASSWORD=
SMTP2_FROM=
# Уведомления в Telegram через прокладку Google Apps Script (docs/07-deploy-ops.md).
TELEGRAM_RELAY_URL=
TELEGRAM_RELAY_SECRET=

PRODAMUS_PAYFORM_URL=https://larin.payform.ru
# Секретный ключ берётся из ⚙ Настройки → Секретный ключ в кабинете Продамус.
# В git НЕ коммитить — настоящее значение пишем в локальный .env.
PRODAMUS_SECRET_KEY=test-prodamus-secret
# true — checkout возвращает фейковый URL, без вызова Продамус (для разработки и интеграционных тестов).
# false — реальная подпись и редирект на larin.payform.ru.
PRODAMUS_TEST_MODE=true

VIDEO_TOKEN_SECRET=dev-video-secret-change-me-32-bytes-xx
VIDEO_TOKEN_TTL=2h
VIDEO_STORAGE_PATH=/var/videos

LEAD_NOTIFY_EMAIL=les-larin@yandex.ru   # куда слать письма о новых заявках с сайта
ADMIN_EMAIL=admin@leshalarin.ru
ADMIN_PASSWORD=admin12345
USER_EMAIL=user@leshalarin.ru
USER_PASSWORD=user12345

CORS_ORIGIN=http://localhost

# Яндекс.Метрика: номер счётчика (только цифры). Пусто — аналитика выключена.
METRIKA_ID=
